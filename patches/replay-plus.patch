+        style.hint = "Handheld, walking, running, vehicle, earthquake or a slow drift";
+        style.segments = static_cast<int>(replay_shake::Preset::count);
+        style.segment = static_cast<int>(p.shake.preset);
+        style.locked = !p.shake_on;
