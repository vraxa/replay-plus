+        if (f.kind == Kind::number && f.logarithmic && f.low > 0) r.fraction = std::log(std::max(v, f.low) / f.low) / std::log(f.high / f.low);
+        else if (f.kind == Kind::number) r.fraction = f.high > f.low ? (v - f.low) / (f.high - f.low) : 0;
