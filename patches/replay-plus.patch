+// The game's depth for the camera light. ReSkate hooks ID3D12GraphicsCommandList::ResourceBarrier once
+// (Extension/UI/Overlay/depth_tap.cpp, its depth tap for screen captures) and hands Replay Plus every
+// barrier the game records, before passing it on. While the light is on, the game's main depth (the
+// first depth target each frame that goes from being written to being read, a picture's shape: as the
+// tap takes it) is copied into a texture of Replay Plus's own, on the game's own command list, where
+// the depth is finished. The picture's pass then reads that copy, later on the same queue.
+namespace dingosdk::replay_plus::depth {
+namespace {
+using Microsoft::WRL::ComPtr;
+struct Retired {
+    ComPtr<ID3D12Resource> texture;
+    std::uint64_t epoch{};
+};
+struct Shared {
+    std::mutex mutex;
+    bool wanted{};
+    std::uint64_t epoch{1}, copied_epoch{};
+    std::uint32_t screen_width{}, screen_height{};
+    ComPtr<ID3D12Resource> texture;   // R32_TYPELESS, in PIXEL_SHADER_RESOURCE between copies
+    std::uint32_t width{}, height{};
+    DXGI_FORMAT source_format{DXGI_FORMAT_UNKNOWN};
+    std::uint64_t serial{};           // changes when the texture is made anew
+    std::vector<Retired> retired;
+    std::uint64_t copies{};
+    bool said{};
+    // The game has a half-size depth of the same view too (1280x720 beside 2560x1440, recorded first on
+    // some frames): the largest one seen lately is the main view's, and only it is taken.
+    std::uint64_t largest{}, largest_epoch{};
+    // Exports (for_export in replay_plus_depth.h): the depth of the frame each video frame was drawn in,
+    // copied from the depth copy as the game's video frame goes to be copied out, in a ring, oldest
+    // first; let go a few seconds after the last export frame.
+    struct Kept {
+        ComPtr<ID3D12Resource> texture;
+        std::uint32_t width{}, height{};
+        std::uint64_t epoch{};
+        bool own_frame{}; // the game's depth went by earlier in the same frame
+        // A few rows of the video frame drawn in that frame, read back: which frame the encoder is given.
+        ComPtr<ID3D12Resource> print;
+        const std::uint8_t* print_cpu{};
+        std::uint32_t print_width{}, print_height{};
+    };
+    // Six: the game reads its video frames back four frames on, and draws one or two at an export's start that
+    // it never encodes (2026-11-17); a frame's own may be kept before or after the encoder takes one. Those
+    // never encoded are the ones let go when it is full.
+    std::array<Kept, 6> kept{};
+    std::uint64_t kept_pushed{}, kept_popped{}, kept_epoch{}, kept_taken{}, kept_dropped{}, kept_skipped{}, kept_unfound{}, kept_exact{};
+    bool kept_fallback_said{}, kept_late_said{}, kept_drop_said{}, kept_unfound_said{};
+    int kept_inexact_said{};
+    // Which of the game's depths the light's copy comes from (logged when it changes, a few times).
+    ID3D12Resource* depth_source{};
+    std::uint64_t depth_source_copies{};
+    int depth_source_changes{};
+    ID3D12GraphicsCommandList* own_list{}; // Replay Plus's list for exported frames (ignore_list)
+    // The game's picture before its UI (Scene in replay_plus_depth.h).
+    bool scene_wanted{}, ui_wanted{};
+    std::array<ID3D12Resource*, 4> swap{};      // the swap chain's buffers, as presented
+    std::size_t swap_next{};
+    ID3D12GraphicsCommandList* composite_list{}; // the list the game's last pass is in, and when
+    std::uint64_t composite_epoch{};
+    std::uint64_t scene_epoch{}, ui_epoch{};    // when the picture and the UI were last taken
+    ComPtr<ID3D12Resource> scene_in, scene_out;
+    std::uint32_t scene_width{}, scene_height{};
+    DXGI_FORMAT scene_format{DXGI_FORMAT_UNKNOWN};
+    std::uint64_t scene_serial{};
+    bool scene_ready{};                         // scene_out holds a picture for the next frame
+    bool scene_said{};
+    // The UI's alpha along the button prompts: three strips, into four readback slots in turn.
+    ComPtr<ID3D12Resource> ui_readback;
+    std::array<std::uint64_t, 4> ui_written{};  // the epoch each slot was written in (0: none)
+    std::uint64_t ui_frame{};
+    std::uint32_t ui_width{}, ui_pitch{};
+    DXGI_FORMAT ui_format{DXGI_FORMAT_UNKNOWN};
+    float ui_shown{-1};
+    float gap_from{}, gap_to{};
+    std::uint32_t ui_height{};
+    bool bar_found{};
+    float bar_y{};
+};
+Shared& shared() {
+    static auto* value = new Shared;
+    return *value;
+}
+// Research (`replayplus trace`): every transition of a texture at least 640 by 360, with its list and
+// thread, while frames are left to trace; the back buffer named as such.
+std::atomic<ID3D12Resource*> traced_back_buffer{};
+std::atomic<std::uint64_t> trace_line{0};
+void trace(ID3D12GraphicsCommandList* list, UINT count, const D3D12_RESOURCE_BARRIER* barriers) {
+    for (UINT i = 0; i < count; ++i) {
+        const auto& b = barriers[i];
+        if (b.Type != D3D12_RESOURCE_BARRIER_TYPE_TRANSITION || !b.Transition.pResource) continue;
+        const auto d = b.Transition.pResource->GetDesc();
+        if (d.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D || d.Width < 640 || d.Height < 360) continue;
+        wchar_t name[64]{};
+        UINT size = sizeof(name) - sizeof(wchar_t);
+        std::string named;
+        // WKPDID_D3DDebugObjectNameW (d3dcommon.h), here so dxguid.lib is not needed.
+        constexpr GUID debug_name = {0x4cca5fd8, 0x921f, 0x42c8, {0x85, 0x78, 0xeb, 0x99, 0x49, 0xae, 0x11, 0x77}};
+        if (SUCCEEDED(b.Transition.pResource->GetPrivateData(debug_name, &size, name)))
+            for (const wchar_t* c = name; *c && named.size() < 60; ++c) named += *c < 128 ? static_cast<char>(*c) : '?';
+        logging::write(logging::Level::info, logging::Channel::graphics,
+            std::format("Replay Plus trace {}: thread {} list {:x} res {:x}{} {}x{} fmt {} mips {} array {} flags {:x} sub {:x}: {:x} -> {:x}{}{}",
+                trace_line.fetch_add(1), GetCurrentThreadId(), reinterpret_cast<std::uintptr_t>(list),
+                reinterpret_cast<std::uintptr_t>(b.Transition.pResource),
+                b.Transition.pResource == traced_back_buffer.load() ? " (BACK BUFFER)" : "", d.Width, d.Height, static_cast<int>(d.Format),
+                d.MipLevels, d.DepthOrArraySize, static_cast<unsigned>(d.Flags), b.Transition.Subresource,
+                static_cast<unsigned>(b.Transition.StateBefore), static_cast<unsigned>(b.Transition.StateAfter),
+                b.Flags ? std::format(" split {:x}", static_cast<unsigned>(b.Flags)) : std::string(), named.empty() ? "" : " \"" + named + "\""));
+    }
+}
+bool depth_capable(const D3D12_RESOURCE_DESC& d) {
+    return d.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D && (d.Flags & D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL) && d.SampleDesc.Count == 1 &&
+           d.DepthOrArraySize == 1;
+}
+// The picture's shape (within a pixel of the screen's aspect), at least half its size: the main view's
+// depth, at whatever resolution the game renders it (Render.ResolutionScale), not a shadow map's.
+bool picture_shaped(const Shared& s, std::uint64_t width, std::uint32_t height) {
+    if (!s.screen_width || !s.screen_height || !height) return false;
+    const double screen = static_cast<double>(s.screen_width) / s.screen_height, aspect = static_cast<double>(width) / height;
+    return std::abs(screen - aspect) < 0.02 && width * 2 >= s.screen_width && width <= std::uint64_t{s.screen_width} * 4;
+}
+void transition(ID3D12GraphicsCommandList* list, BarrierFn original, ID3D12Resource* resource, UINT subresource, D3D12_RESOURCE_STATES from,
+                D3D12_RESOURCE_STATES to) {
+    D3D12_RESOURCE_BARRIER b{};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = resource;
+    b.Transition.Subresource = subresource;
+    b.Transition.StateBefore = from;
+    b.Transition.StateAfter = to;
+    original(list, 1, &b);
+}
+void copy_from(Shared& s, ID3D12GraphicsCommandList* list, const D3D12_RESOURCE_BARRIER& b, BarrierFn original) {
+    auto* source = b.Transition.pResource;
+    const auto desc = source->GetDesc();
+    if (!s.texture || s.width != desc.Width || s.height != desc.Height) {
+        ComPtr<ID3D12Device> device;
+        if (FAILED(source->GetDevice(IID_PPV_ARGS(&device)))) return;
+        if (s.texture) s.retired.push_back({std::move(s.texture), s.epoch});
+        D3D12_RESOURCE_DESC t{};
+        t.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        t.Width = desc.Width;
+        t.Height = desc.Height;
+        t.DepthOrArraySize = 1;
+        t.MipLevels = 1;
+        t.Format = DXGI_FORMAT_R32_TYPELESS;
+        t.SampleDesc.Count = 1;
+        D3D12_HEAP_PROPERTIES heap{};
+        heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+        if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &t, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, nullptr,
+                                                   IID_PPV_ARGS(&s.texture)))) {
+            s.texture.Reset();
+            return;
+        }
+        s.texture->SetName(L"Replay Plus depth copy");
+        s.width = static_cast<std::uint32_t>(desc.Width);
+        s.height = desc.Height;
+        s.source_format = desc.Format;
+        ++s.serial;
+        logging::write(logging::Level::info, logging::Channel::graphics,
+                       std::format("Replay Plus: the camera light reads the game's depth ({}x{}, format {}).", desc.Width, desc.Height,
+                                   static_cast<int>(desc.Format)));
+    }
+    // The game's depth to a copy source and back to where it was (its own barrier, passed on after
+    // this, then takes it on as it meant to); the copy to a copy target and back to a shader's.
+    transition(list, original, source, b.Transition.Subresource, b.Transition.StateBefore, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    transition(list, original, s.texture.Get(), 0, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COPY_DEST);
+    D3D12_TEXTURE_COPY_LOCATION to{}, from{};
+    to.pResource = s.texture.Get();
+    to.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    to.SubresourceIndex = 0;
+    from.pResource = source;
+    from.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    from.SubresourceIndex = 0;
+    list->CopyTextureRegion(&to, 0, 0, 0, &from, nullptr);
+    transition(list, original, s.texture.Get(), 0, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    transition(list, original, source, b.Transition.Subresource, D3D12_RESOURCE_STATE_COPY_SOURCE, b.Transition.StateBefore);
+    s.copied_epoch = s.epoch;
+    ++s.copies;
+    if (source != s.depth_source) {
+        if (s.depth_source_changes < 12)
+            logging::write(logging::Level::info, logging::Channel::graphics,
+                           std::format("Replay Plus: the light's depth now comes from {:x} ({}x{}, format {}; {} copies from the one before).",
+                                       reinterpret_cast<std::uintptr_t>(source), desc.Width, desc.Height, static_cast<int>(desc.Format),
+                                       s.depth_source_copies));
+        ++s.depth_source_changes;
+        s.depth_source = source;
+        s.depth_source_copies = 0;
+    }
+    ++s.depth_source_copies;
+}
+
+// ---- The game's picture before its UI, and the UI's alpha ----------------------------------------
+constexpr D3D12_RESOURCE_STATES shader_read = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+bool swap_buffer(const Shared& s, const ID3D12Resource* resource) {
+    for (const auto* buffer : s.swap)
+        if (buffer && buffer == resource) return true;
+    return false;
+}
+// The picture: R11G11B10 on this build (its last post pass); the UI: 8-bit with alpha (sRGB on this build).
+bool picture_format(DXGI_FORMAT f) {
+    return f == DXGI_FORMAT_R11G11B10_FLOAT || f == DXGI_FORMAT_R16G16B16A16_FLOAT || f == DXGI_FORMAT_R10G10B10A2_UNORM;
+}
+bool ui_format(DXGI_FORMAT f) {
+    return f == DXGI_FORMAT_R8G8B8A8_UNORM_SRGB || f == DXGI_FORMAT_B8G8R8A8_UNORM_SRGB || f == DXGI_FORMAT_R8G8B8A8_UNORM ||
+           f == DXGI_FORMAT_B8G8R8A8_UNORM;
+}
+// Its copy and Replay Plus's own, the picture's size and format (made anew when it changes).
+bool make_scene(Shared& s, ID3D12Resource* picture, const D3D12_RESOURCE_DESC& d) {
+    if (s.scene_in && s.scene_out && s.scene_width == d.Width && s.scene_height == d.Height && s.scene_format == d.Format) return true;
+    ComPtr<ID3D12Device> device;
+    if (FAILED(picture->GetDevice(IID_PPV_ARGS(&device)))) return false;
+    if (s.scene_in) s.retired.push_back({std::move(s.scene_in), s.epoch});
+    if (s.scene_out) s.retired.push_back({std::move(s.scene_out), s.epoch});
+    s.scene_ready = false;
+    D3D12_RESOURCE_DESC t{};
+    t.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    t.Width = d.Width;
+    t.Height = d.Height;
+    t.DepthOrArraySize = 1;
+    t.MipLevels = 1;
+    t.Format = d.Format;
+    t.SampleDesc.Count = 1;
+    D3D12_HEAP_PROPERTIES heap{};
+    heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+    if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &t, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, nullptr,
+                                               IID_PPV_ARGS(&s.scene_in)))) {
+        s.scene_in.Reset();
+        return false;
+    }
+    t.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &t, D3D12_RESOURCE_STATE_COPY_SOURCE, nullptr,
+                                               IID_PPV_ARGS(&s.scene_out)))) {
+        s.scene_in.Reset();
+        s.scene_out.Reset();
+        return false;
+    }
+    s.scene_in->SetName(L"Replay Plus: the game's picture");
+    s.scene_out->SetName(L"Replay Plus: the picture through its lens");
+    s.scene_width = static_cast<std::uint32_t>(d.Width);
+    s.scene_height = d.Height;
+    s.scene_format = d.Format;
+    ++s.scene_serial;
+    if (!s.scene_said) {
+        s.scene_said = true;
+        logging::write(logging::Level::info, logging::Channel::graphics,
+                       std::format("Replay Plus: it draws under the game's UI (the game's picture before it: {}x{}, format {}).", d.Width,
+                                   d.Height, static_cast<int>(d.Format)));
+    }
+    return true;
+}
+// Still a render target here (its barrier to a shader resource is passed on after this).
+void take_scene(Shared& s, ID3D12GraphicsCommandList* list, ID3D12Resource* picture, const D3D12_RESOURCE_DESC& d, BarrierFn original) {
+    if (!make_scene(s, picture, d)) return;
+    constexpr auto all = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    transition(list, original, picture, all, D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    transition(list, original, s.scene_in.Get(), 0, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COPY_DEST);
+    list->CopyResource(s.scene_in.Get(), picture);
+    transition(list, original, s.scene_in.Get(), 0, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    if (s.scene_ready) {
+        transition(list, original, picture, all, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_COPY_DEST);
+        list->CopyResource(picture, s.scene_out.Get());
+        transition(list, original, picture, all, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_RENDER_TARGET);
+        s.scene_ready = false;
+    } else {
+        transition(list, original, picture, all, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    }
+    s.scene_epoch = s.epoch;
+}
+constexpr std::uint32_t ui_rows = 8;
+constexpr std::array<float, 3> ui_strips{0.895f, 0.924f, 0.953f}; // the replay editor's button prompts
+// A band down the lower part of the UI, 48 pixels wide at a quarter of the width: the timeline's bar
+// crosses it (between 10% and 90% of the width, at about 82% of the height on a 16:9 screen, lower at
+// 4:3), as a run of rows of one even, see-through grey.
+constexpr std::uint32_t band_width = 48, band_pitch = 256;
+// Two bands, a quarter of the way in from either side: the playhead's marker can cross one of them.
+constexpr std::array<float, 2> band_xs{0.26f, 0.72f};
+constexpr float band_from = 0.70f, band_to = 0.96f;
+std::uint32_t band_rows(std::uint32_t height) { return static_cast<std::uint32_t>(static_cast<float>(height) * (band_to - band_from)); }
+std::uint64_t strips_bytes(std::uint32_t pitch) { return std::uint64_t{pitch} * ui_rows * ui_strips.size(); }
+std::uint64_t band_bytes(std::uint32_t height) { return (std::uint64_t{band_rows(height)} * band_pitch + 511u) & ~std::uint64_t{511u}; }
+// A readback slot: the strips, then the bands (each copy's place 512-byte aligned).
+std::uint64_t ui_slot_bytes(std::uint32_t pitch, std::uint32_t height) { return strips_bytes(pitch) + band_bytes(height) * band_xs.size(); }
+void take_ui(Shared& s, ID3D12GraphicsCommandList* list, ID3D12Resource* ui, const D3D12_RESOURCE_DESC& d, BarrierFn original) {
+    const auto width = static_cast<std::uint32_t>(d.Width);
+    const std::uint32_t pitch = (width * 4 + 255u) & ~255u;
+    const std::uint64_t slot_size = ui_slot_bytes(pitch, d.Height);
+    if (!s.ui_readback || s.ui_width != width || s.ui_height != d.Height || s.ui_format != d.Format) {
+        ComPtr<ID3D12Device> device;
+        if (FAILED(ui->GetDevice(IID_PPV_ARGS(&device)))) return;
+        if (s.ui_readback) s.retired.push_back({std::move(s.ui_readback), s.epoch});
+        D3D12_HEAP_PROPERTIES heap{};
+        heap.Type = D3D12_HEAP_TYPE_READBACK;
+        D3D12_RESOURCE_DESC bytes{};
+        bytes.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        bytes.Width = slot_size * 4;
+        bytes.Height = 1;
+        bytes.DepthOrArraySize = 1;
+        bytes.MipLevels = 1;
+        bytes.SampleDesc.Count = 1;
+        bytes.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &bytes, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                                   IID_PPV_ARGS(&s.ui_readback)))) {
+            s.ui_readback.Reset();
+            return;
+        }
+        s.ui_width = width;
+        s.ui_height = d.Height;
+        s.ui_pitch = pitch;
+        s.ui_format = d.Format;
+        s.ui_written = {};
+    }
+    const auto slot = static_cast<std::size_t>(s.ui_frame % s.ui_written.size());
+    constexpr auto all = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    transition(list, original, ui, all, D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    for (std::size_t k = 0; k < ui_strips.size(); ++k) {
+        D3D12_TEXTURE_COPY_LOCATION to{}, from{};
+        to.pResource = s.ui_readback.Get();
+        to.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        to.PlacedFootprint.Offset = slot * slot_size + k * std::uint64_t{pitch} * ui_rows;
+        to.PlacedFootprint.Footprint.Format = d.Format;
+        to.PlacedFootprint.Footprint.Width = width;
+        to.PlacedFootprint.Footprint.Height = ui_rows;
+        to.PlacedFootprint.Footprint.Depth = 1;
+        to.PlacedFootprint.Footprint.RowPitch = pitch;
+        from.pResource = ui;
+        from.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        const UINT top = std::min<UINT>(d.Height - ui_rows, static_cast<UINT>(ui_strips[k] * static_cast<float>(d.Height)));
+        const D3D12_BOX box{0, top, 0, width, top + ui_rows, 1};
+        list->CopyTextureRegion(&to, 0, 0, 0, &from, &box);
+    }
+    for (std::size_t b = 0; b < band_xs.size(); ++b) {
+        const auto rows = band_rows(d.Height);
+        if (rows <= 8 || width <= band_width) break;
+        const float band_x = band_xs[b];
+        D3D12_TEXTURE_COPY_LOCATION to{}, from{};
+        to.pResource = s.ui_readback.Get();
+        to.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        to.PlacedFootprint.Offset = slot * slot_size + strips_bytes(pitch) + band_bytes(d.Height) * b;
+        to.PlacedFootprint.Footprint.Format = d.Format;
+        to.PlacedFootprint.Footprint.Width = band_width;
+        to.PlacedFootprint.Footprint.Height = rows;
+        to.PlacedFootprint.Footprint.Depth = 1;
+        to.PlacedFootprint.Footprint.RowPitch = band_pitch;
+        from.pResource = ui;
+        from.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        const UINT left = std::min<UINT>(width - band_width, static_cast<UINT>(band_x * static_cast<float>(width)));
+        const UINT top = static_cast<UINT>(band_from * static_cast<float>(d.Height));
+        const D3D12_BOX box{left, top, 0, left + band_width, top + rows, 1};
+        list->CopyTextureRegion(&to, 0, 0, 0, &from, &box);
+    }
+    transition(list, original, ui, all, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    s.ui_written[slot] = s.epoch;
+    ++s.ui_frame;
+    s.ui_epoch = s.epoch;
+}
+// Present: the alpha of the newest strips the GPU has surely written (three frames or more back).
+void read_ui(Shared& s) {
+    std::size_t best = s.ui_written.size();
+    for (std::size_t i = 0; i < s.ui_written.size(); ++i)
+        if (s.ui_written[i] && s.ui_written[i] + 3 <= s.epoch && (best == s.ui_written.size() || s.ui_written[i] > s.ui_written[best])) best = i;
+    if (best == s.ui_written.size() || !s.ui_readback || s.ui_written[best] + 30 < s.epoch) {
+        s.ui_shown = -1;
+        return;
+    }
+    const std::uint64_t slot_size = ui_slot_bytes(s.ui_pitch, s.ui_height);
+    const D3D12_RANGE range{static_cast<SIZE_T>(best * slot_size), static_cast<SIZE_T>((best + 1) * slot_size)};
+    void* mapped{};
+    if (FAILED(s.ui_readback->Map(0, &range, &mapped)) || !mapped) return;
+    const auto* bytes = static_cast<const std::uint8_t*>(mapped) + best * slot_size;
+    std::uint8_t most = 0;
+    for (std::size_t row = 0; row < ui_rows * ui_strips.size(); row += 2)
+        for (std::uint32_t x = 0; x < s.ui_width; x += 6) most = std::max(most, bytes[row * s.ui_pitch + x * 4 + 3]);
+    // The middle strip, through the prompts: its widest stretch with no UI (alpha under 8%), between the
+    // screen's edges' tenths, for the hint to sit in.
+    const auto* strip = bytes + std::size_t{1} * s.ui_pitch * ui_rows;
+    const std::uint32_t step = 4, first = s.ui_width / 10, last = s.ui_width - s.ui_width / 10;
+    std::uint32_t best_from = 0, best_to = 0, run_from = first;
+    bool in_run = false;
+    for (std::uint32_t x = first; x <= last; x += step) {
+        std::uint8_t column = 0;
+        if (x < last)
+            for (std::uint32_t row = 0; row < ui_rows; ++row) column = std::max(column, strip[row * s.ui_pitch + x * 4 + 3]);
+        const bool empty = x < last && column < 20;
+        if (empty && !in_run) {
+            run_from = x;
+            in_run = true;
+        } else if (!empty && in_run) {
+            in_run = false;
+            if (x - run_from > best_to - best_from) best_from = run_from, best_to = x;
+        }
+    }
+    // The band: the highest run of rows of one even grey (most of a row within 20 of its middle value,
+    // between 8% and 92% opaque, the rows within 25 of the run's first) as tall as the bar is (1% to 3.2%
+    // of the height): the timeline's bar, above the prompts' boxes.
+    bool bar_found = false;
+    float bar_y = 0;
+    for (std::size_t b = 0; b < band_xs.size() && !bar_found; ++b) {
+        const auto rows = band_rows(s.ui_height);
+        if (rows <= 8) break;
+        const auto* band = bytes + strips_bytes(s.ui_pitch) + band_bytes(s.ui_height) * b;
+        const auto shortest = static_cast<std::uint32_t>(0.010f * static_cast<float>(s.ui_height));
+        const auto tallest = static_cast<std::uint32_t>(0.032f * static_cast<float>(s.ui_height)) + 1;
+        std::uint32_t band_from_row = 0, run = 0;
+        int band_level = -1;
+        const auto finish = [&](std::uint32_t end) {
+            if (!bar_found && run >= shortest && run <= tallest) {
+                bar_found = true;
+                bar_y = (band_from * static_cast<float>(s.ui_height) + static_cast<float>(band_from_row) + static_cast<float>(end - band_from_row) * 0.5f) /
+                        static_cast<float>(s.ui_height);
+            }
+            run = 0;
+            band_level = -1;
+        };
+        for (std::uint32_t row = 0; row < rows && !bar_found; ++row) {
+            std::array<std::uint8_t, band_width> alpha{};
+            for (std::uint32_t x = 0; x < band_width; ++x) alpha[x] = band[std::size_t{row} * band_pitch + x * 4 + 3];
+            auto sorted = alpha;
+            std::nth_element(sorted.begin(), sorted.begin() + band_width / 2, sorted.end());
+            const int middle = sorted[band_width / 2];
+            unsigned even = 0;
+            for (const auto a : alpha) even += std::abs(static_cast<int>(a) - middle) <= 20 ? 1u : 0u;
+            const bool grey = middle >= 20 && middle <= 235 && even * 5 >= band_width * 4;
+            if (grey && (band_level < 0 || std::abs(middle - band_level) <= 25)) {
+                if (band_level < 0) {
+                    band_from_row = row;
+                    band_level = middle;
+                }
+                ++run;
+            } else {
+                finish(row);
+                if (grey) {
+                    band_from_row = row;
+                    band_level = middle;
+                    run = 1;
+                }
+            }
+        }
+        finish(rows);
+    }
+    const D3D12_RANGE none{};
+    s.ui_readback->Unmap(0, &none);
+    s.bar_found = bar_found;
+    if (bar_found) s.bar_y = bar_y;
+    s.ui_shown = static_cast<float>(most) / 255.0f;
+    s.gap_from = static_cast<float>(best_from) / static_cast<float>(s.ui_width);
+    s.gap_to = static_cast<float>(best_to) / static_cast<float>(s.ui_width);
+}
+// Where the game's last pass begins (its list starts with a swap chain buffer going to a render
+// target): its picture, and its UI, as each goes from a render target to being read.
+void frame_taps(Shared& s, ID3D12GraphicsCommandList* list, UINT count, const D3D12_RESOURCE_BARRIER* barriers, BarrierFn original) {
+    for (UINT i = 0; i < count; ++i) {
+        const auto& b = barriers[i];
+        if (b.Type != D3D12_RESOURCE_BARRIER_TYPE_TRANSITION || !b.Transition.pResource || (b.Flags & D3D12_RESOURCE_BARRIER_FLAG_END_ONLY))
+            continue;
+        auto* resource = b.Transition.pResource;
+        if (swap_buffer(s, resource)) {
+            if (b.Transition.StateBefore == D3D12_RESOURCE_STATE_PRESENT && (b.Transition.StateAfter & D3D12_RESOURCE_STATE_RENDER_TARGET)) {
+                s.composite_list = list;
+                s.composite_epoch = s.epoch;
+            }
+            continue;
+        }
+        if (list != s.composite_list || s.composite_epoch != s.epoch) continue;
+        if (!(b.Transition.StateBefore & D3D12_RESOURCE_STATE_RENDER_TARGET) || !(b.Transition.StateAfter & shader_read)) continue;
+        const auto d = resource->GetDesc();
+        if (d.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D || d.DepthOrArraySize != 1 || d.MipLevels != 1 || d.SampleDesc.Count != 1)
+            continue;
+        // The UI is drawn at the screen's size; the picture at whatever size the game renders it
+        // (Render.ResolutionScale: Sharp middle's 200% is twice the screen's), always the screen's shape.
+        const bool screen_size = d.Width == s.screen_width && d.Height == s.screen_height;
+        if (picture_format(d.Format)) {
+            if ((screen_size || picture_shaped(s, d.Width, d.Height)) && s.scene_wanted && s.scene_epoch != s.epoch)
+                take_scene(s, list, resource, d, original);
+        } else if (ui_format(d.Format)) {
+            if (screen_size && s.ui_wanted && s.ui_epoch != s.epoch) take_ui(s, list, resource, d, original);
+        }
+    }
+}
+// ---- Exports: the depth of each video frame's own frame ----------------------------------------------
+// The rows of a video frame kept to know it again: six, evenly down it; each 512-byte aligned in the readback.
+constexpr std::uint32_t print_rows = 6;
+std::uint32_t print_stride(std::uint32_t width) { return (width * 4u + 511u) & ~511u; }
+std::uint32_t print_row(std::uint32_t height, std::uint32_t i) { return height * (2u * i + 1u) / (2u * print_rows); }
+void retire_kept(Shared& s, Shared::Kept& k) {
+    if (k.texture) s.retired.push_back({std::move(k.texture), s.epoch});
+    if (k.print) {
+        k.print->Unmap(0, nullptr);
+        s.retired.push_back({std::move(k.print), s.epoch});
+    }
+    k.print_cpu = nullptr;
+    k.print_width = k.print_height = 0;
+}
+void keep_for_export(Shared& s, ID3D12GraphicsCommandList* list, const D3D12_RESOURCE_BARRIER& b, BarrierFn original) {
+    // A new export (no video frame for a second or so): nothing kept is for it.
+    if (s.kept_epoch + 60 < s.epoch) {
+        s.kept_popped = s.kept_pushed;
+        s.kept_taken = s.kept_dropped = s.kept_skipped = s.kept_unfound = s.kept_exact = 0;
+        s.kept_fallback_said = s.kept_late_said = s.kept_drop_said = s.kept_unfound_said = false;
+        s.kept_inexact_said = 0;
+    }
+    s.kept_epoch = s.epoch;
+    auto& k = s.kept[s.kept_pushed % s.kept.size()];
+    if (!k.texture || k.width != s.width || k.height != s.height) {
+        ComPtr<ID3D12Device> device;
+        if (FAILED(s.texture->GetDevice(IID_PPV_ARGS(&device)))) return;
+        if (k.texture) s.retired.push_back({std::move(k.texture), s.epoch});
+        auto t = s.texture->GetDesc();
+        D3D12_HEAP_PROPERTIES heap{};
+        heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+        if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &t, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, nullptr,
+                                                   IID_PPV_ARGS(&k.texture)))) {
+            k.texture.Reset();
+            return;
+        }
+        k.texture->SetName(L"Replay Plus depth kept for an exported frame");
+        k.width = s.width;
+        k.height = s.height;
+    }
+    auto* video = b.Transition.pResource;
+    const auto vd = video->GetDesc();
+    const auto vw = static_cast<std::uint32_t>(vd.Width), vh = vd.Height;
+    if (!k.print || k.print_width != vw || k.print_height != vh) {
+        ComPtr<ID3D12Device> device;
+        if (FAILED(video->GetDevice(IID_PPV_ARGS(&device)))) return;
+        if (k.print) {
+            k.print->Unmap(0, nullptr);
+            s.retired.push_back({std::move(k.print), s.epoch});
+        }
+        k.print_cpu = nullptr;
+        D3D12_RESOURCE_DESC t{};
+        t.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        t.Width = std::uint64_t{print_stride(vw)} * print_rows;
+        t.Height = 1;
+        t.DepthOrArraySize = 1;
+        t.MipLevels = 1;
+        t.SampleDesc.Count = 1;
+        t.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        D3D12_HEAP_PROPERTIES heap{};
+        heap.Type = D3D12_HEAP_TYPE_READBACK;
+        void* mapped{};
+        if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &t, D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&k.print))) ||
+            FAILED(k.print->Map(0, nullptr, &mapped)) || !mapped) {
+            k.print.Reset();
+            return;
+        }
+        k.print->SetName(L"Replay Plus rows of an exported frame");
+        k.print_cpu = static_cast<const std::uint8_t*>(mapped);
+        k.print_width = vw;
+        k.print_height = vh;
+    }
+    if (s.kept_pushed - s.kept_popped >= s.kept.size()) {
+        // Full: the oldest was never taken (the encoder fell behind, or frames were drawn and never encoded).
+        ++s.kept_popped;
+        ++s.kept_dropped;
+        if (!s.kept_drop_said) {
+            s.kept_drop_said = true;
+            logging::write(logging::Level::info, logging::Channel::graphics,
+                           std::format("Replay Plus export: the depth kept for a video frame was let go unused ({} kept, {} taken).", s.kept_pushed,
+                                       s.kept_taken));
+        }
+    }
+    // In the game's list, before its own barrier: the frame's depth copy (in a shader's state between
+    // copies) into the slot.
+    transition(list, original, s.texture.Get(), 0, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    transition(list, original, k.texture.Get(), 0, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COPY_DEST);
+    list->CopyResource(k.texture.Get(), s.texture.Get());
+    transition(list, original, k.texture.Get(), 0, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    transition(list, original, s.texture.Get(), 0, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    // The video frame's rows, as the game has finished drawing it (its own barrier, passed on after this,
+    // takes it on to be copied out for the encoder).
+    transition(list, original, video, b.Transition.Subresource, b.Transition.StateBefore, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    for (std::uint32_t i = 0; i < print_rows; ++i) {
+        D3D12_TEXTURE_COPY_LOCATION to{}, from{};
+        to.pResource = k.print.Get();
+        to.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        to.PlacedFootprint.Offset = std::uint64_t{print_stride(vw)} * i;
+        to.PlacedFootprint.Footprint = {vd.Format, vw, 1, 1, print_stride(vw)};
+        from.pResource = video;
+        from.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        from.SubresourceIndex = 0;
+        const auto row = print_row(vh, i);
+        const D3D12_BOX box{0, row, 0, vw, row + 1, 1};
+        list->CopyTextureRegion(&to, 0, 0, 0, &from, &box);
+    }
+    transition(list, original, video, b.Transition.Subresource, D3D12_RESOURCE_STATE_COPY_SOURCE, b.Transition.StateBefore);
+    k.epoch = s.epoch;
+    k.own_frame = s.copied_epoch == s.epoch;
+    ++s.kept_pushed;
+}
+// The game's video frame as it goes from being drawn to being copied out for its encoder (a trace of an
+// export, 2026-11-17: B8G8R8A8 at the video's size, RENDER_TARGET -> shader read -> COPY_SOURCE, each frame).
+void export_taps(Shared& s, ID3D12GraphicsCommandList* list, UINT count, const D3D12_RESOURCE_BARRIER* barriers, BarrierFn original) {
+    const auto video = replay_shake::export_frames::size();
+    for (UINT i = 0; i < count; ++i) {
+        const auto& b = barriers[i];
+        if (b.Type != D3D12_RESOURCE_BARRIER_TYPE_TRANSITION || !b.Transition.pResource || (b.Flags & D3D12_RESOURCE_BARRIER_FLAG_END_ONLY))
+            continue;
+        if (b.Transition.StateAfter != D3D12_RESOURCE_STATE_COPY_SOURCE || b.Transition.StateBefore == D3D12_RESOURCE_STATE_COPY_SOURCE) continue;
+        const auto d = b.Transition.pResource->GetDesc();
+        if (d.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D || d.Format != DXGI_FORMAT_B8G8R8A8_UNORM || d.DepthOrArraySize != 1 || d.Width < 640)
+            continue;
+        const bool video_size = video.width > 0 ? d.Width == static_cast<UINT64>(video.width) && d.Height == static_cast<UINT>(video.height)
+                                                : picture_shaped(s, d.Width, d.Height);
+        if (!video_size || swap_buffer(s, b.Transition.pResource) || d.MipLevels != 1) continue;
+        keep_for_export(s, list, b, original);
+        return;
+    }
+}
+} // namespace
+
+void barriers(ID3D12GraphicsCommandList* list, UINT count, const D3D12_RESOURCE_BARRIER* barriers, BarrierFn original) noexcept {
+    try {
+        auto& s = shared();
+        if (!list || !barriers || !original) return;
+        if (link::trace_frames().load(std::memory_order_relaxed) > 0) trace(list, count, barriers);
+        std::lock_guard lock(s.mutex);
+        if (list->GetType() != D3D12_COMMAND_LIST_TYPE_DIRECT) return;
+        if (s.scene_wanted || s.ui_wanted) frame_taps(s, list, count, barriers, original);
+        if (s.wanted && s.texture && list != s.own_list) export_taps(s, list, count, barriers, original);
+        if (!s.wanted || s.copied_epoch == s.epoch) return;
+        constexpr auto read = D3D12_RESOURCE_STATE_DEPTH_READ | D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        for (UINT i = 0; i < count; ++i) {
+            const auto& b = barriers[i];
+            if (b.Type != D3D12_RESOURCE_BARRIER_TYPE_TRANSITION || !b.Transition.pResource) continue;
+            if (!(b.Transition.StateBefore & D3D12_RESOURCE_STATE_DEPTH_WRITE) || !(b.Transition.StateAfter & read)) continue;
+            if (b.Flags & D3D12_RESOURCE_BARRIER_FLAG_END_ONLY) continue;
+            if (b.Transition.Subresource != D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES && b.Transition.Subresource != 0) continue;
+            const auto desc = b.Transition.pResource->GetDesc();
+            if (!depth_capable(desc) || !picture_shaped(s, desc.Width, desc.Height)) continue;
+            if (desc.Width > s.largest || s.largest_epoch + 120 < s.epoch) s.largest = desc.Width;
+            if (desc.Width < s.largest) continue;
+            s.largest_epoch = s.epoch;
+            if (desc.Format != DXGI_FORMAT_R32_TYPELESS && desc.Format != DXGI_FORMAT_D32_FLOAT && desc.Format != DXGI_FORMAT_R32G8X24_TYPELESS &&
+                desc.Format != DXGI_FORMAT_D32_FLOAT_S8X24_UINT)
+                continue;
+            copy_from(s, list, b, original);
+            return;
+        }
+    } catch (...) {}
+}
+
+void note_back_buffer(ID3D12Resource* buffer) noexcept {
+    traced_back_buffer.store(buffer);
+    auto& s = shared();
+    std::lock_guard lock(s.mutex);
+    if (!buffer || swap_buffer(s, buffer)) return;
+    s.swap[s.swap_next] = buffer;
+    s.swap_next = (s.swap_next + 1) % s.swap.size();
+}
+void begin_frame(bool wanted, bool scene_wanted, bool ui_wanted, std::uint32_t screen_width, std::uint32_t screen_height) noexcept {
+    if (const int left = link::trace_frames().load(); left > 0) {
+        logging::write(logging::Level::info, logging::Channel::graphics,
+            std::format("Replay Plus trace: ---- present ({} frame(s) left) back buffer {:x} ----", left - 1,
+                reinterpret_cast<std::uintptr_t>(traced_back_buffer.load())));
+        link::trace_frames().store(left - 1);
+    }
+    auto& s = shared();
+    std::lock_guard lock(s.mutex);
+    s.wanted = wanted;
+    s.screen_width = screen_width;
+    s.screen_height = screen_height;
+    // The picture copied in the frame just recorded is this present's to draw from.
+    s.scene_wanted = scene_wanted;
+    if (!scene_wanted) s.scene_ready = false;
+    s.ui_wanted = ui_wanted;
+    if (ui_wanted) read_ui(s);
+    else s.ui_shown = -1;
+    ++s.epoch;
+    // Textures replaced a few frames ago are done with on the GPU.
+    std::erase_if(s.retired, [&](const Retired& r) { return s.epoch > r.epoch + 6; });
+    // What was kept for an export goes a few seconds after its last frame.
+    if (s.kept_epoch && s.kept_epoch + 300 < s.epoch) {
+        for (auto& k : s.kept) retire_kept(s, k);
+        s.kept_popped = s.kept_pushed;
+        s.kept_epoch = 0;
+    }
+    if (!wanted && s.texture && s.copied_epoch + 600 < s.epoch) {
+        // Ten seconds or so without the light: the copy goes too (kept a few frames for the GPU).
+        s.retired.push_back({std::move(s.texture), s.epoch});
+        s.width = s.height = 0;
+        ++s.serial;
+    }
+}
+
+Scene scene() noexcept {
+    auto& s = shared();
+    std::lock_guard lock(s.mutex);
+    Scene c;
+    c.input = s.scene_in.Get();
+    c.output = s.scene_out.Get();
+    c.width = s.scene_width;
+    c.height = s.scene_height;
+    c.format = s.scene_format;
+    c.serial = s.scene_serial;
+    // begin_frame has moved the epoch on: copied in the one before is this frame's.
+    c.fresh = s.scene_in && s.scene_epoch + 1 == s.epoch;
+    return c;
+}
+void scene_drawn(bool drawn) noexcept {
+    auto& s = shared();
+    std::lock_guard lock(s.mutex);
+    s.scene_ready = drawn && s.scene_out;
+}
+float ui_shown() noexcept {
+    auto& s = shared();
+    std::lock_guard lock(s.mutex);
+    return s.ui_shown;
+}
+Gap ui_gap() noexcept {
+    auto& s = shared();
+    std::lock_guard lock(s.mutex);
+    return {s.gap_from, s.gap_to};
+}
+Bar timeline_bar() noexcept {
+    auto& s = shared();
+    std::lock_guard lock(s.mutex);
+    return {s.bar_found, s.bar_y};
+}
+
+Copy current() noexcept {
+    auto& s = shared();
+    std::lock_guard lock(s.mutex);
+    Copy c;
+    c.texture = s.texture.Get();
+    c.width = s.width;
+    c.height = s.height;
+    c.serial = s.serial;
+    // The copy is this frame's only when the game's depth went by this frame.
+    c.fresh = s.texture && s.copied_epoch + 2 >= s.epoch;
+    c.copies = s.copies;
+    return c;
+}
+
+void ignore_list(ID3D12GraphicsCommandList* list) noexcept {
+    auto& s = shared();
+    std::lock_guard lock(s.mutex);
+    s.own_list = list;
+}
+
+Copy for_export(const std::uint8_t* pixels, std::uint32_t width, std::uint32_t height, std::uint32_t pitch, bool* matched) noexcept {
+    auto& s = shared();
+    std::lock_guard lock(s.mutex);
+    if (matched) *matched = false;
+    Copy c;
+    if (s.kept_popped < s.kept_pushed) {
+        // Which kept frame this is, by its rows: the colour's differences summed, the oldest of the closest;
+        // taken only when clearly the closest (frames drawn and never encoded, before it, are passed over); else
+        // in order. (The encoder's frame is rarely the drawn one to the byte: about 5% of its colour bytes differ,
+        // by up to 80, the next frame's some 5 to 25 times as much; its alpha never does. 2026-11-17)
+        std::uint64_t found = s.kept_pushed;
+        std::uint64_t best_sad = ~std::uint64_t{0}, next_sad = ~std::uint64_t{0};
+        std::uint32_t best_alpha = 0, best_bytes = 0;
+        int best_max = 0;
+        if (pixels && width && height && pitch >= width * 4u) {
+            for (std::uint64_t j = s.kept_popped; j < s.kept_pushed; ++j) {
+                const auto& k = s.kept[j % s.kept.size()];
+                if (!k.texture || !k.print_cpu || k.print_width != width || k.print_height != height) continue;
+                std::uint64_t sad = 0;
+                std::uint32_t alpha = 0, bytes = 0;
+                int most = 0;
+                for (std::uint32_t i = 0; i < print_rows; ++i) {
+                    const auto* a = k.print_cpu + std::size_t{print_stride(width)} * i;
+                    const auto* p = pixels + std::size_t{print_row(height, i)} * pitch;
+                    for (std::uint32_t x = 0; x < width * 4u; x += 4) {
+                        for (std::uint32_t ch = 0; ch < 3; ++ch) {
+                            const int d = std::abs(static_cast<int>(a[x + ch]) - static_cast<int>(p[x + ch]));
+                            sad += static_cast<std::uint64_t>(d);
+                            bytes += d != 0;
+                            most = std::max(most, d);
+                        }
+                        alpha += a[x + 3] != p[x + 3];
+                    }
+                }
+                if (sad < best_sad) {
+                    next_sad = best_sad;
+                    best_sad = sad;
+                    best_alpha = alpha;
+                    best_bytes = bytes;
+                    best_max = most;
+                    found = j;
+                } else if (sad < next_sad) {
+                    next_sad = sad;
+                }
+            }
+            // Clearly the closest: none of the others within two and a half times its difference (when there are others).
+            if (found != s.kept_pushed && best_sad != 0 && next_sad != ~std::uint64_t{0} && best_sad * 5 > next_sad * 2) found = s.kept_pushed;
+        }
+        const bool by_pixels = found != s.kept_pushed;
+        if (by_pixels && best_sad == 0) ++s.kept_exact;
+        if (by_pixels && best_sad != 0 && s.kept_inexact_said < 1) {
+            ++s.kept_inexact_said;
+            logging::write(logging::Level::info, logging::Channel::graphics,
+                           std::format("Replay Plus export: frame {} found by its pixels, not exactly: {} of {} colour bytes differ (by up to {}, {:.3f} "
+                                       "a byte), {} of {} alphas; the next closest {:.3f} a byte.",
+                                       s.kept_taken + 1, best_bytes, print_rows * width * 3u, best_max,
+                                       static_cast<double>(best_sad) / (print_rows * width * 3.0), best_alpha, print_rows * width,
+                                       next_sad == ~std::uint64_t{0} ? -1.0 : static_cast<double>(next_sad) / (print_rows * width * 3.0)));
+        }
+        if (!by_pixels) {
+            found = s.kept_popped;
+            ++s.kept_unfound;
+            if (!s.kept_unfound_said) {
+                s.kept_unfound_said = true;
+                logging::write(logging::Level::info, logging::Channel::graphics,
+                               std::format("Replay Plus export: frame {} was not found by its pixels among the {} kept (closest {:.3f} a byte, next "
+                                           "{:.3f}); it is lit from the oldest.",
+                                           s.kept_taken + 1, s.kept_pushed - s.kept_popped,
+                                           best_sad == ~std::uint64_t{0} ? -1.0 : static_cast<double>(best_sad) / (print_rows * width * 3.0),
+                                           next_sad == ~std::uint64_t{0} ? -1.0 : static_cast<double>(next_sad) / (print_rows * width * 3.0)));
+            }
+        }
+        const std::uint64_t skipped = found - s.kept_popped;
+        s.kept_skipped += skipped;
+        const auto& k = s.kept[found % s.kept.size()];
+        s.kept_popped = found + 1;
+        if (k.texture) {
+            ++s.kept_taken;
+            c.texture = k.texture.Get();
+            c.width = k.width;
+            c.height = k.height;
+            c.serial = s.serial;
+            c.fresh = true;
+            c.copies = s.copies;
+            if (matched) *matched = true;
+            if (s.kept_taken <= 2 || s.kept_taken % 600 == 0 || skipped)
+                logging::write(logging::Level::info, logging::Channel::graphics,
+                               std::format("Replay Plus export: frame {} is lit from the depth of the frame it was drawn in ({}{} frame(s) back, {} passed "
+                                           "over, {} more waiting; {} passed over, {} exact, {} not found by pixels, {} let go in all).",
+                                           s.kept_taken, by_pixels ? "found by its pixels, " : "in order, ", s.epoch - k.epoch, skipped,
+                                           s.kept_pushed - s.kept_popped, s.kept_skipped, s.kept_exact, s.kept_unfound, s.kept_dropped));
+            if (!k.own_frame && !s.kept_late_said) {
+                s.kept_late_said = true;
+                logging::write(logging::Level::info, logging::Channel::graphics,
+                               "Replay Plus export: a video frame was finished before the game's depth went by in its frame; it is lit from the frame before.");
+            }
+            return c;
+        }
+    }
+    if (!s.kept_fallback_said) {
+        s.kept_fallback_said = true;
+        logging::write(logging::Level::info, logging::Channel::graphics,
+                       "Replay Plus export: no depth was kept for a video frame; it is lit from the latest.");
+    }
+    c.texture = s.texture.Get();
+    c.width = s.width;
+    c.height = s.height;
+    c.serial = s.serial;
+    c.fresh = s.texture && s.copied_epoch + 2 >= s.epoch;
+    c.copies = s.copies;
+    return c;
+}
+
+void trim() noexcept {
+    auto& s = shared();
+    std::lock_guard lock(s.mutex);
+    const auto retire = [&](ComPtr<ID3D12Resource>& texture) {
+        if (texture) s.retired.push_back({std::move(texture), s.epoch});
+    };
+    if (s.texture) {
+        retire(s.texture);
+        s.width = s.height = 0;
+        ++s.serial;
+    }
+    if (s.scene_in || s.scene_out) {
+        retire(s.scene_in);
+        retire(s.scene_out);
+        s.scene_ready = false;
+        s.scene_width = s.scene_height = 0;
+        ++s.scene_serial;
+    }
+    if (s.ui_readback) {
+        retire(s.ui_readback);
+        s.ui_written = {};
+        s.ui_shown = -1;
+    }
+    for (auto& k : s.kept) retire_kept(s, k);
+    s.kept_popped = s.kept_pushed;
+    s.kept_epoch = 0;
+}
+bool holding() noexcept {
+    auto& s = shared();
+    std::lock_guard lock(s.mutex);
+    bool kept = false;
+    for (const auto& k : s.kept) kept = kept || k.texture;
+    return s.texture || s.scene_in || s.scene_out || s.ui_readback || kept || !s.retired.empty();
+}
+void release() noexcept {
+    auto& s = shared();
+    std::lock_guard lock(s.mutex);
+    s.texture.Reset();
+    s.retired.clear();
+    s.width = s.height = 0;
+    ++s.serial;
+    s.scene_in.Reset();
+    s.scene_out.Reset();
+    s.scene_ready = false;
+    s.scene_width = s.scene_height = 0;
+    ++s.scene_serial;
+    s.ui_readback.Reset();
+    s.ui_written = {};
+    s.ui_shown = -1;
+    s.swap = {};
+    s.composite_list = nullptr;
+    for (auto& k : s.kept) {
+        k.texture.Reset();
+        if (k.print) k.print->Unmap(0, nullptr);
+        k.print.Reset();
+        k.print_cpu = nullptr;
+        k.print_width = k.print_height = 0;
+    }
+    s.kept_popped = s.kept_pushed;
+    s.kept_epoch = 0;
+}
+} // namespace dingosdk::replay_plus::depth
diff --git a/Extension/ReplayPlus/replay_plus_depth.h b/Extension/ReplayPlus/replay_plus_depth.h
new file mode 100644
index 00000000..020971ea
--- /dev/null
+++ b/Extension/ReplayPlus/replay_plus_depth.h
@@ -0,0 +1,80 @@
+#pragma once
+#include <d3d12.h>
+#include <cstdint>
+
+// The game's depth, copied for Replay Plus's camera light (replay_plus_depth.cpp).
+namespace dingosdk::replay_plus::depth {
+using BarrierFn = void(STDMETHODCALLTYPE*)(ID3D12GraphicsCommandList*, UINT, const D3D12_RESOURCE_BARRIER*);
+// From ReSkate's ResourceBarrier hook (Extension/UI/Overlay/depth_tap.cpp), on whichever thread the game
+// records on, before the barriers are passed on: the frame's main depth is copied while wanted.
+void barriers(ID3D12GraphicsCommandList* list, UINT count, const D3D12_RESOURCE_BARRIER* barriers, BarrierFn original) noexcept;
+// Render thread, once a presented frame: whether the light wants the depth, and the screen's size
+// (the main depth has its shape).
+// Present, each frame Replay Plus draws: whether the depth is wanted (the camera light, autofocus), the
+// game's picture before its UI (the pass draws under the game's UI), and how much of that UI shows.
+void begin_frame(bool depth_wanted, bool scene_wanted, bool ui_wanted, std::uint32_t screen_width, std::uint32_t screen_height) noexcept;
+struct Copy {
+    ID3D12Resource* texture{}; // R32_TYPELESS, read as R32_FLOAT; held by the depth module
+    std::uint32_t width{}, height{};
+    std::uint64_t serial{};    // changes when the texture is made anew (its view must be too)
+    bool fresh{};              // the game's depth went by this frame
+    std::uint64_t copies{};
+};
+Copy current() noexcept;
+// Exports: the game draws each frame of a video into a target of its own and reads it back for its
+// encoder five or six frames later, so current() is then that far on from the frame being finished, and
+// the light's edges stood off the characters' (ghosting, 2026-11-17). As the game finishes drawing each
+// video frame, its frame's depth is kept with a few rows of the frame itself; this finds, among those
+// kept, the one whose rows are the encoder's frame's (`pixels`, BGRA8 rows `pitch` bytes apart): the
+// frames the game draws but never encodes (a sixth at the start of some exports) are passed over. In
+// order when none matches; as current() when none was kept (`matched` false).
+Copy for_export(const std::uint8_t* pixels, std::uint32_t width, std::uint32_t height, std::uint32_t pitch, bool* matched = nullptr) noexcept;
+// Replay Plus's own list for exported frames: its barriers are not the game's (its finished frame is the
+// video's format and size too, and names cannot be read back from resources in the game).
+void ignore_list(ID3D12GraphicsCommandList* list) noexcept;
+
+// ---- The game's picture before its UI ----------------------------------------------------------
+// The game finishes its 3D picture in a texture of its own, draws its UI into another, and lays the UI
+// over the picture in a last pass onto the back buffer (a trace of its frame, 2026-11-16: in one list,
+// a swap chain buffer goes from PRESENT to RENDER_TARGET, then the picture and the UI from
+// RENDER_TARGET to shader resources). Where that pass begins, on the game's own list and with copies
+// alone (nothing of the game's drawing state is touched), the picture is copied out (`input`) and what
+// Replay Plus drew from the frame before (`output`) is put in its place: the game then lays its UI over
+// the lens, the grade and the light instead of the lens bending its UI. The picture runs a frame behind
+// the UI.
+struct Scene {
+    ID3D12Resource* input{};   // this frame's picture (PIXEL_SHADER_RESOURCE)
+    ID3D12Resource* output{};  // where the next frame's is drawn (a render target, COPY_SOURCE between frames)
+    std::uint32_t width{}, height{};
+    DXGI_FORMAT format{DXGI_FORMAT_UNKNOWN};
+    std::uint64_t serial{};    // changes when they are made anew
+    bool fresh{};              // copied in the frame just recorded
+};
+Scene scene() noexcept;
+// Present: whether Replay Plus drew `output` this frame (it goes in for the next frame's picture).
+void scene_drawn(bool drawn) noexcept;
+// How much the game's UI shows along its button prompts at the foot of the screen (0..1: its alpha
+// there, a few frames back), or -1 while it is not known.
+float ui_shown() noexcept;
+// Along the middle of that row of prompts: the widest stretch with none of the game's UI in it (from
+// and to, as shares of the width), or none (both 0).
+struct Gap {
+    float from{}, to{};
+};
+Gap ui_gap() noexcept;
+// The replay editor's timeline bar in the game's UI (its translucent band, above the prompts): its middle,
+// as a share of the height. Not found: `found` false (the UI hidden, or another screen).
+struct Bar {
+    bool found{};
+    float y{};
+};
+Bar timeline_bar() noexcept;
+void release() noexcept;
+// Out of the replay editor: every texture kept here (the depth's copy, the game's picture's two, the UI's
+// readback) goes, retired and freed a few frames on as begin_frame moves on, so none of their video memory
+// stays taken while skating. And whether any is still held (begin_frame goes on being called until none is).
+void trim() noexcept;
+bool holding() noexcept;
+// The back buffer of the frame being drawn (the swap chain's buffers are told apart by it).
+void note_back_buffer(ID3D12Resource* buffer) noexcept;
+} // namespace dingosdk::replay_plus::depth
diff --git a/Extension/ReplayPlus/replay_plus_lens.cpp b/Extension/ReplayPlus/replay_plus_lens.cpp
new file mode 100644
index 00000000..d8063a7b
--- /dev/null
+++ b/Extension/ReplayPlus/replay_plus_lens.cpp
@@ -0,0 +1,962 @@
+#include "replay_plus_lens.h"
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstring>
+#include <mutex>
+#include <thread>
+
+namespace dingosdk::replay_plus::lens {
+namespace {
+float clamp01(float v) noexcept { return std::clamp(v, 0.0f, 1.0f); }
+float smoothstep(float a, float b, float x) noexcept {
+    const float t = clamp01((x - a) / (b - a));
+    return t * t * (3.0f - 2.0f * t);
+}
+// The picture's visible half-height, in q: a 2.39:1 letterbox hides the top and bottom.
+float visible_height(const Frame& f, Bars bars) noexcept {
+    return bars == Bars::scope ? std::min(1.0f, f.view_aspect / scope_aspect) : 1.0f;
+}
+} // namespace
+
+namespace {
+// How far a picture's see-through middle reaches along a direction in the picture's own units (x, y 0 and up).
+float picture_reach(const Hole& hole, float ox, float oy) noexcept {
+    const float k = std::atan2(std::abs(oy), std::abs(ox)) / (pi * 0.5f) * static_cast<float>(hole_steps);
+    const int i = std::clamp(static_cast<int>(k), 0, static_cast<int>(hole_steps) - 1);
+    const float t = std::clamp(k - static_cast<float>(i), 0.0f, 1.0f);
+    return hole.radius[static_cast<std::size_t>(i)] + (hole.radius[static_cast<std::size_t>(i) + 1] - hole.radius[static_cast<std::size_t>(i)]) * t;
+}
+} // namespace
+
+Frame frame_for(const Settings& s, float screen_aspect, float fov, const Hole* hole) {
+    Frame f;
+    f.fisheye = lens_on(s);
+    f.fov = std::clamp(fov, 0.05f, 3.0f);
+    f.source_aspect = std::clamp(screen_aspect, 0.5f, 4.0f);
+    f.view_aspect = s.bars == Bars::four_three ? 4.0f / 3.0f : f.source_aspect;
+    f.zoom = std::max(s.zoom, 1.0f);
+    f.circle = std::clamp(s.circle, 0.5f, 3.0f);
+    f.squeeze = std::clamp(std::isfinite(s.squeeze) ? s.squeeze : 1.0f, 0.5f, 2.0f);
+    f.fit_to_lens = s.fov_mode == FovMode::automatic;
+    f.ease = std::clamp(std::isfinite(s.compress) ? s.compress : 0.0f, 0.0f, 0.5f) / (pi * 0.5f);
+    // The overlay, at its size: its dark edge reaches in from the window's corner hood_size times as far as drawn
+    // (a picture drawn larger about the middle; the circle's edge moved out).
+    const float corner = std::sqrt(f.view_aspect * f.view_aspect + 1.0f);
+    const float size = std::clamp(std::isfinite(s.hood_size) ? s.hood_size : 1.0f, 0.0f, 2.0f);
+    const auto sized = [&](float drawn) { return drawn < corner ? std::max(corner - size * (corner - drawn), 0.05f) : drawn; };
+    if (s.enabled && s.hood == Hood::picture && hole && hole->known) {
+        f.hole = *hole;
+        // Along the window's diagonal (the picture's own (1, 1)), where the corner's dark edge is drawn.
+        const float drawn = picture_reach(f.hole, 1.0f, 1.0f) * corner / std::sqrt(2.0f);
+        if (drawn > 1e-3f) f.hood_scale = sized(drawn) / drawn;
+    } else if (s.enabled && s.hood == Hood::circle) {
+        f.hood_circle = sized(f.circle);
+    }
+    f.fit_to_hood = s.enabled && s.hood_fit && s.hood != Hood::none;
+    // The projection, and the scale that puts 90 degrees at the image circle (equisolid: f = circle / sqrt 2,
+    // K = sqrt 2 / circle).
+    f.curve = std::clamp(std::isfinite(s.curve) ? s.curve : 1.0f, 0.0f, 2.0f);
+    f.scale = (f.curve >= 1.0f ? curve_radius(f.curve, pi * 0.5f) : pi * 0.5f) / f.circle;
+    if (f.curve > 1.001f) {
+        // Bent past equidistant, a lens runs out of angle (asin's 1) a little beyond its 90 degrees: never
+        // inside what shows (the window, or what the overlay leaves showing), where it would smear. Only a strongly
+        // bent lens on a wide window meets this (the Mk1 past about 160% without 4:3 bars).
+        // (Furthest as the lens sees it: across, times the squeeze.)
+        float furthest = 0.0f;
+        for (int i = 0; i <= 64; ++i) {
+            const float phi = static_cast<float>(i) * (pi * 0.5f / 64.0f);
+            const float dx = std::cos(phi), dy = std::sin(phi);
+            furthest = std::max(furthest, visible_radius(f, dx, dy) * std::sqrt(dx * dx * f.squeeze * f.squeeze + dy * dy));
+        }
+        f.scale = std::min(f.scale, 0.98f / ((f.curve - 1.0f) * furthest));
+    }
+    return f;
+}
+
+std::array<float, 2> window(const Frame& f) {
+    const float inner = f.view_aspect, outer = f.source_aspect;
+    return outer > inner ? std::array<float, 2>{inner / outer, 1.0f} : std::array<float, 2>{1.0f, outer / inner};
+}
+
+std::array<float, 2> tangents(const Frame& f) {
+    const float t = std::tan(f.fov * 0.5f);
+    return {t * f.source_aspect, t};
+}
+
+float curve_angle(float curve, float x) noexcept {
+    if (curve < 0.999f) {
+        const float a = 1.0f - curve;
+        return std::atan(a * x) / a;
+    }
+    if (curve > 1.001f) {
+        const float b = curve - 1.0f;
+        return std::asin(std::min(b * x, 1.0f)) / b;
+    }
+    return x;
+}
+float curve_radius(float curve, float theta) noexcept {
+    if (curve < 0.999f) {
+        const float a = 1.0f - curve;
+        return std::tan(std::min(a * theta, 1.5607f)) / a;
+    }
+    if (curve > 1.001f) {
+        const float b = curve - 1.0f;
+        return std::sin(std::min(b * theta, lens::pi * 0.5f)) / b;
+    }
+    return theta;
+}
+float theta(const Frame& f, float r, float fit) {
+    const float x = f.scale * r;
+    return f.scales_angles() ? fit * curve_angle(f.curve, x) : curve_angle(f.curve, fit * x);
+}
+
+float visible_radius(const Frame& f, float ux, float uy) noexcept {
+    float rb = std::min(f.view_aspect / std::max(ux, 1e-5f), 1.0f / std::max(uy, 1e-5f));
+    if (f.fit_to_hood) {
+        if (f.hood_circle > 0) {
+            rb = std::min(rb, f.hood_circle);
+        } else if (f.hole.known) {
+            // The picture spans the window: a point (q) is at (qx / view aspect, qy) of it, over its size.
+            const float ox = ux / f.view_aspect, oy = uy;
+            rb = std::min(rb, picture_reach(f.hole, ox, oy) * f.hood_scale / std::max(std::sqrt(ox * ox + oy * oy), 1e-6f));
+        }
+    }
+    return rb;
+}
+
+float fit(const Frame& f) {
+    if (!f.fisheye) return 1.0f;
+    const auto tg = tangents(f);
+    // A true fisheye (its own curve or more) sees no wider than the real lens (fit 1: 90 degrees at its image
+    // circle). A lens bent less than that may take in all the game drew: at no bend at all the picture is the
+    // game's own. (Auto: no more than the whole lens zoomed, which its field of view was picked for.)
+    float best = f.fit_to_lens ? 1.0f / std::max(f.zoom, 1.0f) : f.curve >= 1.0f ? 1.0f : 1.0f / std::max(f.curve * f.curve, 1e-4f);
+    const float va = f.view_aspect;
+    const auto consider = [&](float phi) {
+        const float dx = std::cos(phi), dy = std::sin(phi);
+        const float rb = visible_radius(f, dx, dy);
+        // The point the lens sees (across, times the squeeze): how far out, and which way the game's
+        // frustum is met.
+        const float lx = dx * f.squeeze, ly = dy, n = std::sqrt(lx * lx + ly * ly);
+        const float ux = lx / std::max(n, 1e-6f), uy = ly / std::max(n, 1e-6f);
+        const float lim = std::atan(std::min(tg[0] / std::max(ux, 1e-5f), tg[1] / std::max(uy, 1e-5f)) * 0.998f);
+        const float rl = rb * n;
+        if (rl <= 1e-6f) return;
+        // The angle the lens may see there before its edge compression: what the compression brings to lim
+        // (th (1 - ease th) = lim, the nearer root; compressed this hard, nothing it sees leaves the picture).
+        const float room = 1.0f - 4.0f * f.ease * lim;
+        if (room <= 0.0f) return;
+        const float allowed = 2.0f * lim / (1.0f + std::sqrt(room));
+        if (f.scales_angles()) {
+            // The angle the frustum allows over the angle the lens sees there.
+            const float th = curve_angle(f.curve, f.scale * rl);
+            if (th > 1e-6f) best = std::min(best, allowed / th);
+        } else {
+            // The focal length at which this edge point sees just the frustum's edge.
+            best = std::min(best, curve_radius(f.curve, allowed) / (f.scale * rl));
+        }
+    };
+    // Every way round the quarter, and exactly where what shows has its corners (the fit is tightest there): the
+    // window's corner; where the overlay's edge meets the window's top and its side; and a picture's measured
+    // directions, between which its edge is taken as straight.
+    constexpr int steps = 256;
+    for (int i = 0; i <= steps; ++i) consider(static_cast<float>(i) * (pi * 0.5f / steps));
+    consider(std::atan2(1.0f, va));
+    if (f.fit_to_hood && f.hood_circle > 0) {
+        const float hc = f.hood_circle;
+        if (hc > 1.0f && hc * hc - 1.0f < va * va) consider(std::atan2(1.0f, std::sqrt(hc * hc - 1.0f)));
+        if (hc > va && hc * hc - va * va < 1.0f) consider(std::atan2(std::sqrt(hc * hc - va * va), va));
+    } else if (f.fit_to_hood && f.hole.known) {
+        // In the picture's own units (it spans the window hood_scale times over) the window's edges are at 1 / scale;
+        // a direction there (psi) is this one in the picture (q).
+        const float edge = 1.0f / std::max(f.hood_scale, 1e-3f);
+        const auto in_q = [&](float psi) { return std::atan2(std::sin(psi), va * std::cos(psi)); };
+        constexpr float segment = pi * 0.5f / static_cast<float>(hole_steps);
+        for (std::size_t k = 0; k <= hole_steps; ++k) {
+            const float psi = static_cast<float>(k) * segment;
+            consider(in_q(psi)); // (each a corner, however slight, of its edge taken as straight between them)
+            if (k == hole_steps) break;
+            for (const bool top : {true, false}) {
+                // Where its edge crosses the window's top (reach sin psi = edge) or side (reach cos psi = edge).
+                const auto past = [&](float at) {
+                    return picture_reach(f.hole, std::cos(at), std::sin(at)) * (top ? std::sin(at) : std::cos(at)) > edge;
+                };
+                float a = psi, b = psi + segment;
+                const bool from = past(a);
+                if (past(b) == from) continue;
+                for (int i = 0; i < 24; ++i) {
+                    const float m = 0.5f * (a + b);
+                    (past(m) == from ? a : b) = m;
+                }
+                consider(in_q(a));
+                consider(in_q(b));
+            }
+        }
+    }
+    return f.fit_to_lens ? best : best / std::max(f.zoom, 1.0f);
+}
+
+// ---- Settings saved before 2026-11-17 ("true angles") --------------------------------------------------
+// The lens as it was then (frame_for, fit and true_ease of that version, word for word): it picked its own fit,
+// allowing true_allowance more angle at the edge of what shows than the game's picture reached, and an ease
+// that took just that back; the hood was a fixed ellipse (the image circle, stretched with the overlay
+// across the window). Only to read such settings as they drew (legacy_true_angles).
+namespace {
+constexpr float legacy_allowance = 1.12f;
+constexpr float legacy_hood_radius = 1.54f, legacy_hood_span = 720.0f / 704.0f;
+struct LegacyFrame {
+    float fov{}, source_aspect{}, view_aspect{}, zoom{}, circle{}, curve{}, scale{}, squeeze{};
+    bool fit_to_lens{};
+    float limit_x = 0, limit_y = 0;
+    bool scales_angles() const noexcept { return curve >= 1.0f; }
+};
+std::array<float, 2> legacy_tangents(const LegacyFrame& f) {
+    const float t = std::tan(f.fov * 0.5f);
+    return {t * f.source_aspect, t};
+}
+LegacyFrame legacy_frame(const Settings& s, bool mk1_hood, float screen_aspect, float fov) {
+    LegacyFrame f;
+    f.fov = std::clamp(fov, 0.05f, 3.0f);
+    f.source_aspect = std::clamp(screen_aspect, 0.5f, 4.0f);
+    f.view_aspect = s.bars == Bars::four_three ? 4.0f / 3.0f : f.source_aspect;
+    f.zoom = std::max(s.zoom, 1.0f);
+    f.circle = std::clamp(s.circle, 0.5f, 3.0f);
+    f.squeeze = std::clamp(std::isfinite(s.squeeze) ? s.squeeze : 1.0f, 0.5f, 2.0f);
+    f.fit_to_lens = s.fov_mode == FovMode::automatic;
+    if (s.hood_fit) {
+        if (mk1_hood) {
+            f.limit_x = legacy_hood_radius * f.view_aspect / (4.0f / 3.0f) / legacy_hood_span;
+            f.limit_y = legacy_hood_radius;
+        } else if (s.hood == Hood::circle) {
+            f.limit_x = f.limit_y = f.circle;
+        }
+    }
+    f.curve = std::clamp(std::isfinite(s.curve) ? s.curve : 1.0f, 0.0f, 2.0f);
+    f.scale = (f.curve >= 1.0f ? curve_radius(f.curve, pi * 0.5f) : pi * 0.5f) / f.circle;
+    if (f.curve > 1.001f) {
+        const float across = f.view_aspect * f.squeeze;
+        float furthest = std::sqrt(across * across + 1.0f);
+        if (f.limit_x > 0 && f.limit_y > 0) furthest = std::min(furthest, std::max(f.limit_x * f.squeeze, f.limit_y));
+        f.scale = std::min(f.scale, 0.98f / ((f.curve - 1.0f) * furthest));
+    }
+    return f;
+}
+float legacy_theta(const LegacyFrame& f, float r, float fit) {
+    const float x = f.scale * r;
+    return f.scales_angles() ? fit * curve_angle(f.curve, x) : curve_angle(f.curve, fit * x);
+}
+float legacy_fit(const LegacyFrame& f) {
+    const auto tg = legacy_tangents(f);
+    const float va = f.view_aspect;
+    float best = f.fit_to_lens ? 1.0f / std::max(f.zoom, 1.0f) : f.curve >= 1.0f ? 1.0f : 1.0f / std::max(f.curve * f.curve, 1e-4f);
+    std::array<float, 69> directions{};
+    for (int i = 0; i <= 64; ++i) directions[static_cast<std::size_t>(i)] = static_cast<float>(i) * (pi * 0.5f / 64.0f);
+    directions[65] = std::atan2(1.0f, va);
+    directions[66] = directions[67] = directions[68] = directions[65];
+    if (f.limit_x > 0 && f.limit_y > 0) {
+        if (f.limit_y > 1.0f) directions[66] = std::atan2(1.0f, f.limit_x * std::sqrt(1.0f - 1.0f / (f.limit_y * f.limit_y)));
+        if (f.limit_x > va) directions[67] = std::atan2(f.limit_y * std::sqrt(1.0f - (va * va) / (f.limit_x * f.limit_x)), va);
+    }
+    for (const float phi : directions) {
+        const float dx = std::cos(phi), dy = std::sin(phi);
+        float rb = std::min(va / std::max(dx, 1e-5f), 1.0f / std::max(dy, 1e-5f));
+        if (f.limit_x > 0 && f.limit_y > 0) {
+            const float ex = dx / f.limit_x, ey = dy / f.limit_y;
+            rb = std::min(rb, 1.0f / std::sqrt(ex * ex + ey * ey));
+        }
+        const float lx = dx * f.squeeze, ly = dy, n = std::sqrt(lx * lx + ly * ly);
+        const float ux = lx / std::max(n, 1e-6f), uy = ly / std::max(n, 1e-6f);
+        const float limit = std::min(tg[0] / std::max(ux, 1e-5f), tg[1] / std::max(uy, 1e-5f)) * 0.998f;
+        const float rl = rb * n;
+        if (rl <= 1e-6f) continue;
+        if (f.scales_angles()) {
+            const float th = curve_angle(f.curve, f.scale * rl);
+            if (th > 1e-6f) best = std::min(best, legacy_allowance * std::atan(limit) / th);
+        } else {
+            best = std::min(best, curve_radius(f.curve, std::atan(limit)) / (f.scale * rl));
+        }
+    }
+    return f.fit_to_lens ? best : best / std::max(f.zoom, 1.0f);
+}
+float legacy_ease(const LegacyFrame& f, float fit) noexcept {
+    if (!f.scales_angles()) return 0.0f;
+    const auto tg = legacy_tangents(f);
+    const float va = f.view_aspect;
+    float ease = 0.0f;
+    constexpr int steps = 512;
+    for (int i = 0; i <= steps + 2; ++i) {
+        float phi = static_cast<float>(std::min(i, steps)) * (pi * 0.5f / steps);
+        if (i == steps + 1) phi = std::atan2(1.0f, va);
+        if (i == steps + 2 && f.limit_x > 0 && f.limit_y > 0 && f.limit_x > va)
+            phi = std::atan2(f.limit_y * std::sqrt(1.0f - (va * va) / (f.limit_x * f.limit_x)), va);
+        const float ux = std::cos(phi), uy = std::sin(phi);
+        float rb = std::min(va / std::max(ux, 1e-5f), 1.0f / std::max(uy, 1e-5f));
+        if (f.limit_x > 0 && f.limit_y > 0) {
+            const float ex = ux / f.limit_x, ey = uy / f.limit_y;
+            rb = std::min(rb, 1.0f / std::sqrt(ex * ex + ey * ey));
+        }
+        const float lx = ux * f.squeeze, ly = uy, n = std::sqrt(lx * lx + ly * ly);
+        const float lim = std::atan(std::min(tg[0] / std::max(lx / n, 1e-5f), tg[1] / std::max(ly / n, 1e-5f)) * 0.998f);
+        const float vis = legacy_theta(f, rb * n, fit);
+        if (vis > lim && vis > 1e-4f) ease = std::max(ease, (1.0f - lim / vis) / vis);
+    }
+    return ease;
+}
+} // namespace
+
+Legacy legacy_true_angles(const Settings& s, bool mk1_hood, float screen_aspect) noexcept {
+    Legacy out;
+    try {
+        float fov = s.fov_mode == FovMode::fixed ? s.fov * pi / 180.0f : 65.0f * pi / 180.0f;
+        if (s.fov_mode == FovMode::automatic) {
+            // Its Auto then: the narrowest field of view at which the whole lens (zoomed) shows.
+            const float most = std::clamp(s.fov_widest, 30.0f, 170.0f) * pi / 180.0f;
+            const auto full = [&](float v) {
+                const auto f = legacy_frame(s, mk1_hood, screen_aspect, v);
+                return legacy_fit(f) * f.zoom >= 0.999f;
+            };
+            fov = most;
+            if (full(most)) {
+                float low = 20.0f * pi / 180.0f, high = most;
+                if (full(low)) {
+                    high = low;
+                } else {
+                    for (int i = 0; i < 24; ++i) {
+                        const float mid = (low + high) * 0.5f;
+                        (full(mid) ? high : low) = mid;
+                    }
+                }
+                fov = high;
+            }
+        }
+        const auto f = legacy_frame(s, mk1_hood, screen_aspect, fov);
+        const float fit = legacy_fit(f);
+        out.compress = std::clamp(legacy_ease(f, fit) * (pi * 0.5f), 0.0f, 0.5f);
+        out.zoom = std::clamp(fit > 1e-3f ? 1.0f / fit : 1.0f, 1.0f, 2.0f);
+    } catch (...) {
+        out = {};
+    }
+    return out;
+}
+
+Hole measure_hole(const std::uint8_t* rgba, std::uint32_t width, std::uint32_t height) noexcept {
+    Hole hole;
+    if (!rgba || width < 8 || height < 8) return hole;
+    // 1 opaque (alpha half or more), 0 see-through, -1 off the picture; (u, v) its own -1..1, v up.
+    const auto at = [&](float u, float v) {
+        const float x = (u + 1.0f) * 0.5f * static_cast<float>(width), y = (1.0f - v) * 0.5f * static_cast<float>(height);
+        if (!(x >= 0.0f && y >= 0.0f && x < static_cast<float>(width) && y < static_cast<float>(height))) return -1;
+        return rgba[(static_cast<std::size_t>(y) * width + static_cast<std::size_t>(x)) * 4 + 3] >= 128 ? 1 : 0;
+    };
+    if (at(0.0f, 0.0f) != 0) return hole; // nothing to see through in the middle
+    // Out from the middle in each direction in each quarter, half a pixel at a time: the nearest it turns opaque.
+    const float step = 0.5f / static_cast<float>(std::max(width, height)) * 2.0f;
+    for (std::size_t k = 0; k <= hole_steps; ++k) {
+        const float psi = static_cast<float>(k) * (pi * 0.5f / static_cast<float>(hole_steps)), cu = std::cos(psi), sv = std::sin(psi);
+        float nearest = 4.0f;
+        for (const float sx : {1.0f, -1.0f})
+            for (const float sy : {1.0f, -1.0f})
+                for (float t = step; t < 2.0f; t += step) {
+                    const int o = at(sx * t * cu, sy * t * sv);
+                    if (o < 0) break; // see-through to the picture's edge
+                    if (o > 0) {
+                        nearest = std::min(nearest, t);
+                        break;
+                    }
+                }
+        hole.radius[k] = nearest;
+    }
+    hole.known = true;
+    return hole;
+}
+
+std::array<float, 2> to_game(const Frame& f, float scale, float qx, float qy) {
+    const auto tg = tangents(f);
+    if (!f.fisheye) return {0.5f + 0.5f * qx / f.source_aspect, 0.5f - 0.5f * qy};
+    qx *= f.squeeze;
+    const float r = std::max(std::sqrt(qx * qx + qy * qy), 1e-6f);
+    float th0 = theta(f, r, scale);
+    if (f.ease > 0) {
+        // Edge compression: eased in, level past where it would turn back (far beyond anything that shows).
+        const float top = 0.5f / f.ease;
+        th0 = th0 < top ? th0 * (1.0f - f.ease * th0) : 0.25f / f.ease;
+    }
+    const float th = std::min(th0, most_theta);
+    const float k = std::tan(th) / r;
+    return {0.5f + 0.5f * qx * k / tg[0], 0.5f - 0.5f * qy * k / tg[1]};
+}
+
+std::array<float, 2> hood_uv(const Frame& f, float qx, float qy) {
+    const float s = std::max(f.hood_scale, 1e-3f);
+    return {0.5f + 0.5f * qx / (f.view_aspect * s), 0.5f - 0.5f * qy / s};
+}
+
+float centre_zoom(const Frame& f, float fit) {
+    // Near the middle every projection sees theta = fit K r (the fit scales the angles or the focal
+    // length, alike there): the picture's half-height spans fit K radians, the game's tan(fov / 2).
+    if (!f.fisheye || fit <= 0 || f.scale <= 0) return 1.0f;
+    return std::tan(f.fov * 0.5f) / (fit * f.scale);
+}
+float auto_fov(const Settings& s, float screen_aspect, float widest, const Hole* hole) {
+    const float most = std::clamp(widest, 30.0f, 170.0f) * pi / 180.0f;
+    if (!lens_on(s)) return most;
+    Settings a = s;
+    a.fov_mode = FovMode::automatic;
+    const auto full = [&](float fov) {
+        const auto f = frame_for(a, screen_aspect, fov, hole);
+        return fit(f) * f.zoom >= 0.9999f;
+    };
+    if (!full(most)) return most;
+    float low = 20.0f * pi / 180.0f, high = most;
+    if (full(low)) return low;
+    for (int i = 0; i < 24; ++i) {
+        const float mid = (low + high) * 0.5f;
+        (full(mid) ? high : low) = mid;
+    }
+    return high;
+}
+
+Glass glass_for(const Settings& s) {
+    Glass g;
+    if (!lens_on(s)) return g;
+    g.fringe = std::clamp(s.fringe, 0.0f, 4.0f);
+    g.shade = std::clamp(s.shade, 0.0f, 3.0f);
+    g.glare = std::clamp(std::isfinite(s.glare) ? s.glare : 0.0f, 0.0f, 3.0f) * glare_light;
+    g.soft = std::clamp(s.soft, 0.0f, 1.0f);
+    return g;
+}
+
+Grade grade_for(const Settings& s) {
+    Grade g;
+    if (!s.enabled) return g;
+    g.exposure = s.exposure;
+    g.contrast = s.contrast;
+    g.saturation = s.saturation;
+    g.warmth = s.warmth;
+    g.tint = s.tint;
+    g.black = s.black;
+    g.vignette = s.vignette;
+    g.camera = s.camera;
+    g.camera_gamma = std::clamp(s.camera_gamma, 0.1f, 1.0f);
+    g.camera_knee = std::clamp(s.camera_knee, 0.0f, 2.0f);
+    g.camera_knee_slope = std::clamp(s.camera_knee_slope, 0.0f, 1.0f);
+    g.camera_black = std::clamp(s.camera_black, -0.5f, 0.5f);
+    g.camera_clip = std::clamp(s.camera_clip, 0.5f, 2.0f);
+    g.camera_colour = std::clamp(s.camera_colour, 0.0f, 3.0f);
+    g.vignette_soft = s.vignette_soft;
+    g.vignette_round = s.vignette_round;
+    g.hue = s.hue;
+    g.filter = s.filter;
+    g.filter_hue = s.filter_hue;
+    g.lift = s.lift;
+    g.gamma = s.gamma;
+    g.gain = s.gain;
+    g.split_shadows = s.split_shadows;
+    g.split_shadows_hue = s.split_shadows_hue;
+    g.split_highlights = s.split_highlights;
+    g.split_highlights_hue = s.split_highlights_hue;
+    g.split_balance = s.split_balance;
+    g.grain = s.grain;
+    g.grain_size = s.grain_size;
+    return g;
+}
+
+std::array<float, 3> hue_colour(float degrees) noexcept {
+    float h = std::fmod(degrees, 360.0f);
+    if (h < 0) h += 360.0f;
+    h /= 60.0f;
+    const auto channel = [&](float offset) { return clamp01(std::abs(std::fmod(h + offset, 6.0f) - 3.0f) - 1.0f); };
+    return {channel(0.0f), channel(4.0f), channel(2.0f)};
+}
+std::array<float, 9> colour_matrix(const Grade& g) noexcept {
+    // The hue turned about the grey axis, keeping Rec.709 brightness (SVG's hueRotate, with Rec.709's weights).
+    const float a = g.hue * pi / 180.0f, c = std::cos(a), s = std::sin(a);
+    const float lr = 0.2126f, lg = 0.7152f, lb = 0.0722f;
+    const std::array<float, 9> h{lr + c * (1 - lr) - s * lr,        lg - c * lg - s * lg,         lb - c * lb + s * (1 - lb),
+                                 lr - c * lr + s * 0.143f,          lg + c * (1 - lg) + s * 0.140f, lb - c * lb - s * 0.283f,
+                                 lr - c * lr - s * (1 - lr),        lg - c * lg + s * lg,         lb + c * (1 - lb) + s * lb};
+    // Then the saturation, about the same brightness.
+    const float k = g.saturation;
+    const std::array<float, 9> sat{lr + (1 - lr) * k, lg - lg * k,       lb - lb * k,
+                                   lr - lr * k,       lg + (1 - lg) * k, lb - lb * k,
+                                   lr - lr * k,       lg - lg * k,       lb + (1 - lb) * k};
+    std::array<float, 9> m{};
+    for (int r = 0; r < 3; ++r)
+        for (int col = 0; col < 3; ++col) {
+            float v = 0;
+            for (int i = 0; i < 3; ++i) v += sat[static_cast<std::size_t>(r * 3 + i)] * h[static_cast<std::size_t>(i * 3 + col)];
+            m[static_cast<std::size_t>(r * 3 + col)] = v;
+        }
+    return m;
+}
+std::array<float, 3> filter_gains(const Grade& g) noexcept {
+    std::array<float, 3> f{1, 1, 1};
+    if (g.filter > 0) {
+        const auto colour = hue_colour(g.filter_hue);
+        for (std::size_t i = 0; i < 3; ++i) f[i] = 1.0f + (colour[i] - 1.0f) * std::clamp(g.filter, 0.0f, 1.0f);
+        const float y = std::max(0.2126f * f[0] + 0.7152f * f[1] + 0.0722f * f[2], 1e-3f);
+        for (auto& v : f) v /= y;
+    }
+    const auto wb = balance(g.warmth, g.tint);
+    return {f[0] * wb[0], f[1] * wb[1], f[2] * wb[2]};
+}
+std::array<float, 3> split_offset(float hue, float amount) noexcept {
+    if (!(amount > 0)) return {0, 0, 0};
+    const auto colour = hue_colour(hue);
+    const float y = 0.2126f * colour[0] + 0.7152f * colour[1] + 0.0722f * colour[2];
+    const float k = 0.22f * std::clamp(amount, 0.0f, 1.0f);
+    return {(colour[0] - y) * k, (colour[1] - y) * k, (colour[2] - y) * k};
+}
+float vignette_edge(const Grade& g, float qx, float qy, float va) noexcept {
+    const float round = std::sqrt(qx * qx + qy * qy) / std::sqrt(va * va + 1.0f);
+    const float sx = qx / std::max(va, 1e-3f);
+    const float own = std::sqrt(sx * sx + qy * qy) / std::sqrt(2.0f);
+    const float k = clamp01(g.vignette_round);
+    return own + (round - own) * k;
+}
+float vignette_power(float soft) noexcept { return 2.5f * std::exp2((0.5f - clamp01(soft)) * 2.0f); }
+float grain_noise(float x, float y, float size, float seed) noexcept {
+    // Dave Hoskins's hash12, on cells of `size` pixels, smoothly between them (as the shader).
+    const auto hash = [](float px, float py) {
+        float a = px * 0.1031f, b = py * 0.1031f, c = px * 0.1031f;
+        a -= std::floor(a);
+        b -= std::floor(b);
+        c -= std::floor(c);
+        const float d = a * (b + 33.33f) + b * (c + 33.33f) + c * (a + 33.33f);
+        a += d;
+        b += d;
+        c += d;
+        const float v = (a + b) * c;
+        return v - std::floor(v);
+    };
+    const float cell = std::max(size, 0.5f);
+    const float gx = x / cell + seed * 17.0f, gy = y / cell + seed * 59.0f;
+    const float ix = std::floor(gx), iy = std::floor(gy);
+    float fx = gx - ix, fy = gy - iy;
+    fx = fx * fx * (3.0f - 2.0f * fx);
+    fy = fy * fy * (3.0f - 2.0f * fy);
+    const float a = hash(ix, iy), b = hash(ix + 1, iy), c = hash(ix, iy + 1), d = hash(ix + 1, iy + 1);
+    const float v = (a + (b - a) * fx) + ((c + (d - c) * fx) - (a + (b - a) * fx)) * fy;
+    // Smoothing between cells lowers the spread: brought back for coarse grain.
+    return (v - 0.5f) * (1.0f + 0.7f * clamp01(cell - 1.0f));
+}
+
+std::array<float, 3> balance(float warmth, float tint) {
+    float r = (1.0f + 0.18f * warmth) * (1.0f + 0.05f * tint);
+    float g = 1.0f - 0.15f * tint;
+    float b = (1.0f - 0.22f * warmth) * (1.0f + 0.05f * tint);
+    const float y = 0.2126f * r + 0.7152f * g + 0.0722f * b;
+    return {r / y, g / y, b / y};
+}
+
+float srgb_to_linear(float v) noexcept {
+    v = std::max(v, 0.0f);
+    return v <= 0.04045f ? v / 12.92f : std::pow((v + 0.055f) / 1.055f, 2.4f);
+}
+float linear_to_srgb(float v) noexcept {
+    v = std::max(v, 0.0f);
+    return v <= 0.0031308f ? v * 12.92f : 1.055f * std::pow(v, 1.0f / 2.4f) - 0.055f;
+}
+
+float inverse_filmic(float y) noexcept {
+    y = std::clamp(y, 0.0f, 0.995f);
+    const float a = 2.43f * y - 2.51f, b = 0.59f * y - 0.03f, c = 0.14f * y;
+    return (-b - std::sqrt(std::max(b * b - 4.0f * a * c, 0.0f))) / (2.0f * a);
+}
+float camera_toe_slope(float gamma) noexcept {
+    if (gamma == 0.45f) return 4.5f;
+    const float here = 1.099f * std::pow(0.018f, gamma) - 0.099f, rec709 = 1.099f * std::pow(0.018f, 0.45f) - 0.099f;
+    return 4.5f * here / rec709;
+}
+std::array<float, 3> camera_curve(const Grade& g, std::array<float, 3> l) noexcept {
+    const float toe = camera_toe_slope(g.camera_gamma);
+    for (auto& v : l) {
+        v = std::max(v, 0.0f);
+        v = v < 0.018f ? toe * v : 1.099f * std::pow(v, g.camera_gamma) - 0.099f;
+        if (v > g.camera_knee) v = g.camera_knee + (v - g.camera_knee) * g.camera_knee_slope;
+        v = std::min((v + g.camera_black) / (1.0f + g.camera_black), g.camera_clip);
+    }
+    const float y = 0.2126f * l[0] + 0.7152f * l[1] + 0.0722f * l[2];
+    for (auto& v : l) v = clamp01(y + (v - y) * g.camera_colour);
+    return l;
+}
+
+std::array<float, 3> graded(const Grade& g, std::array<float, 3> c, float edge, float shade, float glare) {
+    if (g.camera)
+        for (auto& v : c) v = inverse_filmic(v) * shade + glare;
+    else
+        for (auto& v : c) v = v * shade + glare;
+    const float gain = std::exp2(g.exposure);
+    const auto wb = filter_gains(g); // white balance and the colour filter
+    for (int i = 0; i < 3; ++i) c[i] = std::max(c[i] * gain * wb[i], 0.0f);
+    if (g.contrast != 1.0f)
+        for (auto& v : c) v = 0.18f * std::pow(std::max(v, 1e-6f) / 0.18f, g.contrast);
+    // The hue and the saturation.
+    const auto m = colour_matrix(g);
+    const std::array<float, 3> in = c;
+    for (int r = 0; r < 3; ++r) {
+        const auto row = static_cast<std::size_t>(r * 3);
+        c[static_cast<std::size_t>(r)] = std::max(m[row] * in[0] + m[row + 1] * in[1] + m[row + 2] * in[2], 0.0f);
+    }
+    if (g.vignette > 0) {
+        const float darken = 1.0f - 0.9f * g.vignette * std::pow(clamp01(edge), vignette_power(g.vignette_soft));
+        for (auto& v : c) v *= darken;
+    }
+    if (g.camera) {
+        c = camera_curve(g, c);
+        for (auto& v : c) v = srgb_to_linear(v);
+    }
+    // On the picture's values: lift, gamma and gain, split toning, faded blacks.
+    if (g.tones() || g.black > 0) {
+        std::array<float, 3> p{linear_to_srgb(c[0]), linear_to_srgb(c[1]), linear_to_srgb(c[2])};
+        if (g.lift != 0 || g.gain != 1 || g.gamma != 1)
+            for (auto& v : p) {
+                v = std::max(v * g.gain + g.lift * (1.0f - v), 0.0f);
+                if (g.gamma != 1) v = std::pow(v, 1.0f / std::max(g.gamma, 0.05f));
+            }
+        if (g.split_shadows > 0 || g.split_highlights > 0) {
+            const auto low = split_offset(g.split_shadows_hue, g.split_shadows), high = split_offset(g.split_highlights_hue, g.split_highlights);
+            const float lum = 0.2126f * p[0] + 0.7152f * p[1] + 0.0722f * p[2];
+            const float pivot = 0.5f - 0.35f * std::clamp(g.split_balance, -1.0f, 1.0f);
+            const float w = smoothstep(pivot - 0.35f, pivot + 0.35f, lum);
+            for (std::size_t i = 0; i < 3; ++i) p[i] = std::max(p[i] + low[i] * (1.0f - w) + high[i] * w, 0.0f);
+        }
+        if (g.black > 0)
+            for (auto& v : p) v = g.black + v * (1.0f - g.black);
+        for (std::size_t i = 0; i < 3; ++i) c[i] = srgb_to_linear(p[i]);
+    }
+    return c;
+}
+
+Finish finish_for(const Settings& s, float screen_aspect, float fov, const Hole* hole) {
+    Finish f;
+    f.frame = frame_for(s, screen_aspect, fov, hole);
+    f.fit = fit(f.frame);
+    f.glass = glass_for(s);
+    f.grade = grade_for(s);
+    f.bars = s.enabled ? s.bars : Bars::none;
+    f.hood = s.enabled ? s.hood : Hood::none;
+    f.hood_opacity = clamp01(s.hood_opacity);
+    return f;
+}
+
+bool changes(const Finish& f) noexcept {
+    return f.frame.fisheye || !f.grade.identity() || !f.glass.none() || f.bars != Bars::none ||
+           (f.hood != Hood::none && f.hood_opacity > 0 && (f.hood == Hood::circle || f.texture.rgba));
+}
+
+namespace {
+// The trace of every pixel of a picture back into the game's, kept while nothing about it changes
+// (most exports film one lens at one field of view throughout).
+struct Trace {
+    std::uint32_t width{}, height{};
+    Frame frame;
+    float fit{};
+    Bars bars{};
+    std::vector<float> uv;   // two per pixel: where in the game's picture (in its pixels); x < -1e8: black
+    std::vector<float> foot; // two per pixel: how many of the game's pixels one of ours spans, across and up
+};
+std::mutex trace_mutex;
+Trace& trace() {
+    static auto* value = new Trace;
+    return *value;
+}
+bool same(const Frame& a, const Frame& b) noexcept {
+    return a.fisheye == b.fisheye && a.fov == b.fov && a.source_aspect == b.source_aspect && a.view_aspect == b.view_aspect && a.zoom == b.zoom &&
+           a.circle == b.circle && a.curve == b.curve && a.scale == b.scale && a.squeeze == b.squeeze && a.ease == b.ease &&
+           a.fit_to_hood == b.fit_to_hood && a.hole.known == b.hole.known && a.hole.radius == b.hole.radius && a.hood_scale == b.hood_scale &&
+           a.hood_circle == b.hood_circle;
+}
+void build_trace(Trace& t, const Finish& f, std::uint32_t w, std::uint32_t h, unsigned threads) {
+    t.width = w;
+    t.height = h;
+    t.frame = f.frame;
+    t.fit = f.fit;
+    t.bars = f.bars;
+    t.uv.assign(std::size_t{w} * h * 2, 0.0f);
+    t.foot.assign(std::size_t{w} * h * 2, 1.0f);
+    const auto win = window(f.frame);
+    const float va = f.frame.view_aspect;
+    const float half = visible_height(f.frame, f.bars);
+    const bool lens = f.frame.fisheye;
+    const auto rows = [&](std::uint32_t first, std::uint32_t last) {
+        for (std::uint32_t y = first; y < last; ++y)
+            for (std::uint32_t x = 0; x < w; ++x) {
+                const std::size_t at = (std::size_t{y} * w + x) * 2;
+                const float wx = ((static_cast<float>(x) + 0.5f) / static_cast<float>(w) - 0.5f) / win[0] + 0.5f;
+                const float wy = ((static_cast<float>(y) + 0.5f) / static_cast<float>(h) - 0.5f) / win[1] + 0.5f;
+                const float qx = (wx - 0.5f) * 2.0f * va, qy = 1.0f - 2.0f * wy;
+                if (wx < 0 || wx > 1 || wy < 0 || wy > 1 || std::abs(qy) > half) {
+                    t.uv[at] = -1e9f;
+                    continue;
+                }
+                if (!lens) {
+                    t.uv[at] = static_cast<float>(x) + 0.5f;
+                    t.uv[at + 1] = static_cast<float>(y) + 0.5f;
+                    continue;
+                }
+                const float dqx = 2.0f * va / static_cast<float>(w) / win[0], dqy = -2.0f / static_cast<float>(h) / win[1];
+                const auto p = to_game(f.frame, f.fit, qx, qy);
+                const auto px = to_game(f.frame, f.fit, qx + dqx, qy);
+                const auto py = to_game(f.frame, f.fit, qx, qy + dqy);
+                t.uv[at] = p[0] * static_cast<float>(w);
+                t.uv[at + 1] = p[1] * static_cast<float>(h);
+                t.foot[at] = std::hypot((px[0] - p[0]) * static_cast<float>(w), (px[1] - p[1]) * static_cast<float>(h));
+                t.foot[at + 1] = std::hypot((py[0] - p[0]) * static_cast<float>(w), (py[1] - p[1]) * static_cast<float>(h));
+            }
+    };
+    if (threads <= 1 || h < 64) {
+        rows(0, h);
+        return;
+    }
+    std::vector<std::thread> pool;
+    const std::uint32_t each = (h + threads - 1) / threads;
+    for (unsigned i = 0; i < threads; ++i) {
+        const std::uint32_t first = i * each, last = std::min(h, first + each);
+        if (first < last) pool.emplace_back(rows, first, last);
+    }
+    for (auto& thread : pool) thread.join();
+}
+
+struct Luts {
+    std::array<float, 256> decode{};
+    std::array<std::uint8_t, 4097> encode{};
+    Luts() {
+        for (int i = 0; i < 256; ++i) decode[static_cast<std::size_t>(i)] = srgb_to_linear(static_cast<float>(i) / 255.0f);
+        for (int i = 0; i <= 4096; ++i)
+            encode[static_cast<std::size_t>(i)] =
+                static_cast<std::uint8_t>(std::clamp(std::lround(linear_to_srgb(static_cast<float>(i) / 4096.0f) * 255.0f), 0L, 255L));
+    }
+};
+const Luts& luts() {
+    static const Luts value;
+    return value;
+}
+std::uint8_t encode8(float linear) noexcept {
+    const float at = std::clamp(linear, 0.0f, 1.0f) * 4096.0f;
+    return luts().encode[static_cast<std::size_t>(at + 0.5f)];
+}
+
+// Reading the game's picture (the scratch copy): linear light, clamped to its edge.
+struct Source {
+    const std::uint8_t* pixels;
+    std::uint32_t width, height, pitch;
+    std::array<float, 3> texel(int x, int y) const noexcept {
+        x = std::clamp(x, 0, static_cast<int>(width) - 1);
+        y = std::clamp(y, 0, static_cast<int>(height) - 1);
+        const auto* p = pixels + static_cast<std::size_t>(y) * pitch + static_cast<std::size_t>(x) * 4;
+        const auto& d = luts().decode;
+        return {d[p[0]], d[p[1]], d[p[2]]};
+    }
+    std::array<float, 3> bilinear(float x, float y) const noexcept {
+        x -= 0.5f;
+        y -= 0.5f;
+        const float fx = std::floor(x), fy = std::floor(y);
+        const int ix = static_cast<int>(fx), iy = static_cast<int>(fy);
+        const float ax = x - fx, ay = y - fy;
+        const auto a = texel(ix, iy), b = texel(ix + 1, iy), c = texel(ix, iy + 1), d = texel(ix + 1, iy + 1);
+        std::array<float, 3> r{};
+        for (int i = 0; i < 3; ++i) {
+            const auto k = static_cast<std::size_t>(i);
+            r[k] = (a[k] * (1 - ax) + b[k] * ax) * (1 - ay) + (c[k] * (1 - ax) + d[k] * ax) * ay;
+        }
+        return r;
+    }
+    // Catmull-Rom where the picture is enlarged: sharp, and exact at the game's pixels.
+    std::array<float, 3> bicubic(float x, float y) const noexcept {
+        x -= 0.5f;
+        y -= 0.5f;
+        const float fx = std::floor(x), fy = std::floor(y);
+        const int ix = static_cast<int>(fx), iy = static_cast<int>(fy);
+        const auto weights = [](float t) {
+            const float t2 = t * t, t3 = t2 * t;
+            return std::array<float, 4>{-0.5f * t3 + t2 - 0.5f * t, 1.5f * t3 - 2.5f * t2 + 1.0f, -1.5f * t3 + 2.0f * t2 + 0.5f * t,
+                                        0.5f * t3 - 0.5f * t2};
+        };
+        const auto wx = weights(x - fx), wy = weights(y - fy);
+        std::array<float, 3> r{};
+        for (int j = 0; j < 4; ++j)
+            for (int i = 0; i < 4; ++i) {
+                const auto t = texel(ix - 1 + i, iy - 1 + j);
+                const float w = wx[static_cast<std::size_t>(i)] * wy[static_cast<std::size_t>(j)];
+                for (std::size_t k = 0; k < 3; ++k) r[k] += t[k] * w;
+            }
+        for (auto& v : r) v = std::max(v, 0.0f);
+        return r;
+    }
+};
+
+std::array<float, 4> hood_texel(const Hood8& t, float u, float v) noexcept {
+    const float x = std::clamp(u, 0.0f, 1.0f) * static_cast<float>(t.width) - 0.5f;
+    const float y = std::clamp(v, 0.0f, 1.0f) * static_cast<float>(t.height) - 0.5f;
+    const float fx = std::floor(x), fy = std::floor(y);
+    const float ax = x - fx, ay = y - fy;
+    const auto at = [&](int ix, int iy) {
+        ix = std::clamp(ix, 0, static_cast<int>(t.width) - 1);
+        iy = std::clamp(iy, 0, static_cast<int>(t.height) - 1);
+        const auto* p = t.rgba + (static_cast<std::size_t>(iy) * t.width + static_cast<std::size_t>(ix)) * 4;
+        return std::array<float, 4>{p[0] / 255.0f, p[1] / 255.0f, p[2] / 255.0f, p[3] / 255.0f};
+    };
+    const int ix = static_cast<int>(fx), iy = static_cast<int>(fy);
+    const auto a = at(ix, iy), b = at(ix + 1, iy), c = at(ix, iy + 1), d = at(ix + 1, iy + 1);
+    std::array<float, 4> r{};
+    for (std::size_t k = 0; k < 4; ++k) r[k] = (a[k] * (1 - ax) + b[k] * ax) * (1 - ay) + (c[k] * (1 - ax) + d[k] * ax) * ay;
+    return r;
+}
+} // namespace
