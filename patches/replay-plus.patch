+        now.kind = RowKind::action;
+        now.key = "none";
+        now.label = "Field of view now";
+        now.value = view.fov_degrees > 0 ? std::format("{:.0f}°", view.fov_degrees) : std::string("-");
+        now.hint = "What the replay camera shows now";
