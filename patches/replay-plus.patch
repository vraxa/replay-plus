+        now.value = view.focus_distance_now > 0 ? std::format("{:.2f} m", view.focus_distance_now) : std::string("-");
+        now.hint = "How far away the middle of the picture is, as the focus follows it";
+        rows.push_back(now);
+    }
+    if (tab == Tab::lens) {
