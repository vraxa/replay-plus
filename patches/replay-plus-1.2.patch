+    const auto replay = client ? peek_pointer(client + addr::replay_activity::manager) : 0;
+    return replay && memory::peek(replay + 0x70, from) && memory::peek(replay + 0x78, to) && std::isfinite(from) && std::isfinite(to) && to > from;
