@@ -0,0 +1,27 @@
+#include "replay_shake_view.h"
+#include <mutex>
+
+namespace dingosdk::replay_shake {
+namespace {
+struct Feed {
+    std::mutex mutex;
+    std::shared_ptr<const View> view = std::make_shared<const View>();
+};
+Feed& feed() {
+    static auto* value = new Feed;
+    return *value;
+}
+} // namespace
+
+std::shared_ptr<const View> view() noexcept {
+    auto& f = feed();
+    std::lock_guard lock(f.mutex);
+    return f.view;
+}
+void publish(std::shared_ptr<const View> next) noexcept {
+    if (!next) return;
+    auto& f = feed();
+    std::lock_guard lock(f.mutex);
+    f.view = std::move(next);
+}
+} // namespace dingosdk::replay_shake
diff --git a/Extension/ReplayShake/replay_shake_view.h b/Extension/ReplayShake/replay_shake_view.h
new file mode 100644
index 00000000..9d8e2bd0
--- /dev/null
+++ b/Extension/ReplayShake/replay_shake_view.h
@@ -0,0 +1,57 @@
+#pragma once
+#include "replay_shake_model.h"
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+// What the menu shows of Replay Shake: a snapshot the client tick publishes after each change. The
+// menu reads it on its own thread and changes things only through `replayshake` console commands.
+// Kept apart from replay_shake.cpp so the overlay library links without the game-facing half.
+namespace dingosdk::replay_shake {
+// A keyframe of the replay in the editor (or, while those cannot be read, a free key).
+struct Row {
+    int number{};         // as `replayshake key <number>` takes it
+    double time{};        // seconds
+    bool own{};           // has a shake of its own; otherwise the default
+    Shake shake;          // its shake (or the default's)
+    Blend blend = Blend::smooth;
+    bool current{};       // the playhead is between it and the next
+    bool selected{};      // the replay editor's selected keyframe
+};
+// A camera on show, while probing: its vtable and its director's (offsets in Skate.exe, 0 unknown).
+struct SeenCamera {
+    std::uintptr_t vtable{}, director{};
+    bool operator==(const SeenCamera&) const = default;
+};
+struct View {
+    std::uint64_t revision{};
+    bool available{};       // the renderer's view hook is there
+    bool enabled{}, test{}, probe{};
+    bool gameplay{};        // the setting: gameplay shakes too
+    std::uint32_t toggle{}; // the controller combo (or key) that switches it on or off in the editor, 0 none
+    bool gameplay_held{};   // a replay camera is on show, but no game menu is: taken for gameplay, kept still
+    bool editor_open{};     // a replay camera is on show (in the replay editor)
+    bool shaking{};         // the shake is applied to the views being drawn
+    bool exporting{};
+    bool keyframe_mode{};   // rows are the editor's keyframes (else free keys)
+    std::optional<double> playhead;
+    std::string status;     // one line: what Replay Shake is doing
+    std::string next_step;  // one line: what setting up is missing, if anything
+    std::string mapping;    // the editor mapping, as `replayshake map show` says it
+    std::string editor_problem; // why the mapping read nothing, if it did not
+    std::vector<std::uintptr_t> cameras;   // replay cameras, as vtable offsets (of cameras or directors)
+    std::vector<SeenCamera> cameras_seen;  // the cameras on show now, while probing
+    std::uintptr_t every_camera{};         // the vtable every camera of the game has, gameplay's too
+    std::vector<std::uintptr_t> gameplay_directors; // directors gameplay's own camera selects
+    std::string menu_state;                // what the game's menu state says, while probing
+    Shake fallback;
+    std::uint32_t seed{};
+    int export_fps{};
+    std::vector<Row> rows;
+};
+// Never null.
+std::shared_ptr<const View> view() noexcept;
+void publish(std::shared_ptr<const View> next) noexcept;
+} // namespace dingosdk::replay_shake
diff --git a/Extension/ReplayShake/replay_shake_watch.cpp b/Extension/ReplayShake/replay_shake_watch.cpp
new file mode 100644
index 00000000..ff68ad98
--- /dev/null
+++ b/Extension/ReplayShake/replay_shake_watch.cpp
@@ -0,0 +1,780 @@
+#include "replay_shake_watch.h"
+#include "Engine/Core/Platform/memory.h"
+#include <Windows.h>
+#include <TlHelp32.h>
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <format>
+#include <utility>
+
+namespace dingosdk::replay_shake::watch {
+namespace {
+constexpr std::size_t hit_slots = 512;            // the (instruction, caller) pairs a window tells apart
+constexpr std::size_t event_slots = 1024;         // the window's sequence, from its start
+constexpr std::size_t events_logged = 240;
+constexpr std::size_t hits_logged = 24;           // for each place
+constexpr std::size_t caller_depth = 6;           // calls kept for each access
+constexpr std::size_t register_count = 16;        // rax, rcx, rdx, rbx, rsp, rbp, rsi, rdi, r8 to r15
+constexpr std::uint32_t most_accesses = 200000;   // the window closes early past these
+constexpr std::uint8_t other_thread = 4;          // the phase of an access on another thread than the engine's
+constexpr DWORD trap_flag = 0x100;                // EFlags: single-stepping
+constexpr DWORD debug_registers = 0x10;           // CONTEXT_DEBUG_REGISTERS without the architecture bit
+enum Window : std::uint8_t { idle, opening, open, closing, closed };
+
+// One instruction seen accessing a place, by way of the calls it came through: how often, which
+// places, where in the camera's update (a bit per phase), and its first thread (and whether others did
+// too). Keyed by the instruction and its first caller; the rest is written once by the thread that
+// claimed the entry (`ready` then).
+struct Hit {
+    std::atomic<std::uint64_t> key{};
+    std::atomic<bool> ready{}, threads{};
+    std::atomic<std::uint32_t> count{}, slots{}, phases{}, thread{};
+    std::uint64_t rip{};
+    std::array<std::uint64_t, caller_depth> callers{};
+    std::array<std::uint64_t, register_count> registers{}; // at its first access
+};
+struct Event {
+    std::atomic<bool> done{};
+    std::int64_t ticks{};
+    std::uint64_t rip{}, caller{}; // an access: the instruction after it and its first caller; a main view: its address
+    std::uint32_t thread{};
+    Mark what{};
+    std::uint8_t slots{}, phase{}, positions{}; // positions: a bit for each of `position` given
+    std::array<std::array<float, 3>, 3> position{};
+};
+struct State {
+    std::atomic<std::uint8_t> window{idle};
+    std::atomic<bool> ever_armed{};
+    std::array<std::atomic<std::uintptr_t>, slot_count> addresses{};
+    std::atomic<std::uint32_t> mask{}; // the slots of the window's
+    std::atomic<std::uint32_t> engine_thread{};
+    std::atomic<std::uint8_t> phase{};
+    std::array<Hit, hit_slots> hits;
+    std::array<Event, event_slots> events;
+    std::atomic<std::uint32_t> next_event{}, accesses{}, unplaced{}, unknown_slot{};
+    std::atomic<std::int64_t> opened_at{};
+    // Client thread (and the worker, while its window is open or closing).
+    std::array<std::string, slot_count> names;
+    std::array<bool, slot_count> writes{};
+    std::string context;
+    std::uint64_t dr7{};
+    unsigned window_ms{};
+    std::int64_t frequency{1};
+    unsigned armed{}, not_armed{}, disarmed{}, not_disarmed{};
+    bool closed_early{};
+    HANDLE worker{}, stop{};
+    PVOID handler{};
+};
+// Lives until the process ends: the handler and the worker can run at any time.
+State& state() {
+    static auto* value = new State;
+    return *value;
+}
+std::int64_t ticks_now() noexcept {
+    LARGE_INTEGER now{};
+    QueryPerformanceCounter(&now);
+    return now.QuadPart;
+}
+// A slot's bits in the debug control register: its local enable, and its kind and length.
+constexpr std::uint64_t slot_bits(std::size_t slot) noexcept { return (1ULL << (2 * slot)) | (0xfULL << (16 + 4 * slot)); }
+// Eight bytes, read or written (or written only).
+constexpr std::uint64_t slot_armed(std::size_t slot, bool writes) noexcept {
+    return (1ULL << (2 * slot)) | ((writes ? 1ULL : 3ULL) << (16 + 4 * slot)) | (2ULL << (18 + 4 * slot));
+}
+
+// The calls an access came through, innermost first, unwound from its own context by the images'
+// unwind data (an address without any is taken for a leaf). A frame that cannot be read ends it: never
+// faults out of here.
+void callers_of(const CONTEXT* at, std::uint64_t* out) noexcept {
+    __try {
+        CONTEXT context = *at;
+        for (std::size_t i = 0; i < caller_depth; ++i) {
+            DWORD64 image{};
+            const auto entry = RtlLookupFunctionEntry(context.Rip, &image, nullptr);
+            if (entry) {
+                PVOID data{};
+                DWORD64 frame{};
+                RtlVirtualUnwind(UNW_FLAG_NHANDLER, image, context.Rip, entry, &context, &data, &frame, nullptr);
+            } else {
+                context.Rip = *reinterpret_cast<const DWORD64*>(context.Rsp);
+                context.Rsp += 8;
+            }
+            if (context.Rip < 0x10000) return;
+            out[i] = context.Rip;
+        }
+    } __except (EXCEPTION_EXECUTE_HANDLER) {
+    }
+}
+void add_event(State& s, Mark what, std::uint64_t rip, std::uint64_t caller, std::uint32_t slots, std::uint8_t phase,
+    const float* first, const float* second, const float* third) noexcept {
+    const auto index = s.next_event.fetch_add(1, std::memory_order_relaxed);
+    if (index >= event_slots) return;
+    auto& event = s.events[index];
+    event.ticks = ticks_now();
+    event.rip = rip;
+    event.caller = caller;
+    event.thread = GetCurrentThreadId();
+    event.what = what;
+    event.slots = static_cast<std::uint8_t>(slots);
+    event.phase = phase;
+    event.positions = 0;
+    const std::array<const float*, 3> from{first, second, third};
+    for (std::size_t i = 0; i < from.size(); ++i)
+        if (from[i]) {
+            std::memcpy(event.position[i].data(), from[i], sizeof(event.position[i]));
+            event.positions = static_cast<std::uint8_t>(event.positions | (1U << i));
+        }
+    event.done.store(true, std::memory_order_release);
+}
+// In the handler, while the window is open: one access by the instruction before `rip`.
+void record(State& s, const CONTEXT& context, std::uint32_t fired) noexcept {
+    const auto rip = context.Rip;
+    std::array<std::uint64_t, caller_depth> callers{};
+    callers_of(&context, callers.data());
+    const auto thread = GetCurrentThreadId();
+    const std::uint8_t phase =
+        thread == s.engine_thread.load(std::memory_order_relaxed) ? s.phase.load(std::memory_order_relaxed) : other_thread;
+    const auto accesses = s.accesses.fetch_add(1, std::memory_order_relaxed) + 1;
+    auto key = rip ^ (callers[0] * 0x9e3779b97f4a7c15ULL);
+    if (!key) key = 1;
+    const auto start = static_cast<std::size_t>((key * 0x9e3779b97f4a7c15ULL) >> 40) % hit_slots;
+    bool counted = false;
+    for (std::size_t probe = 0; probe < hit_slots && !counted; ++probe) {
+        auto& hit = s.hits[(start + probe) % hit_slots];
+        auto found = hit.key.load(std::memory_order_acquire);
+        if (!found && hit.key.compare_exchange_strong(found, key, std::memory_order_acq_rel)) {
+            hit.rip = rip;
+            hit.callers = callers;
+            hit.registers = {context.Rax, context.Rcx, context.Rdx, context.Rbx, context.Rsp, context.Rbp, context.Rsi,
+                context.Rdi, context.R8, context.R9, context.R10, context.R11, context.R12, context.R13, context.R14, context.R15};
+            hit.thread.store(thread, std::memory_order_relaxed);
+            hit.ready.store(true, std::memory_order_release);
+            found = key;
+        }
+        if (found != key) continue;
+        hit.count.fetch_add(1, std::memory_order_relaxed);
+        hit.slots.fetch_or(fired, std::memory_order_relaxed);
+        hit.phases.fetch_or(1U << phase, std::memory_order_relaxed);
+        const auto first = hit.thread.load(std::memory_order_relaxed);
+        if (first && first != thread) hit.threads.store(true, std::memory_order_relaxed);
+        counted = true;
+    }
+    if (!counted) s.unplaced.fetch_add(1, std::memory_order_relaxed);
+    add_event(s, Mark::access, rip, callers[0], fired, phase, nullptr, nullptr, nullptr);
+    if (accesses == most_accesses && s.stop) SetEvent(s.stop);
+}
+// A data breakpoint's trap, once a window has ever been armed (nothing else in the game sets one; a
+// thread that could not be disarmed keeps trapping, and is let go on each time): counted while the
+// window is open, and the thread goes on. Told by the debug status register's breakpoint bits; should
+// the exception not carry the debug registers, any trap that is not single-stepping while the window's
+// breakpoints are on. Anything else is left to whoever handles it.
+LONG CALLBACK on_exception(EXCEPTION_POINTERS* pointers) {
+    if (!pointers || !pointers->ExceptionRecord || !pointers->ContextRecord ||
+        pointers->ExceptionRecord->ExceptionCode != EXCEPTION_SINGLE_STEP)
+        return EXCEPTION_CONTINUE_SEARCH;
+    auto& s = state();
+    auto& context = *pointers->ContextRecord;
+    if (!s.ever_armed.load(std::memory_order_acquire) || (context.EFlags & trap_flag)) return EXCEPTION_CONTINUE_SEARCH;
+    const bool status = (context.ContextFlags & debug_registers) == debug_registers;
+    const auto window = s.window.load(std::memory_order_acquire);
+    const auto breakpoints = status ? static_cast<std::uint32_t>(context.Dr6 & 0xf) : 0U;
+    if (status ? !breakpoints : window != open && window != closing) return EXCEPTION_CONTINUE_SEARCH;
+    if (window == open) {
+        const auto fired = breakpoints & s.mask.load(std::memory_order_acquire);
+        if (!fired) s.unknown_slot.fetch_add(1, std::memory_order_relaxed);
+        record(s, context, fired);
+    }
+    if (status) context.Dr6 = 0;
+    return EXCEPTION_CONTINUE_EXECUTION;
+}
+
+// The game's threads but the worker. Allocates: before any thread is suspended.
+std::vector<DWORD> game_threads(DWORD self) {
+    std::vector<DWORD> threads;
+    const HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    if (snapshot == INVALID_HANDLE_VALUE) return threads;
+    const auto process = GetCurrentProcessId();
+    THREADENTRY32 entry{};
+    entry.dwSize = sizeof(entry);
+    for (BOOL more = Thread32First(snapshot, &entry); more; more = Thread32Next(snapshot, &entry)) {
+        if (entry.th32OwnerProcessID == process && entry.th32ThreadID != self) threads.push_back(entry.th32ThreadID);
+        entry.dwSize = sizeof(entry);
+    }
+    CloseHandle(snapshot);
+    return threads;
+}
+// Each thread's debug registers armed with the window's places (`arm`), or cleared of them (others'
+// left as they are). A thread is suspended only while its own are set, and nothing is allocated meanwhile.
+void set_registers(const std::vector<DWORD>& threads, const State& s, bool arm, unsigned& done, unsigned& failed) noexcept {
+    std::array<std::uintptr_t, slot_count> at{};
+    for (std::size_t slot = 0; slot < slot_count; ++slot) at[slot] = s.addresses[slot].load(std::memory_order_acquire);
+    for (const auto id : threads) {
+        const HANDLE thread = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_SET_CONTEXT, FALSE, id);
+        if (!thread) {
+            ++failed;
+            continue;
+        }
+        bool ok = false;
+        if (SuspendThread(thread) != static_cast<DWORD>(-1)) {
+            alignas(16) CONTEXT context{};
+            context.ContextFlags = CONTEXT_DEBUG_REGISTERS;
+            if (GetThreadContext(thread, &context)) {
+                const std::array<DWORD64*, slot_count> registers{&context.Dr0, &context.Dr1, &context.Dr2, &context.Dr3};
+                if (arm) {
+                    for (std::size_t slot = 0; slot < slot_count; ++slot) *registers[slot] = at[slot];
+                    context.Dr7 = s.dr7;
+                } else {
+                    for (std::size_t slot = 0; slot < slot_count; ++slot)
+                        if (at[slot] && *registers[slot] == at[slot]) {
+                            *registers[slot] = 0;
+                            context.Dr7 &= ~slot_bits(slot);
+                        }
+                }
+                context.Dr6 = 0;
+                ok = SetThreadContext(thread, &context) != FALSE;
+            }
+            ResumeThread(thread);
+        }
+        CloseHandle(thread);
+        ++(ok ? done : failed);
+    }
+}
+// The worker: arms every thread, keeps the window open for its time (or until too many accesses), then
+// disarms every thread (those started meanwhile never had them).
+DWORD WINAPI run_window(LPVOID) {
+    auto& s = state();
+    try {
+        const auto self = GetCurrentThreadId();
+        auto threads = game_threads(self);
+        set_registers(threads, s, true, s.armed, s.not_armed);
+        s.opened_at.store(ticks_now(), std::memory_order_release);
+        s.window.store(open, std::memory_order_release);
+        s.closed_early = WaitForSingleObject(s.stop, s.window_ms) == WAIT_OBJECT_0;
+        s.window.store(closing, std::memory_order_release);
+        threads = game_threads(self);
+        set_registers(threads, s, false, s.disarmed, s.not_disarmed);
+    } catch (...) { /* What could not be done is counted as not done. */ }
+    s.window.store(closed, std::memory_order_release);
+    return 0;
+}
+
+// Module and offset of an address, for the reports.
+class Modules {
+public:
+    explicit Modules(std::uintptr_t image_base) : image_base_(image_base) {}
+    std::string where(std::uint64_t address) {
+        HMODULE module{};
+        if (!address || !GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                reinterpret_cast<LPCWSTR>(address), &module) || !module)
+            return std::format("0x{:x}", address);
+        const auto base = reinterpret_cast<std::uintptr_t>(module);
+        return std::format("{}+0x{:x}", name(module, base), address - base);
+    }
+
+private:
+    std::string name(HMODULE module, std::uintptr_t base) {
+        if (base == image_base_) return "Skate.exe";
+        for (const auto& [at, known] : names_)
+            if (at == base) return known;
+        std::array<wchar_t, MAX_PATH> path{};
+        const auto length = GetModuleFileNameW(module, path.data(), static_cast<DWORD>(path.size()));
+        std::size_t start = 0;
+        for (std::size_t i = 0; i < length; ++i)
+            if (path[i] == L'\\' || path[i] == L'/') start = i + 1;
+        std::string text;
+        for (std::size_t i = start; i < length; ++i) text += path[i] > 0 && path[i] < 128 ? static_cast<char>(path[i]) : '?';
+        if (text.empty()) text = std::format("0x{:x}", base);
+        names_.emplace_back(base, text);
+        return text;
+    }
+    std::uintptr_t image_base_;
+    std::vector<std::pair<std::uintptr_t, std::string>> names_;
+};
+std::string phases_text(std::uint32_t phases) {
+    constexpr std::array<const char*, 5> names{"outside the camera's update", "in its update before the camera is set",
+        "right after it is set", "as the update hands on", "another thread"};
+    std::string text;
+    for (std::size_t i = 0; i < names.size(); ++i)
+        if (phases & (1U << i)) text += std::format("{}{}", text.empty() ? "" : ", ", names[i]);
+    return text;
+}
+std::string slots_text(std::uint32_t slots) {
+    std::string text;
+    for (std::size_t slot = 0; slot < slot_count; ++slot)
+        if (slots & (1U << slot)) text += std::format("{}{}", text.empty() ? "" : ",", slot + 1);
+    return text.empty() ? std::string("?") : text;
+}
+std::string position_text(const std::array<float, 3>& at) { return std::format("({:.4f}, {:.4f}, {:.4f})", at[0], at[1], at[2]); }
+std::string event_text(const Event& event, Modules& modules) {
+    const auto at = [&](std::size_t i) {
+        return (event.positions & (1U << i)) ? position_text(event.position[i]) : std::string("(unread)");
+    };
+    switch (event.what) {
+    case Mark::access:
+        return std::format("[{}] after {} (from {})", slots_text(event.slots), modules.where(event.rip), modules.where(event.caller));
+    case Mark::update_start: return "the camera's update starts";
+    case Mark::camera_set:
+        return std::format("the camera set: as the game set it {}, shaken {}, the blend {}", at(0), at(1), at(2));
+    case Mark::handing: return "the update hands on";
+    case Mark::update_end: return "the camera's update ends";
+    case Mark::main_view: return std::format("the main view 0x{:x} set up at {}", event.rip, at(0));
+    }
+    return "?";
+}
+
+// The search for copies of a camera (find()).
+enum Search : std::uint8_t { search_idle, search_running, search_done };
+constexpr std::size_t page_size = 0x1000;
+constexpr std::size_t batch_pages = 256;          // read and asked about together (1 MB)
+constexpr std::size_t most_copies = 256;          // of each kind
+constexpr std::size_t copies_logged = 48;         // of each kind
+constexpr std::uint64_t search_limit_ms = 20000;
+constexpr std::uintptr_t owner_reach = 0x1000;    // how far before a copy its object's vtable is looked for
+// What the working set query says of a page: bit 0, in RAM (PSAPI_WORKING_SET_EX_INFORMATION).
+struct PageInfo {
+    void* address;
+    std::uintptr_t attributes;
+};
+using QueryWorkingSet = BOOL(WINAPI*)(HANDLE, PVOID, DWORD);
+struct Finder {
+    std::atomic<std::uint8_t> search{search_idle};
+    std::array<float, 16> camera{};
+    std::vector<std::pair<std::uintptr_t, std::uintptr_t>> own;
+    std::uintptr_t image_base{}, image_end{}, code_begin{}, code_end{};
+    std::string context;
+    std::vector<Copy> whole, positions;
+    std::uint64_t read_bytes{}, paged_out{}, unreadable{}, stacks{};
+    std::uint32_t regions{};
+    std::uint64_t took_ms{};
+    bool timed_out{}, no_query{};
+    HANDLE worker{};
+};
+Finder& finder() {
+    static auto* value = new Finder;
+    return *value;
+}
+bool own_address(const Finder& f, std::uintptr_t at) noexcept {
+    for (const auto& [begin, end] : f.own)
+        if (at >= begin && at < end) return true;
+    return false;
+}
+// Memory worth reading: committed, readable without side effects (no guard pages, nothing uncached or
+// write-combined, as a graphics driver maps its buffers), not code.
+bool searchable(const MEMORY_BASIC_INFORMATION& info) noexcept {
+    if (info.State != MEM_COMMIT || (info.Protect & (PAGE_GUARD | PAGE_NOCACHE | PAGE_WRITECOMBINE))) return false;
+    switch (info.Protect & 0xff) {
+    case PAGE_READWRITE: case PAGE_WRITECOPY: return true;
+    case PAGE_READONLY: return info.Type != MEM_IMAGE;
+    default: return false;
+    }
+}
+void scan(Finder& f, std::uintptr_t from, const std::byte* data, std::size_t bytes) noexcept {
+    std::uint32_t first{}, position{};
+    std::memcpy(&first, f.camera.data(), sizeof(first));
+    std::memcpy(&position, f.camera.data() + 12, sizeof(position));
+    for (std::size_t offset = 0; offset + 3 * sizeof(float) <= bytes; offset += sizeof(float)) {
+        std::uint32_t word{};
+        std::memcpy(&word, data + offset, sizeof(word));
+        if (word == first && offset + sizeof(f.camera) <= bytes &&
+            std::memcmp(data + offset, f.camera.data(), sizeof(f.camera)) == 0) {
+            if (!own_address(f, from + offset) && f.whole.size() < most_copies) f.whole.push_back({from + offset, true});
+        } else if (word == position && std::memcmp(data + offset, f.camera.data() + 12, 3 * sizeof(float)) == 0) {
+            // A position alone: not the position row of a whole copy found.
+            const bool in_whole = offset >= 48 && std::memcmp(data + offset - 48, f.camera.data(), 48) == 0;
+            if (!in_whole && !own_address(f, from + offset) && f.positions.size() < most_copies)
+                f.positions.push_back({from + offset, false});
+        }
+    }
+}
+// One region, a batch of pages at a time: only the pages in RAM, read by runs.
+void search_region(Finder& f, std::uintptr_t begin, std::uintptr_t end, QueryWorkingSet query, std::vector<PageInfo>& pages,
+    std::vector<std::byte>& buffer) noexcept {
+    const auto process = GetCurrentProcess();
+    for (std::uintptr_t batch = begin; batch < end; batch += batch_pages * page_size) {
+        const auto count = std::min<std::size_t>(batch_pages, (end - batch) / page_size);
+        if (!count) break;
+        for (std::size_t i = 0; i < count; ++i) pages[i] = {reinterpret_cast<void*>(batch + i * page_size), 0};
+        if (!query(process, pages.data(), static_cast<DWORD>(count * sizeof(PageInfo)))) {
+            f.paged_out += count * page_size;
+            continue;
+        }
+        for (std::size_t i = 0; i < count;) {
+            if (!(pages[i].attributes & 1)) {
+                f.paged_out += page_size;
+                ++i;
+                continue;
+            }
+            std::size_t j = i;
+            while (j < count && (pages[j].attributes & 1)) ++j;
+            const auto from = batch + i * page_size;
+            const auto bytes = (j - i) * page_size;
+            if (memory::peek_bytes(from, buffer.data(), bytes)) {
+                scan(f, from, buffer.data(), bytes);
+                f.read_bytes += bytes;
+            } else {
+                for (std::size_t k = i; k < j; ++k) {
+                    const auto page = batch + k * page_size;
+                    if (memory::peek_bytes(page, buffer.data(), page_size)) {
+                        scan(f, page, buffer.data(), page_size);
+                        f.read_bytes += page_size;
+                    } else {
+                        f.unreadable += page_size;
+                    }
+                }
+            }
+            i = j;
+        }
+    }
+}
+// The object a copy seems to be in: the nearest pointer before it to a vtable of Skate.exe's (a pointer
+// into the image whose first entry points into its code).
+void place(const Finder& f, Copy& copy) noexcept {
+    const auto start = copy.at & ~static_cast<std::uintptr_t>(7);
+    for (std::uintptr_t back = 0; back <= owner_reach && back <= start; back += 8) {
+        std::uintptr_t pointer{}, first{};
+        if (!memory::peek(start - back, pointer)) return;
+        if (pointer < f.image_base || pointer >= f.image_end || (pointer & 7)) continue;
+        if (!memory::peek(pointer, first) || first < f.code_begin || first >= f.code_end) continue;
+        copy.object = start - back;
+        copy.vtable = pointer - f.image_base;
+        return;
+    }
+}
+// Skate.exe's extent and code, from its headers in memory.
+void image_extent(Finder& f) noexcept {
+    f.image_end = f.code_begin = f.code_end = 0;
+    IMAGE_DOS_HEADER dos{};
+    IMAGE_NT_HEADERS64 nt{};
+    if (!memory::peek(f.image_base, dos) || dos.e_magic != IMAGE_DOS_SIGNATURE ||
+        !memory::peek(f.image_base + static_cast<std::uintptr_t>(dos.e_lfanew), nt) || nt.Signature != IMAGE_NT_SIGNATURE)
+        return;
+    f.image_end = f.image_base + nt.OptionalHeader.SizeOfImage;
+    f.code_begin = f.image_base + nt.OptionalHeader.BaseOfCode;
+    f.code_end = f.code_begin + nt.OptionalHeader.SizeOfCode;
+}
+DWORD WINAPI run_search(LPVOID) {
+    auto& f = finder();
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    const auto started = GetTickCount64();
+    try {
+        const auto query = reinterpret_cast<QueryWorkingSet>(
+            reinterpret_cast<void*>(GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "K32QueryWorkingSetEx")));
+        if (!query) {
+            f.no_query = true; // without it, what is paged out would be paged in: nothing is read
+        } else {
+            image_extent(f);
+            std::vector<std::byte> buffer(batch_pages * page_size);
+            std::vector<PageInfo> pages(batch_pages);
+            f.own.emplace_back(reinterpret_cast<std::uintptr_t>(buffer.data()), reinterpret_cast<std::uintptr_t>(buffer.data()) + buffer.size());
+            f.own.emplace_back(reinterpret_cast<std::uintptr_t>(&f), reinterpret_cast<std::uintptr_t>(&f) + sizeof(f));
+            // Threads' stacks are left out: a reservation with a guard page in it (the guard sits below
+            // the committed stack, so it comes first as the regions are walked up). What they hold is
+            // what some function had in hand, not where the game keeps it.
+            std::uintptr_t stack{};
+            std::uintptr_t at = 0x10000;
+            while (at < memory::highest_user_address) {
+                MEMORY_BASIC_INFORMATION info{};
+                if (!VirtualQuery(reinterpret_cast<LPCVOID>(at), &info, sizeof(info))) break;
+                const auto begin = reinterpret_cast<std::uintptr_t>(info.BaseAddress);
+                const auto end = begin + info.RegionSize;
+                if (end <= at) break;
+                const auto reservation = reinterpret_cast<std::uintptr_t>(info.AllocationBase);
+                if (info.State == MEM_COMMIT && (info.Protect & PAGE_GUARD)) stack = reservation;
+                if (reservation && reservation == stack) {
+                    if (info.State == MEM_COMMIT) f.stacks += info.RegionSize;
+                } else if (searchable(info)) {
+                    ++f.regions;
+                    search_region(f, std::max(begin, at), end, query, pages, buffer);
+                }
+                at = end;
+                if (GetTickCount64() - started > search_limit_ms) {
+                    f.timed_out = true;
+                    break;
+                }
+            }
+            for (auto& copy : f.whole) place(f, copy);
+            for (auto& copy : f.positions) place(f, copy);
+        }
+    } catch (...) { /* What was found so far. */ }
+    f.took_ms = GetTickCount64() - started;
+    f.search.store(search_done, std::memory_order_release);
+    return 0;
+}
+} // namespace
+
+bool arm(const std::array<Spot, slot_count>& spots, unsigned window_ms, std::uint32_t engine_thread, std::string context) noexcept {
+    auto& s = state();
+    auto expected = static_cast<std::uint8_t>(idle);
+    if (!s.window.compare_exchange_strong(expected, static_cast<std::uint8_t>(opening), std::memory_order_acq_rel)) return false;
+    const auto give_up = [&s] {
+        s.window.store(idle, std::memory_order_release);
+        return false;
+    };
+    try {
+        // The last window's worker is done (its window was reported): let it go.
+        if (s.worker) {
+            if (WaitForSingleObject(s.worker, 1000) != WAIT_OBJECT_0) return give_up();
+            CloseHandle(s.worker);
+            s.worker = nullptr;
+        }
+        std::uint32_t mask = 0;
+        std::uint64_t dr7 = 0;
+        for (std::size_t slot = 0; slot < slot_count; ++slot) {
+            const auto address = spots[slot].address;
+            const bool usable = address && !(address & 7);
+            s.addresses[slot].store(usable ? address : 0, std::memory_order_release);
+            s.names[slot] = usable ? spots[slot].name : std::string();
+            s.writes[slot] = usable && spots[slot].writes;
+            if (!usable) continue;
+            mask |= 1U << slot;
+            dr7 |= slot_armed(slot, spots[slot].writes);
+        }
+        if (!mask) return give_up();
+        for (auto& hit : s.hits) {
+            hit.key.store(0, std::memory_order_relaxed);
+            hit.ready.store(false, std::memory_order_relaxed);
+            hit.threads.store(false, std::memory_order_relaxed);
+            hit.count.store(0, std::memory_order_relaxed);
+            hit.slots.store(0, std::memory_order_relaxed);
+            hit.phases.store(0, std::memory_order_relaxed);
+            hit.thread.store(0, std::memory_order_relaxed);
+        }
+        for (auto& event : s.events) event.done.store(false, std::memory_order_relaxed);
+        s.next_event.store(0, std::memory_order_relaxed);
+        s.accesses.store(0, std::memory_order_relaxed);
+        s.unplaced.store(0, std::memory_order_relaxed);
+        s.unknown_slot.store(0, std::memory_order_relaxed);
+        s.armed = s.not_armed = s.disarmed = s.not_disarmed = 0;
+        s.closed_early = false;
+        s.context = std::move(context);
+        s.dr7 = dr7;
+        s.window_ms = window_ms;
+        LARGE_INTEGER frequency{};
+        QueryPerformanceFrequency(&frequency);
+        s.frequency = std::max<std::int64_t>(frequency.QuadPart, 1);
+        s.mask.store(mask, std::memory_order_release);
+        s.engine_thread.store(engine_thread, std::memory_order_release);
+        if (!s.stop) s.stop = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+        else ResetEvent(s.stop);
+        if (!s.handler) s.handler = AddVectoredExceptionHandler(1, &on_exception);
+        if (!s.stop || !s.handler) return give_up();
+        s.ever_armed.store(true, std::memory_order_release);
+        s.worker = CreateThread(nullptr, 0, &run_window, nullptr, 0, nullptr);
+        if (!s.worker) return give_up();
+        return true;
+    } catch (...) {
+        return give_up();
+    }
+}
+
+void mark(Mark what, const float* first, const float* second, const float* third, std::uintptr_t at) noexcept {
+    auto& s = state();
+    if (what != Mark::access && what != Mark::main_view && GetCurrentThreadId() == s.engine_thread.load(std::memory_order_relaxed)) {
+        std::uint8_t phase = 0;
+        switch (what) {
+        case Mark::update_start: phase = 1; break;
+        case Mark::camera_set: phase = 2; break;
+        case Mark::handing: phase = 3; break;
+        default: break;
+        }
+        s.phase.store(phase, std::memory_order_relaxed);
+    }
+    if (s.window.load(std::memory_order_acquire) != open) return;
+    add_event(s, what, at, 0, 0, s.phase.load(std::memory_order_relaxed), first, second, third);
+}
+
+bool busy() noexcept { return state().window.load(std::memory_order_acquire) != idle; }
+
+std::vector<std::string> report(std::uintptr_t image_base, std::vector<Write>* writes) {
+    auto& s = state();
+    if (s.window.load(std::memory_order_acquire) != closed) return {};
+    if (writes) writes->clear();
+    std::vector<std::string> lines;
+    try {
+        Modules modules(image_base);
+        const auto accesses = s.accesses.load(std::memory_order_acquire);
+        const auto unknown = s.unknown_slot.load(std::memory_order_acquire);
+        const auto unplaced = s.unplaced.load(std::memory_order_acquire);
+        lines.push_back(std::format(
+            "Replay Shake probe (watch, {} ms{}; {}): {} thread(s) armed{}, {} disarmed{}; {} access(es) caught{}{}. What read or "
+            "wrote each place (the instruction after each access, and the calls it came through):",
+            s.window_ms, s.closed_early ? ", closed early" : "", s.context, s.armed,
+            s.not_armed ? std::format(" ({} not)", s.not_armed) : std::string(), s.disarmed,
+            s.not_disarmed ? std::format(" ({} not)", s.not_disarmed) : std::string(), accesses,
+            unknown ? std::format(" ({} of no place told)", unknown) : std::string(),
+            unplaced ? std::format(" ({} by instructions past the {} told apart)", unplaced, hit_slots) : std::string()));
+        struct Row {
+            std::uint64_t rip;
+            std::array<std::uint64_t, caller_depth> callers;
+            std::array<std::uint64_t, register_count> registers;
+            std::uint32_t count, slots, phases, thread;
+            bool threads;
+        };
+        std::vector<Row> rows;
+        for (const auto& hit : s.hits)
+            if (hit.key.load(std::memory_order_acquire) && hit.ready.load(std::memory_order_acquire))
+                rows.push_back({hit.rip, hit.callers, hit.registers, hit.count.load(std::memory_order_relaxed),
+                    hit.slots.load(std::memory_order_relaxed), hit.phases.load(std::memory_order_relaxed),
+                    hit.thread.load(std::memory_order_relaxed), hit.threads.load(std::memory_order_relaxed)});
+        std::sort(rows.begin(), rows.end(), [](const Row& a, const Row& b) { return a.count > b.count; });
+        const auto engine = s.engine_thread.load(std::memory_order_acquire);
+        const auto thread_text = [engine](const Row& row) {
+            return std::format("{}{}", row.thread == engine ? std::string("the engine thread") : std::format("thread {}", row.thread),
+                row.threads ? " and others" : "");
+        };
+        const auto callers_text = [&modules](const Row& row) {
+            std::string text;
+            for (const auto caller : row.callers)
+                if (caller) text += std::format(" < {}", modules.where(caller));
+            return text;
+        };
+        // For a write, the registers at its first (what it copied from is often in one).
+        const auto registers_text = [](const Row& row) {
+            constexpr std::array<const char*, register_count> names{
+                "rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"};
+            std::string text;
+            for (std::size_t i = 0; i < register_count; ++i)
+                if (i != 4) text += std::format("{}{} 0x{:x}", text.empty() ? " [" : ", ", names[i], row.registers[i]);
+            return text + "]";
+        };
+        for (std::size_t slot = 0; slot <= slot_count; ++slot) {
+            // The slots, then any access no slot was told for.
+            const bool told = slot < slot_count;
+            if (told && !s.addresses[slot].load(std::memory_order_acquire)) continue;
+            std::string text;
+            std::size_t shown = 0, more = 0;
+            for (const auto& row : rows) {
+                if (told ? !(row.slots & (1U << slot)) : row.slots != 0) continue;
+                if (shown == hits_logged) {
+                    ++more;
+                    continue;
+                }
+                const bool written = told && s.writes[slot];
+                text += std::format("{} {}{} {}x ({}; {}){}", shown ? "," : "", modules.where(row.rip), callers_text(row), row.count,
+                    thread_text(row), phases_text(row.phases), written ? registers_text(row) : std::string());
+                if (written && writes)
+                    writes->push_back({row.rip, row.registers[1], row.registers[2], s.addresses[slot].load(std::memory_order_acquire),
+                        row.count});
+                ++shown;
+            }
+            if (more) text += std::format(", and {} more", more);
+            if (told)
+                lines.push_back(std::format("Replay Shake probe (watch): [{}] {} at 0x{:x}{}:{}", slot + 1, s.names[slot],
+                    s.addresses[slot].load(std::memory_order_acquire), s.writes[slot] ? " (writes only)" : "",
+                    text.empty() ? std::string(" nothing") : text));
+            else if (!text.empty())
+                lines.push_back(std::format("Replay Shake probe (watch): [?] accesses of no place told:{}", text));
+        }
+        const auto count = std::min<std::size_t>(s.next_event.load(std::memory_order_acquire), event_slots);
+        const auto opened = s.opened_at.load(std::memory_order_acquire);
+        std::size_t logged = 0;
+        for (std::size_t i = 0; i < count && logged < events_logged; ++i) {
+            const auto& event = s.events[i];
+            if (!event.done.load(std::memory_order_acquire)) continue;
+            if (!logged)
+                lines.push_back(std::format("Replay Shake probe (watch): the window in order, from its start ({} of {} kept):",
+                    std::min(count, events_logged), s.next_event.load(std::memory_order_acquire)));
+            const double ms = static_cast<double>(event.ticks - opened) * 1000.0 / static_cast<double>(s.frequency);
+            lines.push_back(std::format("   {:+.3f} ms {}: {}", ms,
+                event.thread == engine ? std::string("engine") : std::format("t{}", event.thread), event_text(event, modules)));
+            ++logged;
+        }
+    } catch (...) { /* What was made so far. */ }
+    s.window.store(idle, std::memory_order_release);
+    return lines;
+}
+
+bool find(const std::array<float, 16>& camera, std::vector<std::pair<std::uintptr_t, std::uintptr_t>> own,
+    std::uintptr_t image_base, std::string context) noexcept {
+    auto& f = finder();
+    auto expected = static_cast<std::uint8_t>(search_idle);
+    if (!f.search.compare_exchange_strong(expected, static_cast<std::uint8_t>(search_running), std::memory_order_acq_rel)) return false;
+    try {
+        if (f.worker) {
+            if (WaitForSingleObject(f.worker, 1000) != WAIT_OBJECT_0) {
+                f.search.store(search_idle, std::memory_order_release);
+                return false;
+            }
+            CloseHandle(f.worker);
+            f.worker = nullptr;
+        }
+        f.camera = camera;
+        f.own = std::move(own);
+        f.image_base = image_base;
+        f.context = std::move(context);
+        f.whole.clear();
+        f.positions.clear();
+        f.whole.reserve(most_copies);
+        f.positions.reserve(most_copies);
+        f.read_bytes = f.paged_out = f.unreadable = f.stacks = 0;
+        f.regions = 0;
+        f.took_ms = 0;
+        f.timed_out = f.no_query = false;
+        f.worker = CreateThread(nullptr, 0, &run_search, nullptr, 0, nullptr);
+        if (!f.worker) {
+            f.search.store(search_idle, std::memory_order_release);
+            return false;
+        }
+        return true;
+    } catch (...) {
+        f.search.store(search_idle, std::memory_order_release);
+        return false;
+    }
+}
+
+std::vector<std::string> found(std::uintptr_t image_base, std::vector<Copy>& copies) {
+    auto& f = finder();
+    if (f.search.load(std::memory_order_acquire) != search_done) return {};
+    std::vector<std::string> lines;
+    try {
+        Modules modules(image_base);
+        const auto copy_text = [&modules](const Copy& copy) {
+            MEMORY_BASIC_INFORMATION info{};
+            std::string region;
+            if (VirtualQuery(reinterpret_cast<LPCVOID>(copy.at), &info, sizeof(info)))
+                region = std::format("{} region 0x{:x} of {} KB",
+                    info.Type == MEM_IMAGE ? std::string("image ") + modules.where(copy.at)
+                                           : info.Type == MEM_MAPPED ? std::string("mapped") : std::string("private"),
+                    reinterpret_cast<std::uintptr_t>(info.BaseAddress), info.RegionSize / 1024);
+            return std::format(" 0x{:x} ({}{})", copy.at,
+                copy.object ? std::format("in an object at 0x{:x}, vtable Skate.exe+0x{:x}, at its +0x{:x}; ", copy.object, copy.vtable,
+                                  copy.at - copy.object)
+                            : std::string(),
+                region);
+        };
+        lines.push_back(std::format(
+            "Replay Shake probe (find; {}): read {} MB of the game's memory in RAM ({} regions; {} MB paged out, {} MB "
+            "unreadable and {} MB of threads' stacks left) in {} ms{}{}. The camera ({:.4f}, {:.4f}, {:.4f}) whole, {} cop(ies):",
+            f.context, f.read_bytes >> 20, f.regions, f.paged_out >> 20, f.unreadable >> 20, f.stacks >> 20, f.took_ms,
+            f.timed_out ? " (stopped at its time limit)" : "", f.no_query ? " (nothing read: the working set cannot be asked)" : "",
+            f.camera[12], f.camera[13], f.camera[14], f.whole.size()));
+        // Those in an object of the game's first, then the rest, a few to a line.
+        const auto list = [&](std::vector<Copy> kind) {
+            std::stable_sort(kind.begin(), kind.end(), [](const Copy& a, const Copy& b) { return a.object && !b.object; });
+            std::string text;
+            const auto shown = std::min(kind.size(), copies_logged);
+            for (std::size_t i = 0; i < shown; ++i) {
+                text += copy_text(kind[i]);
+                if ((i + 1) % 8 == 0 || i + 1 == shown) {
+                    lines.push_back("Replay Shake probe (find):" + text);
+                    text.clear();
+                }
+            }
+            if (kind.size() > shown) lines.push_back(std::format("Replay Shake probe (find): and {} more", kind.size() - shown));
+        };
+        list(f.whole);
+        lines.push_back(std::format("Replay Shake probe (find): its position alone, {} cop(ies):", f.positions.size()));
+        list(f.positions);
+        copies = f.whole;
+        copies.insert(copies.end(), f.positions.begin(), f.positions.end());
+    } catch (...) { /* What was made so far. */ }
+    f.search.store(search_idle, std::memory_order_release);
+    return lines;
+}
+
+std::pair<std::uintptr_t, std::uintptr_t> own_memory() noexcept {
+    const auto at = reinterpret_cast<std::uintptr_t>(&state());
+    return {at, at + sizeof(State)};
+}
+} // namespace dingosdk::replay_shake::watch
diff --git a/Extension/ReplayShake/replay_shake_watch.h b/Extension/ReplayShake/replay_shake_watch.h
new file mode 100644
index 00000000..e556dc76
--- /dev/null
+++ b/Extension/ReplayShake/replay_shake_watch.h
@@ -0,0 +1,69 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+// `replayshake probe`: which of the game's code reads (or writes) a few places, found with the
+// processor's data breakpoints; and where in the game's memory copies of a camera are. Diagnostic only:
+// nothing the game does changes.
+//
+// A watch window arms the breakpoints in every thread of the game for a moment (a worker thread
+// suspends each thread in turn to set its debug registers), a vectored exception handler counts each
+// access (the instruction after it, the calls it came through, the thread, and where in the camera's
+// update it came), and the window disarms them again. The accesses watched are only slower meanwhile.
+//
+// A search reads the game's memory that is in RAM (never what is paged out), on a worker thread of low
+// priority, for copies of a camera: the whole transform, or its position alone.
+namespace dingosdk::replay_shake::watch {
+inline constexpr std::size_t slot_count = 4;
+// Eight bytes to watch (aligned to 8; 0 for none), what to call them, and whether writes alone count.
+struct Spot {
+    std::uintptr_t address{};
+    std::string name;
+    bool writes{};
+};
+// What happened besides the accesses, in the window's sequence: the camera's update (on the engine
+// thread) and the renderer's set-ups of its main view, each with up to three positions.
+enum class Mark : std::uint8_t { access, update_start, camera_set, handing, update_end, main_view };
+// Client thread: opens a window of `window_ms` on these spots, `engine_thread` updating the camera, and
+// `context` said with what it found. False while another window is open or not yet reported, or when
+// nothing could be watched.
+bool arm(const std::array<Spot, slot_count>& spots, unsigned window_ms, std::uint32_t engine_thread, std::string context) noexcept;
+// Any thread: one mark, kept while a window is open (the camera's update marks also say where in it the
+// engine thread is, for its accesses); `at`, an address to say with it (the main view's).
+void mark(Mark what, const float* first = nullptr, const float* second = nullptr, const float* third = nullptr,
+    std::uintptr_t at = 0) noexcept;
+// Whether a window is open, or closed and not yet reported.
+bool busy() noexcept;
+// A write a window caught (on a place watched for writes only): the instruction after it, rcx and rdx
+// at its first (a copy's destination and source, as the game's copies take them), the place, and how
+// often.
+struct Write {
+    std::uint64_t rip{}, rcx{}, rdx{};
+    std::uintptr_t place{};
+    std::uint32_t count{};
+};
+// Client thread: once a window has closed, what it found (lines to log), and the window is free again;
+// empty until then. `writes`, when given, gets the writes caught.
+std::vector<std::string> report(std::uintptr_t image_base, std::vector<Write>* writes = nullptr);
+
+// A copy of the camera found: where, whether the whole transform or its position alone, and the object
+// it seems to be in (the nearest vtable of Skate.exe's before it, within 4 KB; 0 none).
+struct Copy {
+    std::uintptr_t at{};
+    bool whole{};
+    std::uintptr_t object{}, vtable{}; // vtable: an offset in Skate.exe
+};
+// Client thread: starts a search for copies of `camera` (a transform: rows right, up, back, position),
+// leaving out the ranges in `own` ([begin, end): what Replay Shake keeps itself). False while another
+// search runs or waits to be reported.
+bool find(const std::array<float, 16>& camera, std::vector<std::pair<std::uintptr_t, std::uintptr_t>> own,
+    std::uintptr_t image_base, std::string context) noexcept;
+// Client thread: once the search has ended, what it found (lines to log) and the copies; empty lines
+// until then.
+std::vector<std::string> found(std::uintptr_t image_base, std::vector<Copy>& copies);
+// The range the watch keeps its own records in (its marks hold positions), for a search to leave out.
+std::pair<std::uintptr_t, std::uintptr_t> own_memory() noexcept;
+} // namespace dingosdk::replay_shake::watch
diff --git a/Extension/ReplayShake/tools/ui_dump_diff.py b/Extension/ReplayShake/tools/ui_dump_diff.py
new file mode 100644
index 00000000..2be1ab88
--- /dev/null
+++ b/Extension/ReplayShake/tools/ui_dump_diff.py
@@ -0,0 +1,147 @@
+#!/usr/bin/env python3
+"""Find the replay editor's playhead and keyframes in two of ReSkate's `ui dump` files.
+
+Take one dump, move the replay editor's playhead (or a keyframe), take another, then:
+
+    python ui_dump_diff.py ui-dump-0x1234abcd-1000.txt ui-dump-0x1234abcd-2000.txt
+
+It lists every number that changed between the two, read as the formats `replayshake map` takes,
+with its path written the way `replayshake map` wants it, and every list whose length changed.
+`--find 2.5` instead lists every number in the first dump within 0.01 of 2.5 (a keyframe's time as
+the editor shows it, say). Standard library only.
+"""
+import argparse
+import math
+import re
+import struct
+import sys
+
+FIELD = re.compile(r"^(0x[0-9a-f]{8})@0x[0-9a-f]+ <0x[0-9a-f]{8} k(\d+) (\d+)>(.*)$")
+ELEMENT = re.compile(r"^\[(\d+)\] <0x[0-9a-f]{8} k(\d+) (\d+)>(.*)$")
+ROOT = re.compile(r"^root 0x[0-9a-f]+ <(0x[0-9a-f]{8}) \d+>$")
+COUNT = re.compile(r"^ \[(\d+)\]$")
+BYTES = re.compile(r"^ = ([0-9a-f]+)$")
+
+
+def parse(path):
+    """Every scalar (as bytes) and list (as its length) in a dump, by root and field path."""
+    values, lists = {}, {}
+    root = None
+    seen_roots = {}
+    stack = []  # (depth, path segment or None for a step the mapping follows by itself)
+    with open(path, encoding="utf-8", errors="replace") as file:
+        for raw in file:
+            line = raw.rstrip("\n")
+            match = ROOT.match(line)
+            if match:
+                schema = match.group(1)
+                seen_roots[schema] = seen_roots.get(schema, 0) + 1
+                root = schema if seen_roots[schema] == 1 else f"{schema}#{seen_roots[schema]}"
+                stack = []
+                continue
+            if root is None or not line.startswith("  "):
+                continue
+            spaces = len(line) - len(line.lstrip(" "))
+            depth = (spaces - 2) // 2
+            text = line.strip()
+            while stack and stack[-1][0] >= depth:
+                stack.pop()
+            field = FIELD.match(text)
+            element = ELEMENT.match(text)
+            if field:
+                segment, rest = field.group(1), field.group(4)
+            elif element:
+                segment, rest = f"[{element.group(1)}]", element.group(4)
+            else:
+                # "(model) -> handle ..." and "(record data) ...": steps a path takes by itself.
+                stack.append((depth, None))
+                continue
+            stack.append((depth, segment))
+            key = (root, tuple(s for _, s in stack if s is not None))
+            count = COUNT.match(rest)
+            data = BYTES.match(rest)
+            if count:
+                lists[key] = int(count.group(1))
+            elif data and len(data.group(1)) in (8, 16):
+                values[key] = bytes.fromhex(data.group(1))
+    return values, lists
+
+
+def readings(data):
+    """The value as each format `replayshake map` takes for its size."""
+    if len(data) == 4:
+        return {"f32": struct.unpack("<f", data)[0], "i32": struct.unpack("<i", data)[0], "u32": struct.unpack("<I", data)[0]}
+    return {"f64": struct.unpack("<d", data)[0], "i64": struct.unpack("<q", data)[0]}
+
+
+def shown(value):
+    if isinstance(value, float):
+        return "nan" if math.isnan(value) else f"{value:.6g}"
+    return str(value)
+
+
+def path_text(key):
+    root, segments = key
+    text, out = "", []
+    for segment in segments:
+        if segment.startswith("["):
+            text += segment
+        else:
+            text += ("/" if text else "") + segment
+    out.append(f"{root}: {text}")
+    return out[0]
+
+
+def mapping_hint(key):
+    """How `replayshake map` would take this path: an element of a list maps as keyframes."""
+    root, segments = key
+    for index, segment in enumerate(segments):
+        if segment.startswith("["):
+            array = "/".join(segments[:index])
+            inside = "/".join(s for s in segments[index + 1:] if not s.startswith("[")) or "."
+            return f"map root {root.split('#')[0]}; map keyframes {array} <format> {inside}"
+    return f"map root {root.split('#')[0]}; map playhead <format> {'/'.join(segments)}  (or map selected, for an index)"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("before")
+    parser.add_argument("after", nargs="?")
+    parser.add_argument("--find", type=float, help="list numbers in BEFORE near this value instead of diffing")
+    parser.add_argument("--within", type=float, default=0.01, help="how near --find must be (default 0.01)")
+    args = parser.parse_args()
+    before_values, before_lists = parse(args.before)
+    if args.find is not None:
+        found = 0
+        for key, data in sorted(before_values.items()):
+            for name, value in readings(data).items():
+                if isinstance(value, float) and not math.isfinite(value):
+                    continue
+                if abs(value - args.find) <= args.within:
+                    print(f"{path_text(key)}  {name} {shown(value)}\n    {mapping_hint(key).replace('<format>', name)}")
+                    found += 1
+        print(f"{found} number(s) near {args.find}.")
+        return 0
+    if not args.after:
+        parser.error("give two dumps to compare, or --find with one")
+    after_values, after_lists = parse(args.after)
+    changed = 0
+    for key in sorted(set(before_values) & set(after_values)):
+        old, new = before_values[key], after_values[key]
+        if old == new:
+            continue
+        old_read, new_read = readings(old), readings(new)
+        parts = ", ".join(f"{name} {shown(old_read[name])} -> {shown(new_read[name])}" for name in old_read)
+        print(f"{path_text(key)}\n    {parts}\n    {mapping_hint(key)}")
+        changed += 1
+    for key in sorted(set(before_lists) & set(after_lists)):
+        if before_lists[key] != after_lists[key]:
+            print(f"{path_text(key)}  list of {before_lists[key]} -> {after_lists[key]}")
+            changed += 1
+    only = len(set(before_values) ^ set(after_values))
+    print(f"{changed} change(s); {only} value(s) in only one of the dumps (models that came or went).")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/Extension/ReplayShake/tools/update-reskate.ps1 b/Extension/ReplayShake/tools/update-reskate.ps1
new file mode 100644
index 00000000..0c07564f
--- /dev/null
+++ b/Extension/ReplayShake/tools/update-reskate.ps1
@@ -0,0 +1,850 @@
+<#
+.SYNOPSIS
+Builds ReSkate with Replay Shake (and the extra patches beside it: stick-pops.patch) and puts it in the
+folder ReSkate runs from: the first time from the patch, and again whenever ReSkate has a new version.
+
+.DESCRIPTION
+The first time, from the folder holding replay-shake.patch and this script:
+
+    powershell -ExecutionPolicy Bypass -File update-reskate.ps1 -Patch replay-shake.patch -Skate "C:\Games\ReSkate"
+
+It clones ReSkate into a ReSkate folder beside this script, puts Replay Shake on a branch of its own,
+builds it with Visual Studio 2022, runs Replay Shake's tests, and copies ReSkate.dll and
+ReSkateLauncher.exe into the folder you start ReSkate from, beside the copy of the game its launcher
+keeps there. The ones already there are kept as *.original (the first time) and *.previous (every
+time). Since 2.0.8, ReSkate's launcher does not start from Steam's skate. folder
+(...\steamapps\common\...): it has a folder of its own, so that is the one to give.
+
+It builds on the ReSkate its launcher installs (-On), so it plays online with everyone on that release
+(ReSkate's main branch moves on, and its multiplayer may not match the servers'). After that, whenever
+ReSkate puts out a new release, run it again with nothing more (or with that release's -On):
+
+    powershell -ExecutionPolicy Bypass -File update-reskate.ps1
+
+It fetches the newest release, moves Replay Shake onto it, builds, tests and installs. Where ReSkate
+changed the lines beside Replay Shake's few lines in its files, it puts them back beside ReSkate's new
+ones. Should one of those lines of ReSkate's be gone, or the build fail, nothing is installed, the
+ReSkate you have keeps working, and it says what to fit by hand (README.md, Staying up to date); run
+it again after, and it finishes the move, builds and installs.
+
+    -Patch       the first time, the patch; later, a newer one replaces Replay Shake (the branch as it
+                 was is kept as replay-shake-previous)
+    -Extra       more patches put on top of Replay Shake, each one commit: stick-pops.patch (L3 / R3 pop
+                 out of grinds, Skater XL style). When not given, stick-pops.patch beside this script is
+                 used if it is there. A newer one replaces the one on the branch, and one no longer given
+                 is taken off (the branch as it was is kept as replay-shake-previous).
+    -NoExtra     build Replay Shake without the extra patches (takes them off the branch)
+    -Rollback    put back the ReSkate.dll and ReSkateLauncher.exe from before the last install
+    -Original    put back the ones from before Replay Shake was first installed
+    -Force       build and install even when ReSkate has not changed (it is also built and installed
+                 when what is in the folder you start ReSkate from is not this build, as after the
+                 ReSkate launcher put a release there)
+    -On          the ReSkate to build on: release (the newest release tag; the default), a commit or tag
+                 (ReSkate sometimes rebuilds a release from newer code without moving its tag: 2.1.2's
+                 download is main at 55a7342d), or main (its newest code, unreleased)
+    -Fetch       more of ReSkate to fetch before that, by the name GitHub gives it: a pull request's
+                 commits are on none of ReSkate's branches (pull/383/head, the Animator Studio's: with
+                 -On its commit, Replay Shake goes onto that). A commit -On names in full is also
+                 fetched by itself, when nothing fetched holds it.
+    -FetchFrom   the repository -Fetch's names, and a commit -On names that ReSkate's own does not
+                 have, are fetched from (its URL; ReSkate's when not given): the Animator Studio's
+                 releases for each ReSkate are made in https://github.com/FourthStudio/ReSkate-Animator-Studio
+    -NoFetch     build what is checked out now (your own changes too), without fetching ReSkate
+    -SkipTests   skip Replay Shake's tests
+    -ReSkate     where the ReSkate checkout is (remembered); -Skate the folder you start ReSkate from
+                 (remembered)
+
+Runs in Windows PowerShell 5.1 and PowerShell 7. Needs Git and Visual Studio 2022's C++ tools: Build
+Tools for Visual Studio 2022 (https://aka.ms/vs/17/release/vs_buildtools.exe) with the "Desktop
+development with C++" workload, or Visual Studio 2022 itself (ReSkate's README). A newer Visual Studio
+alone does not have them.
+#>
+[CmdletBinding()]
+param(
+    [string]$Skate,
+    [string]$ReSkate,
+    [string]$Patch,
+    [string[]]$Extra,
+    [switch]$NoExtra,
+    [switch]$Rollback,
+    [switch]$Original,
+    [switch]$Force,
+    [switch]$NoFetch,
+    [switch]$SkipTests,
+    [string]$On = 'release',
+    [string[]]$Fetch,
+    [string]$FetchFrom,
+    [string]$Upstream = 'https://github.com/Dingo-Shenanigans/ReSkate'
+)
+$ErrorActionPreference = 'Stop'
+Set-StrictMode -Version 2
+
+$branch = 'replay-shake'
+# Where -Fetch's names (and a missing -On or patch commit) are fetched from: a URL, or ReSkate's own.
+$wantedFrom = if ($FetchFrom) { $FetchFrom } else { 'origin' }
+$files = @('ReSkate.dll', 'ReSkateLauncher.exe')
+
+function Say([string]$Text) { Write-Host $Text }
+function Fail([string]$Text, [int]$Code = 1) {
+    Write-Host ''
+    Write-Host $Text -ForegroundColor Red
+    exit $Code
+}
+# A program, its output on the console. Native tools write progress to stderr: that must not become
+# a PowerShell error. Returns the exit code.
+function Run([string]$Program, [string[]]$Arguments) {
+    $saved = $ErrorActionPreference
+    $ErrorActionPreference = 'Continue'
+    try {
+        & $Program @Arguments | Out-Host
+        return $LASTEXITCODE
+    } finally {
+        $ErrorActionPreference = $saved
+    }
+}
+# A program's output as text, or $null when it fails.
+function Capture([string]$Program, [string[]]$Arguments) {
+    $saved = $ErrorActionPreference
+    $ErrorActionPreference = 'Continue'
+    try {
+        $text = & $Program @Arguments 2>$null
+        if ($LASTEXITCODE -ne 0) { return $null }
+        return (@($text) -join "`n").Trim()
+    } finally {
+        $ErrorActionPreference = $saved
+    }
+}
+# Path parts joined. In an array, a part made with + needs brackets: the comma binds tighter than +.
+function Join([string[]]$Parts) { return [System.IO.Path]::Combine($Parts) }
+
+# What it remembers between runs: where things are, and what it installed.
+$stateFolder = if ($env:LOCALAPPDATA) { Join @($env:LOCALAPPDATA, 'ReSkate') } else { Join @($HOME, '.reskate') }
+$stateFile = Join @($stateFolder, 'replay_shake_update.json')
+$state = @{}
+if (Test-Path -LiteralPath $stateFile) {
+    try {
+        $saved = Get-Content -LiteralPath $stateFile -Raw | ConvertFrom-Json
+        foreach ($property in $saved.PSObject.Properties) { $state[$property.Name] = [string]$property.Value }
+    } catch {
+        Say "($stateFile could not be read: starting afresh.)"
+    }
+}
+function Remember([string]$Name, [string]$Value) { $state[$Name] = $Value }
+function Save-State {
+    New-Item -ItemType Directory -Force -Path $stateFolder | Out-Null
+    ([pscustomobject]$state | ConvertTo-Json) | Set-Content -LiteralPath $stateFile -Encoding UTF8
+}
+function Recall([string]$Name) { if ($state.ContainsKey($Name)) { return $state[$Name] } return '' }
+
+function Assert-GameClosed {
+    $running = @(Get-Process -Name 'Skate', 'ReSkateLauncher' -ErrorAction SilentlyContinue)
+    if ($running.Count) { Fail 'Close skate. and the ReSkate launcher first: their files cannot be replaced while they run.' }
+}
+function Assert-Skate {
+    if (-not $script:Skate) {
+        Fail 'Say where ReSkate is, the first time: -Skate "<the folder you start ReSkateLauncher.exe from>".'
+    }
+    if (-not (Test-Path -LiteralPath (Join @($script:Skate, 'Skate.exe')))) { Fail "There is no Skate.exe in $script:Skate." }
+}
+# ReSkate's launcher (2.0.8 on) closes when started from a game's folder in a Steam library
+# (...\steamapps\common\<game>, Launcher/main.cpp in_steam_library): a build installed there would
+# not start. Checked before anything is built.
+function Assert-NotSteamLibrary {
+    for ($folder = New-Object System.IO.DirectoryInfo $script:Skate; $folder -and $folder.Parent; $folder = $folder.Parent) {
+        if ($folder.Name -ieq 'common' -and $folder.Parent.Name -ieq 'steamapps') {
+            Fail ("$script:Skate is Steam's skate. folder, and ReSkate's launcher no longer starts from there (ReSkate " +
+                '2.0.8 on): it runs from a folder of its own, with its own copy of the game. Give that folder: ' +
+                '-Skate "<the folder you start ReSkateLauncher.exe from>". Nothing was changed.')
+        }
+    }
+}
+
+if (-not $Skate) { $Skate = Recall 'skate' }
+if ($Skate) { $Skate = [System.IO.Path]::GetFullPath($Skate) }
+
+# Going back needs nothing built.
+if ($Rollback -or $Original) {
+    Assert-Skate
+    $suffix = if ($Original) { '.original' } else { '.previous' }
+    foreach ($name in $files) {
+        if (-not (Test-Path -LiteralPath (Join @($Skate, ($name + $suffix))))) { Fail "There is no $name$suffix in $Skate to go back to." }
+    }
+    Assert-GameClosed
+    foreach ($name in $files) { Copy-Item -LiteralPath (Join @($Skate, ($name + $suffix))) -Destination (Join @($Skate, $name)) -Force }
+    Remember 'installed_commit' ''
+    Save-State
+    Say "Put back ReSkate.dll and ReSkateLauncher.exe from their $suffix copies in $Skate."
+    exit 0
+}
+
+if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
+    Fail 'Git is not installed: get it from https://git-scm.com/download/win, then run this again.'
+}
+
+# The ReSkate checkout: given; the one this script sits in; remembered; or a new one beside it.
+if (-not $ReSkate) {
+    $inside = Capture git @('-C', $PSScriptRoot, 'rev-parse', '--show-toplevel')
+    if ($inside -and (Test-Path -LiteralPath (Join @($inside, 'Extension', 'ReplayShake', 'ReplayShake.cmake')))) { $ReSkate = $inside }
+    elseif (Recall 'reskate') { $ReSkate = Recall 'reskate' }
+    else { $ReSkate = Join @($PSScriptRoot, 'ReSkate') }
+}
+$ReSkate = [System.IO.Path]::GetFullPath($ReSkate)
+
+# Visual Studio's own CMake, else one on the PATH (REPLAY_SHAKE_CMAKE names another).
+function Find-CMake {
+    if ($env:REPLAY_SHAKE_CMAKE) { return $env:REPLAY_SHAKE_CMAKE }
+    $programs = ${env:ProgramFiles(x86)}
+    if ($programs) {
+        $vswhere = Join @($programs, 'Microsoft Visual Studio', 'Installer', 'vswhere.exe')
+        if (Test-Path -LiteralPath $vswhere) {
+            $vs = Capture $vswhere @('-latest', '-products', '*', '-requires', 'Microsoft.VisualStudio.Component.VC.Tools.x86.x64',
+                '-property', 'installationPath')
+            if ($vs) {
+                $bundled = Join @($vs, 'Common7', 'IDE', 'CommonExtensions', 'Microsoft', 'CMake', 'CMake', 'bin', 'cmake.exe')
+                if (Test-Path -LiteralPath $bundled) { return $bundled }
+            }
+        }
+    }
+    $onPath = Get-Command cmake -ErrorAction SilentlyContinue
+    if ($onPath) { return $onPath.Source }
+    Fail ('Visual Studio 2022 with the "Desktop development with C++" workload is needed to build ReSkate ' +
+        '(https://visualstudio.microsoft.com/downloads/, Community is free). Install it, then run this again.')
+}
+
+# ReSkate builds with Visual Studio 2022's C++ tools (MSVC v143, CMakePresets.json). A newer Visual
+# Studio alone does not have them: what to install, when they are missing.
+function Get-ToolsHint {
+    $programs = ${env:ProgramFiles(x86)}
+    if (-not $programs) { return '' }
+    $vswhere = Join @($programs, 'Microsoft Visual Studio', 'Installer', 'vswhere.exe')
+    if (-not (Test-Path -LiteralPath $vswhere)) { return '' }
+    $vs2022 = Capture $vswhere @('-products', '*', '-version', '[17.0,18.0)', '-requires',
+        'Microsoft.VisualStudio.Component.VC.Tools.x86.x64', '-property', 'installationPath')
+    if ($vs2022) { return '' }
+    return ("ReSkate builds with Visual Studio 2022's C++ tools (MSVC v143), and they are not installed: a newer " +
+        "Visual Studio does not have them. Install Build Tools for Visual Studio 2022 beside it, from " +
+        "https://aka.ms/vs/17/release/vs_buildtools.exe, with the 'Desktop development with C++' workload. " +
+        "Then run this again.`n`n")
+}
+# A configure that failed, or was made by another CMake, may hold on to a Visual Studio that cannot
+# build ReSkate: the build folder then starts afresh (what was built stays, and is reused).
+function Clear-Configure([string]$Build) {
+    foreach ($part in 'CMakeCache.txt', 'CMakeFiles') {
+        $path = Join @($Build, $part)
+        if (Test-Path -LiteralPath $path) { Remove-Item -LiteralPath $path -Recurse -Force -ErrorAction SilentlyContinue }
+    }
+}
+# The ReSkate to build on: 'release', its newest release (a tag vX.Y.Z, the one its launcher installs);
+# 'main', its newest code; else the tag or commit named. '' when there is none.
+function Get-Base([string]$Want) {
+    if (-not $Want -or $Want -eq 'release') {
+        $tags = @((Capture git @('tag', '--list', 'v*')) -split "`n" | Where-Object { $_ -match '^v\d+\.\d+\.\d+$' })
+        if (-not $tags.Count) { return '' }
+        $newest = $tags | Sort-Object { [version]($_.Substring(1)) } | Select-Object -Last 1
+        return "refs/tags/$newest"
+    }
+    if ($Want -eq 'main') {
+        $main = Capture git @('rev-parse', '--abbrev-ref', 'origin/HEAD')
+        if ($main) { return $main }
+        return 'origin/main'
+    }
+    if ($null -ne (Capture git @('rev-parse', '--verify', '--quiet', "$Want^{commit}"))) { return $Want }
+    return ''
+}
+# What -Fetch names, fetched from GitHub (-FetchFrom, else ReSkate's own; kept as refs/fetched/<name>);
+# then a commit -On names in full that is still missing, by itself (GitHub gives a commit its branches
+# or pull requests hold). What GitHub does not give is said, and Get-Base says what is then missing.
+function Get-Wanted {
+    foreach ($name in @($Fetch | Where-Object { $_ } | ForEach-Object { $_ -replace '^refs/', '' })) {
+        if ((Run git @('-C', $ReSkate, 'fetch', '--no-tags', $wantedFrom, "+refs/${name}:refs/fetched/$name")) -ne 0) {
+            Say "(GitHub did not give ${name}, above.)"
+        }
+    }
+    if ($On -match '^[0-9a-f]{40}$' -and $null -eq (Capture git @('-C', $ReSkate, 'cat-file', '-e', "$On^{commit}"))) {
+        Run git @('-C', $ReSkate, 'fetch', '--no-tags', $wantedFrom, $On) | Out-Null
+    }
+}
+# Its name, as said: v2.1.2, or main.
+function Get-BaseName([string]$Base) { return ($Base -replace '^refs/tags/', '' -replace '^origin/', '') }
+# The ReSkate under Replay Shake's commit on the branch (its parent), or where the branch and $Base
+# part, should there be no Replay Shake commit.
+function Get-ShakeBase([string]$Base) {
+    $forked = Capture git @('merge-base', 'HEAD', $Base)
+    $range = if ($forked) { "$forked..HEAD" } else { 'HEAD' }
+    $shake = @((Capture git @('rev-list', '--reverse', '--grep=^Replay Shake:', $range)) -split "`n" | Where-Object { $_ }) |
+        Select-Object -First 1
+    if ($shake) { return (Capture git @('rev-parse', "$shake^")) }
+    return $forked
+}
+# A newer replay-shake.patch replaces the Replay Shake commit there; your own commits after it stay on
+# top, and the branch as it was is kept as replay-shake-previous. True when it did. It is made on the
+# ReSkate the patch was made on (its base-commit line), and moves onto the newest ReSkate after, like
+# any update. A patch with the same Replay Shake files, made on the same ReSkate, changes nothing.
+function Update-ReplayShake([string]$PatchFile, [string]$Mainline) {
+    $tip = Capture git @('rev-parse', 'HEAD')
+    $forked = Capture git @('merge-base', 'HEAD', $Mainline)
+    $range = if ($forked) { "$forked..HEAD" } else { 'HEAD' }
+    $old = @((Capture git @('rev-list', '--reverse', '--grep=^Replay Shake:', $range)) -split "`n" | Where-Object { $_ }) |
+        Select-Object -First 1
+    if (-not $old) { return $false }
+    $onto = Capture git @('rev-parse', "$old^")
+    $made = Select-String -LiteralPath $PatchFile -Pattern '^base-commit: ([0-9a-f]{40})' | Select-Object -First 1
+    if ($made) {
+        $madeOn = $made.Matches[0].Groups[1].Value
+        # A patch made on a newer ReSkate than this checkout has: that ReSkate is fetched first (by
+        # itself, should it be on none of ReSkate's branches, as a pull request's commit is).
+        if ($null -eq (Capture git @('cat-file', '-e', "$madeOn^{commit}")) -and -not $NoFetch) {
+            Say 'Getting the ReSkate the new patch was made on ...'
+            Run git @('fetch', 'origin') | Out-Null
+            if ($null -eq (Capture git @('cat-file', '-e', "$madeOn^{commit}"))) { Run git @('fetch', '--no-tags', $wantedFrom, $madeOn) | Out-Null }
+        }
+        if ($null -ne (Capture git @('cat-file', '-e', "$madeOn^{commit}"))) { $onto = $madeOn }
+    }
+    if ((Run git @('checkout', '--quiet', '--detach', $onto)) -ne 0) { Fail "Could not set the new patch up (above)." 2 }
+    if ((Run git @('am', '--3way', '--quiet', $PatchFile)) -ne 0) {
+        Run git @('am', '--abort') | Out-Null
+        Run git @('checkout', '--quiet', $branch) | Out-Null
+        Fail 'The new patch does not go onto ReSkate (above). Nothing was changed.' 2
+    }
+    # The same Replay Shake on the same ReSkate: nothing to change.
+    if ((Capture git @('rev-parse', "${old}:Extension/ReplayShake")) -eq (Capture git @('rev-parse', 'HEAD:Extension/ReplayShake')) -and
+        (Capture git @('rev-parse', "$old^")) -eq (Capture git @('rev-parse', 'HEAD^'))) {
+        Run git @('checkout', '--quiet', $branch) | Out-Null
+        return $false
+    }
+    foreach ($own in @((Capture git @('rev-list', '--reverse', "$old..$tip")) -split "`n" | Where-Object { $_ })) {
+        # The extra patches' commits are put back on by Update-Extras, from the patches given.
+        if (Get-ExtraKind (Capture git @('log', '-1', '--format=%s', $own))) { continue }
+        if ((Run git @('cherry-pick', '--allow-empty', $own)) -ne 0) {
+            Run git @('cherry-pick', '--abort') | Out-Null
+            Run git @('checkout', '--quiet', $branch) | Out-Null
+            Fail "Your commit $own does not go onto the new Replay Shake (above). Nothing was changed." 2
+        }
+    }
+    Run git @('branch', '--force', "$branch-previous", $tip) | Out-Null
+    if ((Run git @('checkout', '--quiet', '-B', $branch)) -ne 0) { Fail "Could not move the branch '$branch' (above)." 2 }
+    Say "Replay Shake replaced by the new patch (the branch as it was is kept as $branch-previous)."
+    return $true
+}
+
+# The extra patches that go on top of Replay Shake (-Extra), each one commit with a subject of its
+# own, by which its commit is told on the branch (never taken for one of your own).
+$extraKinds = @(
+    @{ Prefix = 'Stick pops:'; File = 'stick-pops.patch'; Name = 'the stick pops' }
+)
+function Get-PatchHash([string]$PatchFile) { return (Get-FileHash -LiteralPath $PatchFile -Algorithm SHA256).Hash }
+# A patch's subject (its Subject line, without [PATCH]).
+function Get-PatchSubject([string]$PatchFile) {
+    $line = Select-String -LiteralPath $PatchFile -Pattern '^Subject: (\[PATCH[^\]]*\] )?(.*)$' | Select-Object -First 1
+    if ($line) { return $line.Matches[0].Groups[2].Value }
+    return ''
+}
+function Get-ExtraKind([string]$Subject) {
+    foreach ($kind in $extraKinds) { if ($Subject -and $Subject.StartsWith($kind.Prefix)) { return $kind } }
+    return $null
+}
+# The extra patches on the branch, after the Replay Shake commit: put on, replaced or taken off when
+# the ones given change (their hashes are remembered). The branch is put together again from the
+# Replay Shake commit: the extras in the order given, then your own commits. The branch as it was is
+# kept as replay-shake-previous. True when the branch changed.
+function Update-Extras([string[]]$Patches, [string]$Mainline) {
+    $Patches = @($Patches | Where-Object { $_ })
+    $hashes = (@($Patches | ForEach-Object { Get-PatchHash $_ })) -join ' '
+    $tip = Capture git @('rev-parse', 'HEAD')
+    $forked = Capture git @('merge-base', 'HEAD', $Mainline)
+    $range = if ($forked) { "$forked..HEAD" } else { 'HEAD' }
+    $shake = ''
+    $extras = @()
+    $own = @()
+    foreach ($commit in @((Capture git @('rev-list', '--reverse', '--no-merges', $range)) -split "`n" | Where-Object { $_ })) {
+        $subject = Capture git @('log', '-1', '--format=%s', $commit)
+        if (-not $shake) {
+            if ($subject -and $subject.StartsWith('Replay Shake:')) { $shake = $commit }
+            continue
+        }
+        if (Get-ExtraKind $subject) { $extras += $commit } else { $own += $commit }
+    }
+    if (-not $shake) { return $false }
+    if ($extras.Count -eq $Patches.Count -and (Recall 'replay_shake_extras') -eq $hashes) { return $false }
+    if (-not $Patches.Count -and -not $extras.Count) {
+        Remember 'replay_shake_extras' ''
+        Save-State
+        return $false
+    }
+    if ($Patches.Count) {
+        Say ('Putting ' + ((@($Patches | ForEach-Object { (Get-ExtraKind (Get-PatchSubject $_)).Name })) -join ' and ') + ' on Replay Shake ...')
+    } else {
+        Say 'Taking the extra patches off Replay Shake ...'
+    }
+    if ((Run git @('checkout', '--quiet', '--detach', $shake)) -ne 0) { Fail 'Could not set the extra patches up (above).' 2 }
+    foreach ($file in $Patches) {
+        if ((Run git @('am', '--3way', '--quiet', $file)) -ne 0) {
+            Run git @('am', '--abort') | Out-Null
+            Run git @('checkout', '--quiet', $branch) | Out-Null
+            Fail ((Split-Path -Leaf $file) + ' does not go onto Replay Shake on this ReSkate (above). Nothing was changed: ' +
+                'make a new one for this ReSkate, or run this with -NoExtra to build Replay Shake without it.') 2
+        }
+    }
+    foreach ($commit in $own) {
+        if ((Run git @('cherry-pick', '--allow-empty', $commit)) -ne 0) {
+            Run git @('cherry-pick', '--abort') | Out-Null
+            Run git @('checkout', '--quiet', $branch) | Out-Null
+            Fail "Your commit $commit does not go onto the extra patches (above). Nothing was changed." 2
+        }
+    }
+    Run git @('branch', '--force', "$branch-previous", $tip) | Out-Null
+    if ((Run git @('checkout', '--quiet', '-B', $branch)) -ne 0) { Fail "Could not move the branch '$branch' (above)." 2 }
+    Remember 'replay_shake_extras' $hashes
+    Save-State
+    return $true
+}
+# Whether the files in the folder ReSkate starts from are the ones this checkout built last: the
+# ReSkate launcher may have put a release over them since.
+function Test-Installed {
+    $release = Join @($ReSkate, 'build', 'vs2022-x64', 'Release')
+    foreach ($name in $files) {
+        $built = Join @($release, $name)
+        $there = Join @($Skate, $name)
+        if (-not (Test-Path -LiteralPath $built) -or -not (Test-Path -LiteralPath $there)) { return $false }
+        if ((Get-FileHash -LiteralPath $built -Algorithm SHA256).Hash -ne (Get-FileHash -LiteralPath $there -Algorithm SHA256).Hash) { return $false }
+    }
+    return $true
+}
+
+# Replay Shake's changes to ReSkate's own files, all of them: lines put beside a line of ReSkate's
+# (the first of the anchors found; Key finds them once in) and tokens added after one in a line.
+# When ReSkate changes the lines around them, a move onto it stops; they are then put back beside
+# ReSkate's new ones (Fit-Rebase). Lines go in with the anchor's indent.
+$fits = @(
+    @{ File = 'CMakeLists.txt'; Key = 'ReplayShake/ReplayShake\.cmake'; After = @('^include\(cmake/Apps\.cmake\)')
+       Lines = @('include(Extension/ReplayShake/ReplayShake.cmake OPTIONAL)') }
+    @{ File = 'Extension/Console/commands.h'; Key = 'register_replay_shake_commands'
+       After = @('^void register_animation_studio_commands\(', '^void register_trainer_commands\(')
+       Lines = @('void register_replay_shake_commands(Commands &);') }
+    @{ File = 'Extension/Console/commands.cpp'; Key = 'register_replay_shake_commands'
+       After = @('^\s*register_animation_studio_commands\(', '^\s*register_trainer_commands\(')
+       Lines = @('register_replay_shake_commands(*result);') }
+    @{ File = 'Runtime/client_tick.cpp'; Key = 'Extension/ReplayShake/replay_shake\.h'; After = @('^#include "runtime_internal\.h"')
+       Lines = @('#include "Extension/ReplayShake/replay_shake.h"') }
+    @{ File = 'Runtime/client_tick.cpp'; Key = 'replay_shake::tick\('
+       Before = @('^\s*if \(!has_request && now < r\.next_model', '^\s*dingosdk::hall_of_meat::on_client_tick\(')
+       Lines = @('dingosdk::replay_shake::tick(r.base, state);') }
+    @{ File = 'Runtime/runtime_init.cpp'; Key = 'Extension/ReplayShake/replay_shake\.h'
+       After = @('^#include "Extension/UI/Overlay/animation_studio_images\.h"', '^#include "runtime_internal\.h"')
+       Lines = @('#include "Extension/ReplayShake/replay_shake.h"') }
+    @{ File = 'Runtime/runtime_init.cpp'; Key = 'replay_shake::start\('
+       After = @('^\s*\(void\)dingosdk::start_no_bail\(r\.base\);')
+       Lines = @('const bool replay_shake = dingosdk::replay_shake::start(r.base);',
+                 'record("{\"event\":\"replay_shake_initialized\",\"active\":" + std::string(replay_shake ? "true" : "false") + "}");') }
+    # Its page: a tab of Settings, after REPLAYS (ReSkate 2.1.4 moved MUSIC and REPLAYS into Settings,
+    # and ADDONS went). The lines are the commit's own, as for every fit.
+    @{ File = 'Extension/UI/Overlay/skate_menu_internal.h'; Key = 'ReplayShake/replay_shake_page\.cpp'
+       After = @('^void replays_page\(', '^void music_page\(')
+       Lines = @('// Settings > REPLAY SHAKE (Extension/ReplayShake/replay_shake_page.cpp): the replay editor''s camera shake.',
+                 'void replay_page(SkateMenu&, const Model&, const CallbacksV3&);') }
+    @{ File = 'Extension/UI/Overlay/skate_menu_internal.h'; Key = 'settings_replay_shake_tab'
+       After = @('settings_replays_tab = \d+;')
+       Lines = @('inline constexpr int settings_replay_shake_tab = settings_replays_tab + 1; // Extension/ReplayShake''s tab, after REPLAYS') }
+    @{ File = 'Extension/UI/Overlay/skate_menu_settings.cpp'; In = 'category_tabs\(menu, menu\.settings_tab'
+       Token = '"REPLAYS"'; Add = ', "REPLAY SHAKE"' }
+    @{ File = 'Extension/UI/Overlay/skate_menu_settings.cpp'; Key = '^\s*case settings_replay_shake_tab:'
+       After = @('^\s*case settings_replays_tab:')
+       Lines = @('case settings_replay_shake_tab: replay_page(menu, model, callbacks); break;') }
+)
+function Find-Line($Lines, [string[]]$Patterns) {
+    foreach ($pattern in $Patterns) {
+        for ($i = 0; $i -lt $Lines.Count; ++$i) { if ($Lines[$i] -cmatch $pattern) { return $i } }
+    }
+    return -1
+}
+function New-LineSet($Lines) {
+    $set = New-Object 'System.Collections.Generic.HashSet[string]' -ArgumentList ([System.StringComparer]::Ordinal)
+    foreach ($line in $Lines) { $null = $set.Add($line.Trim()) }
+    return ,$set
+}
+# A token fit: Add after Token in the line In finds. Should that line or token be gone, after the
+# token Add follows in the commit being moved ($Moving), where that token is in just one line.
+function Fit-Token($Lines, $Fit, [string[]]$Moving) {
+    $add = $Fit.Add
+    $token = $Fit.Token
+    $at = Find-Line $Lines @($Fit.In)
+    if ($at -lt 0 -or -not $Lines[$at].Contains($token)) {
+        $at = -1
+        $mine = Find-Line $Moving @($Fit.In)
+        if ($mine -lt 0 -or -not $Moving[$mine].Contains($add.Trim())) { $mine = Find-Line $Moving @([regex]::Escape($add.Trim())) }
+        $follows = if ($mine -ge 0) { [regex]::Match($Moving[$mine], '("[^"]*",|\w+,)\s*' + [regex]::Escape($add.Trim())) } else { $null }
+        if ($follows -and $follows.Success) {
+            $token = $follows.Groups[1].Value
+            $places = @(for ($i = 0; $i -lt $Lines.Count; ++$i) { if ($Lines[$i].Contains($token)) { $i } })
+            if ($places.Count -eq 1) { $at = $places[0] }
+        }
+        if ($at -lt 0) { return $false }
+    }
+    if (-not $Lines[$at].Contains($token + $add)) {
+        $Lines[$at] = $Lines[$at].Insert($Lines[$at].IndexOf($token) + $token.Length, $add)
+    }
+    return $true
+}
+# Replay Shake's changes put into the file as it is now (any already there are left be). False when
+# a line of ReSkate's they go beside is gone. $Moving is the file as the commit being moved has it:
+# the lines are taken from there, as they are now (a fit made by hand included), and should no
+# anchor be found they go beside the same line of ReSkate's as there (the one below them or the one
+# above, if it is still there just once). So a fit made by hand is followed the next time.
+function Fit-File([string]$File, [string[]]$Moving = @()) {
+    $path = Join @($ReSkate, $File)
+    $text = [System.IO.File]::ReadAllText($path)
+    $newline = if ($text.Contains("`r`n")) { "`r`n" } else { "`n" }
+    $lines = New-Object System.Collections.Generic.List[string]
+    $lines.AddRange([string[]]($text -split "`r?`n"))
+    $known = New-LineSet $lines # ReSkate's lines
+    foreach ($fit in @($fits | Where-Object { $_.File -ceq $File })) {
+        if ($fit.ContainsKey('Token')) {
+            if (-not (Fit-Token $lines $fit $Moving)) { return $false }
+            continue
+        }
+        if ((Find-Line $lines @($fit.Key)) -ge 0) { continue }
+        # The lines as the commit being moved has them: from the key on, up to a line of ReSkate's.
+        $block = @($fit.Lines)
+        $mine = Find-Line $Moving @($fit.Key)
+        if ($mine -ge 0) {
+            $block = @()
+            for ($i = $mine; $i -lt $Moving.Count -and $block.Count -lt $fit.Lines.Count; ++$i) {
+                $line = $Moving[$i].Trim()
+                if ($i -gt $mine -and (-not $line -or $known.Contains($line))) { break }
+                $block += $line
+            }
+        }
+        $after = $fit.ContainsKey('After')
+        $at = Find-Line $lines $(if ($after) { $fit.After } else { $fit.Before })
+        if ($at -lt 0 -and $mine -ge 0) {
+            $sides = @(@{ At = $mine + $block.Count; After = $false }, @{ At = $mine - 1; After = $true })
+            if ($after) { [array]::Reverse($sides) }
+            foreach ($side in $sides) {
+                $neighbour = if ($side.At -ge 0 -and $side.At -lt $Moving.Count) { $Moving[$side.At].Trim() } else { '' }
+                if ($neighbour.Length -le 3) { continue }
+                $places = @(for ($i = 0; $i -lt $lines.Count; ++$i) { if ($lines[$i].Trim() -ceq $neighbour) { $i } })
+                if ($places.Count -eq 1) {
+                    $at = $places[0]
+                    $after = $side.After
+                    break
+                }
+            }
+        }
+        if ($at -lt 0) { return $false }
+        $indent = [regex]::Match($lines[$at], '^\s*').Value
+        $lines.InsertRange($(if ($after) { $at + 1 } else { $at }), [string[]]@($block | ForEach-Object { $indent + $_ }))
+    }
+    [System.IO.File]::WriteAllText($path, ($lines -join $newline), (New-Object System.Text.UTF8Encoding $false))
+    return $true
+}
+# Whether every line the commit being moved adds to the file is in it now (for a token fit's line,
+# its token), so that a fit never drops a change the $fits list does not know of.
+function Test-Fitted([string]$File) {
+    $text = [System.IO.File]::ReadAllText((Join @($ReSkate, $File)))
+    $now = New-LineSet ($text -split "`r?`n")
+    $tokens = @($fits | Where-Object { $_.File -ceq $File -and $_.ContainsKey('Token') } | ForEach-Object { $_.Add.Trim() })
+    $diff = Capture git @('diff', '--no-color', '--unified=0', 'REBASE_HEAD~1', 'REBASE_HEAD', '--', $File)
+    if ($null -eq $diff) { return $false }
+    foreach ($added in @($diff -split "`n" | Where-Object { $_.StartsWith('+') -and -not $_.StartsWith('+++') })) {
+        $line = $added.Substring(1).Trim()
+        if (-not $line -or $now.Contains($line)) { continue }
+        $carried = @($tokens | Where-Object { $line.Contains($_) })
+        if (-not $carried.Count -or @($carried | Where-Object { -not $text.Contains($_) }).Count) { return $false }
+    }
+    return $true
+}
+# A move onto a new ReSkate stopped where ReSkate changed lines beside Replay Shake's: each such file
+# is taken as the new ReSkate has it, with Replay Shake's changes put back (Fit-File), and the move
+# goes on. False, the move still stopped, when that cannot be done here: a line of ReSkate's they go
+# beside is gone, or the stop is in a commit of your own (that is yours to fit).
+function Fit-Rebase {
+    for ($round = 0; $round -lt 20; ++$round) {
+        # Not stopped part way: the move failed before it began (round 0), or it is done.
+        if (-not (Test-Path -LiteralPath (Join @($ReSkate, '.git', 'rebase-merge')))) { return $round -gt 0 }
+        $subject = Capture git @('log', '-1', '--format=%s', 'REBASE_HEAD')
+        if (-not $subject -or -not $subject.StartsWith('Replay Shake:')) { return $false }
+        $conflicted = @((Capture git @('diff', '--name-only', '--diff-filter=U')) -split "`n" | Where-Object { $_ })
+        foreach ($file in $conflicted) {
+            if (-not @($fits | Where-Object { $_.File -ceq $file }).Count) { return $false }
+            $moving = @((Capture git @('show', "REBASE_HEAD:$file")) -split "`n")
+            if ((Run git @('checkout', '--ours', '--', $file)) -ne 0 -or -not (Fit-File $file $moving) -or
+                -not (Test-Fitted $file) -or (Run git @('add', '--', $file)) -ne 0) { return $false }
+            Say "Put Replay Shake's lines back into the new ReSkate's $file."
+        }
+        if ((Run git @('diff', '--cached', '--quiet')) -ne 0 -and (Run git @('commit', '--quiet', '--no-verify', '-C', 'REBASE_HEAD')) -ne 0) {
+            return $false
+        }
+        Run git @('rebase', '--continue') | Out-Null
+    }
+    return $false
+}
+
+# Where things are, checked and remembered before anything takes long: a run that stops part way
+# need not be told again.
+$patchFile = ''
+if ($Patch) {
+    if (-not (Test-Path -LiteralPath $Patch -PathType Leaf)) { Fail "There is no patch $Patch." }
+    $patchFile = (Resolve-Path -LiteralPath $Patch).Path
+}
+# The extra patches: those given; else the known ones beside this script; none with -NoExtra.
+$extraFiles = @()
+if (-not $NoExtra) {
+    $given = @($Extra | Where-Object { $_ })
+    if (-not $given.Count) {
+        foreach ($kind in $extraKinds) {
+            $beside = Join @($PSScriptRoot, $kind.File)
+            if (Test-Path -LiteralPath $beside -PathType Leaf) { $given += $beside }
+        }
+    }
+    foreach ($file in $given) {
+        if (-not (Test-Path -LiteralPath $file -PathType Leaf)) { Fail "There is no patch $file." }
+        $resolved = (Resolve-Path -LiteralPath $file).Path
+        if (-not (Get-ExtraKind (Get-PatchSubject $resolved))) {
+            Fail "$file is not one of the patches this script puts on Replay Shake (stick-pops.patch)."
+        }
+        $extraFiles += $resolved
+    }
+}
+Assert-Skate
+Assert-NotSteamLibrary
+Remember 'skate' $Skate
+Remember 'reskate' $ReSkate
+Save-State
+
+# The first time: ReSkate, and Replay Shake on a branch of its own.
+$patched = $false
+if (-not (Test-Path -LiteralPath (Join @($ReSkate, '.git')))) {
+    if (-not $Patch) { Fail "There is no ReSkate checkout in $ReSkate. The first time, give the patch: -Patch replay-shake.patch" }
+    Say "Getting ReSkate into $ReSkate ..."
+    if ((Run git @('clone', $Upstream, $ReSkate)) -ne 0) { Fail 'Could not get ReSkate (above).' }
+}
+# git needs a name for the commits it makes moving Replay Shake along: when you have none set, this
+# checkout gets one of its own (by hand too, should a move need fitting).
+foreach ($setting in @(@('user.name', 'Replay Shake'), @('user.email', 'replay-shake@localhost'))) {
+    if (-not (Capture git @('-C', $ReSkate, 'config', $setting[0]))) {
+        Run git @('-C', $ReSkate, 'config', $setting[0], $setting[1]) | Out-Null
+    }
+}
+$shakeCMake = Join @($ReSkate, 'Extension', 'ReplayShake', 'ReplayShake.cmake')
+if (-not (Test-Path -LiteralPath $shakeCMake)) {
+    $dirty = Capture git @('-C', $ReSkate, 'status', '--porcelain', '--untracked-files=no')
+    if ($dirty) { Fail "$ReSkate has changes that are not committed; commit or undo them first." }
+    # Replay Shake's branch, should another be checked out; else a new one with the patch on it.
+    $exists = Capture git @('-C', $ReSkate, 'rev-parse', '--verify', '--quiet', "refs/heads/$branch")
+    if ($exists -and (Run git @('-C', $ReSkate, 'checkout', $branch)) -ne 0) {
+        Fail "Could not switch $ReSkate to the branch '$branch' (above)."
+    }
+    if (-not (Test-Path -LiteralPath $shakeCMake)) {
+        if (-not $patchFile) { Fail "$ReSkate has no Replay Shake yet: give the patch, -Patch replay-shake.patch" }
+        Say "Putting Replay Shake on the branch '$branch' ..."
+        # Onto the ReSkate the patch was made on (its base-commit line), from where it moves onto the
+        # newest ReSkate below like any update; else straight onto the newest.
+        $start = @()
+        if (-not $NoFetch) { Get-Wanted }
+        $made = Select-String -LiteralPath $patchFile -Pattern '^base-commit: ([0-9a-f]{40})' | Select-Object -First 1
+        if ($made) {
+            $madeOn = $made.Matches[0].Groups[1].Value
+            if ($null -eq (Capture git @('-C', $ReSkate, 'cat-file', '-e', "$madeOn^{commit}")) -and -not $NoFetch) {
+                Run git @('-C', $ReSkate, 'fetch', '--no-tags', $wantedFrom, $madeOn) | Out-Null
+            }
+            if ($null -ne (Capture git @('-C', $ReSkate, 'cat-file', '-e', "$madeOn^{commit}"))) { $start = @($madeOn) }
+        }
+        if (-not $exists -and (Run git (@('-C', $ReSkate, 'checkout', '-b', $branch) + $start)) -ne 0) {
+            Fail "Could not make the branch '$branch' (above)."
+        }
+        if ((Run git @('-C', $ReSkate, 'am', '--3way', $patchFile)) -ne 0) {
+            Run git @('-C', $ReSkate, 'am', '--abort') | Out-Null
+            Fail ("The patch does not go onto this ReSkate (above). Nothing was changed: ask for a patch made for " +
+                "this version of ReSkate.") 2
+        }
+        $patched = $true
+    }
+    $Force = $true
+}
+
+Push-Location -LiteralPath $ReSkate
+# The process's own folder too: git cannot take away a folder a program is in, and a move onto a new
+# ReSkate takes this script's folder away and puts it back.
+$startedIn = [System.IO.Directory]::GetCurrentDirectory()
+[System.IO.Directory]::SetCurrentDirectory($ReSkate)
+try {
+    $git = Join @($ReSkate, '.git')
+    # A move onto a new ReSkate fitted by hand (README.md, Staying up to date): finish it.
+    if (Test-Path -LiteralPath (Join @($git, 'rebase-merge'))) {
+        $unmerged = Capture git @('diff', '--name-only', '--diff-filter=U')
+        if (-not $unmerged) {
+            Say 'Finishing the move onto the new ReSkate ...'
+            # The fitted commit keeps its message and author, committed here so that no editor opens
+            # to change them.
+            if ((Run git @('diff', '--cached', '--quiet')) -ne 0 -and
+                (Run git @('commit', '--quiet', '--no-verify', '-C', 'REBASE_HEAD')) -ne 0) {
+                Fail 'git could not commit the fitted files (above). Fix what it says and run this again, or git rebase --abort.' 2
+            }
+            if ((Run git @('rebase', '--continue')) -eq 0) { $Force = $true }
+            $unmerged = Capture git @('diff', '--name-only', '--diff-filter=U')
+        }
+        if (Test-Path -LiteralPath (Join @($git, 'rebase-merge'))) {
+            $what = if ($unmerged) { "Still to fit:`n$unmerged" } else { 'git says what it needs above.' }
+            Fail ("Replay Shake is part way onto the new ReSkate. $what`nFit each file (README.md, Staying up to date), " +
+                'git add it, and run this again; or run git rebase --abort to leave ReSkate as it was.') 2
+        }
+    }
+    foreach ($part in 'rebase-apply', 'MERGE_HEAD', 'CHERRY_PICK_HEAD') {
+        if (Test-Path -LiteralPath (Join @($git, $part))) {
+            Fail "A git operation is part way in $ReSkate. Finish it, or run: git rebase --abort (or git am --abort)."
+        }
+    }
+    $current = Capture git @('rev-parse', '--abbrev-ref', 'HEAD')
+    if ($current -ne $branch) {
+        if ((Run git @('checkout', $branch)) -ne 0) { Fail "Could not switch $ReSkate to the branch '$branch' (above)." }
+    }
+    $dirty = Capture git @('status', '--porcelain', '--untracked-files=no')
+    if ($dirty) {
+        Fail ("$ReSkate has changes that are not committed:`n$dirty`nCommit them (git commit -am `"my change`") and they " +
+            'come along with every update, or undo them (git checkout -- .).')
+    }
+    # The ReSkate Replay Shake goes onto (-On): its newest release unless told otherwise, fetched with
+    # its tags first (and what -Fetch names).
+    if (-not $NoFetch) {
+        Say 'Looking for a new ReSkate ...'
+        if ((Run git @('fetch', '--tags', 'origin')) -ne 0) { Fail 'Could not reach ReSkate on GitHub (above).' }
+        Get-Wanted
+    }
+    $mainline = Get-Base $On
+    if (-not $mainline) { Fail "There is no ReSkate '$On' in $ReSkate to build on (git tag lists the releases)." }
+    if ($patchFile -and -not $patched -and (Update-ReplayShake $patchFile $mainline)) { $Force = $true }
+    if (Update-Extras $extraFiles $mainline) { $Force = $true }
+    $before = Capture git @('rev-parse', 'HEAD')
+    $moved = $false
+    # Back to where it was, should anything below fail: what is installed stays as it is.
+    function Undo {
+        if ($moved) { Run git @('reset', '--hard', $before) | Out-Null }
+    }
+    # Where Replay Shake's commits begin: the ReSkate under them. Only they, and what came after, move.
+    $forkedAt = Get-ShakeBase $mainline
+    $target = Capture git @('rev-parse', "$mainline^{commit}")
+    if (-not $NoFetch) {
+        if ($forkedAt -ne $target) {
+            Say "Moving Replay Shake onto ReSkate $(Get-BaseName $mainline) ..."
+            $move = if ($forkedAt) { @('rebase', '--onto', $mainline, $forkedAt) } else { @('rebase', $mainline) }
+            if ((Run git $move) -ne 0 -and -not (Fit-Rebase)) {
+                $conflicts = Capture git @('diff', '--name-only', '--diff-filter=U')
+                $stopped = Capture git @('log', '-1', '--format=%s', 'REBASE_HEAD')
+                Run git @('rebase', '--abort') | Out-Null
+                $extraKind = Get-ExtraKind $stopped
+                if ($extraKind) {
+                    Fail ("ReSkate changed lines $($extraKind.Name) change too, in:`n$conflicts`n`nNothing was installed: the " +
+                        "ReSkate you have keeps working. Make a new $($extraKind.File) for it, or run this " +
+                        'with -NoExtra to build Replay Shake without it on the new ReSkate.') 2
+                }
+                $whose = if ($stopped -and -not $stopped.StartsWith('Replay Shake:')) { "your own commit `"$stopped`" changes" }
+                         else { "Replay Shake's go beside" }
+                Fail ("ReSkate changed the lines $whose, in:`n$conflicts`n`nNothing was installed: the " +
+                    'ReSkate you have keeps working. To fit Replay Shake to the new ReSkate, see README.md, Staying up to ' +
+                    "date: it starts with git rebase $mainline in $ReSkate.") 2
+            }
+            $moved = $true
+            if ((Run git @('merge-base', '--is-ancestor', $mainline, 'HEAD')) -ne 0) {
+                Undo
+                Fail 'Replay Shake could not be moved onto the new ReSkate (above). Nothing was installed.' 2
+            }
+        } elseif (-not $Force -and (Recall 'installed_commit') -eq $before -and $Skate -and
+                  (Test-Path -LiteralPath (Join @($Skate, 'ReSkate.dll')))) {
+            if (Test-Installed) {
+                Say 'ReSkate has not changed and this build is installed: nothing to do (-Force builds it again).'
+                exit 0
+            }
+            Say "What is in $Skate is not this build (the ReSkate launcher may have put a release there): putting it back ..."
+        }
+    }
+
+    $cmake = Find-CMake
+    $ctest = Join @((Split-Path -Parent $cmake), ('ctest' + [System.IO.Path]::GetExtension($cmake)))
+    $build = Join @($ReSkate, 'build', 'vs2022-x64')
+    Say 'Building ReSkate with Replay Shake (the first time takes a while) ...'
+    if ((Recall 'configured_with') -ne $cmake) { Clear-Configure $build }
+    if ((Run $cmake @('--preset', 'vs2022-x64', '-DDINGOSDK_BUILD_REPLAY_SHAKE_TESTS=ON')) -ne 0) {
+        Clear-Configure $build
+        Remember 'configured_with' ''
+        Save-State
+        Undo
+        Fail ((Get-ToolsHint) + 'Setting up the build failed (above). Nothing was installed, and ReSkate is back where it was.') 3
+    }
+    Remember 'configured_with' $cmake
+    Save-State
+    if ((Run $cmake @('--build', '--preset', 'release', '--parallel')) -ne 0) {
+        Undo
+        Fail 'The build failed (above). Nothing was installed, and ReSkate is back where it was.' 3
+    }
+    if (-not $SkipTests) {
+        if ((Run $ctest @('--test-dir', $build, '-C', 'Release', '-R', 'replay_shake', '--output-on-failure')) -ne 0) {
+            Undo
+            Fail "Replay Shake's tests failed (above). Nothing was installed, and ReSkate is back where it was." 3
+        }
+    }
+
+    Assert-GameClosed
+    $release = Join @($build, 'Release')
+    foreach ($name in $files) {
+        if (-not (Test-Path -LiteralPath (Join @($release, $name)))) { Undo; Fail "The build made no $name in $release." 3 }
+    }
+    foreach ($name in $files) {
+        $target = Join @($Skate, $name)
+        if (Test-Path -LiteralPath $target) {
+            if (-not (Test-Path -LiteralPath ($target + '.original'))) { Copy-Item -LiteralPath $target -Destination ($target + '.original') }
+            Copy-Item -LiteralPath $target -Destination ($target + '.previous') -Force
+        }
+        Copy-Item -LiteralPath (Join @($release, $name)) -Destination $target -Force
+    }
+
+    $commit = Capture git @('rev-parse', 'HEAD')
+    # The ReSkate it is built on: its release tag (ReSkate's own, v...: another repository's fetched
+    # with -Fetch are not its) and the changes since, and their date.
+    $base = Capture git @('merge-base', 'HEAD', $mainline)
+    $reskateVersion = 'unknown'
+    if ($base) {
+        $reskateVersion = '{0} of {1}' -f (Capture git @('describe', '--tags', '--match', 'v[0-9]*', '--always', $base)),
+            (Capture git @('log', '-1', '--format=%ad', '--date=short', $base))
+    }
+    $supported = ''
+    $pins = Join @($ReSkate, 'Engine', 'Game', 'Build', 'supported_build.h')
+    if (Test-Path -LiteralPath $pins) {
+        $found = Select-String -LiteralPath $pins -Pattern 'steam_build_id = "(\d+)"' | Select-Object -First 1
+        if ($found) { $supported = $found.Matches[0].Groups[1].Value }
+    }
+    $previousBuild = Recall 'game_build'
+    Remember 'skate' $Skate
+    Remember 'reskate' $ReSkate
+    Remember 'installed_commit' $commit
+    if ($supported) { Remember 'game_build' $supported }
+    Save-State
+
+    Say ''
+    Say "Installed in $Skate (the ones before are *.previous; -Rollback puts them back)."
+    $with = 'Replay Shake'
+    foreach ($file in $extraFiles) { $with += ' and ' + (Get-ExtraKind (Get-PatchSubject $file)).Name }
+    Say "ReSkate $reskateVersion, with $with."
+    if (@($extraFiles | Where-Object { (Get-ExtraKind (Get-PatchSubject $_)).File -eq 'stick-pops.patch' }).Count) {
+        Say 'Pop with L3 / R3 is in the ReSkate menu, Addons > GRIND EXITS (and Mod Options > Player).'
+    }
+    if ($supported -and $previousBuild -and $supported -ne $previousBuild) {
+        Say ("This ReSkate runs skate. build $supported (it was $previousBuild): its launcher fetches that build on its next " +
+            "start, and Replay Shake asks you to find the replay editor's camera again (README.md, step 2).")
+    }
+    Say 'Start the game with the ReSkateLauncher.exe there: a build of your own never replaces itself with a release.'
+    if ($On -eq 'release') {
+        Say 'When ReSkate puts out a new release, run this again: it moves Replay Shake onto that one.'
+    } else {
+        Say "It is built on the ReSkate -On names ($On): with another -On, it moves Replay Shake onto that one."
+    }
+    # What the build said about reading the game another way than Replay Shake knows (ReplayShake.cmake).
+    $notes = Join @($build, 'replay_shake_notes.txt')
+    if ((Test-Path -LiteralPath $notes) -and (Get-Content -LiteralPath $notes -Raw)) {
+        Say ''
+        Write-Host 'Replay Shake built, with a note:' -ForegroundColor Yellow
+        Get-Content -LiteralPath $notes | ForEach-Object { Write-Host "  $_" -ForegroundColor Yellow }
+    }
+} finally {
+    try { [System.IO.Directory]::SetCurrentDirectory($startedIn) } catch { }
+    Pop-Location
+}
