index 00000000..c5f6ee16
--- /dev/null
+++ b/Extension/ReplayShake/replay_shake_model.h
@@ -0,0 +1,124 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string_view>
+#include <vector>
+
+// Replay Shake's camera shake, with no game access: what a shake is, how one keyframe's shake turns
+// into the next along the replay's timeline, and how a shake moves a camera.
+//
+// A shake is smooth noise on six motions of the camera (and an optional zoom). Each keyframe can
+// have its own; between two keyframes its strength, roughness and speed turn into the next one's
+// the way the keyframe's blend says, as the game's own keyframes blend their field of view and roll.
+// Everything is a pure function of the replay's time, so a paused replay holds still, scrubbing
+// back shows the same shake again, and an export matches what the editor showed.
+namespace dingosdk::replay_shake {
+
+// The motions a shake moves the camera by, in the camera's own frame: turns in degrees, moves in
+// metres, zoom in percent of the field of view.
+namespace channel {
+enum Index : std::size_t { pitch, yaw, roll, sideways, up, forward, zoom, count };
+}
+inline constexpr std::size_t channel_count = channel::count;
+inline constexpr std::array<std::string_view, channel_count> channel_names{
+    "pitch", "yaw", "roll", "sideways", "up", "forward", "zoom"};
+using Amounts = std::array<float, channel_count>;
+
+enum class Preset : std::uint8_t { handheld, walking, running, vehicle, earthquake, drift, custom, count };
+inline constexpr std::array<std::string_view, static_cast<std::size_t>(Preset::count)> preset_names{
+    "handheld", "walking", "running", "vehicle", "earthquake", "drift", "custom"};
+std::optional<Preset> preset_named(std::string_view name) noexcept;
+std::string_view name(Preset preset) noexcept;
+
+// How a keyframe's shake turns into the next keyframe's: eased in and out, evenly, or held until
+// the next keyframe and then cut.
+enum class Blend : std::uint8_t { smooth, linear, hold, count };
+inline constexpr std::array<std::string_view, static_cast<std::size_t>(Blend::count)> blend_names{
+    "smooth", "linear", "hold"};
+std::optional<Blend> blend_named(std::string_view name) noexcept;
+std::string_view name(Blend blend) noexcept;
+
+inline constexpr float max_intensity = 3.0f;
+inline constexpr float min_frequency = 0.05f, max_frequency = 30.0f;
+// The most each channel may move at intensity 1: 15 degrees, 0.5 m, 20 percent.
+inline constexpr Amounts max_amounts{15, 15, 15, 0.5f, 0.5f, 0.5f, 20};
+
+struct Shake {
+    Preset preset = Preset::handheld; // where the amounts came from (custom once one is changed)
+    float intensity = 1.0f;           // scales every amount: 0 none, 1 the amounts as they are
+    float frequency = 1.0f;           // hertz: how fast it moves, its slowest layer
+    float roughness = 0.4f;           // 0 smooth to 1 jittery: how much its faster layers add
+    Amounts amounts{};                // per channel, at intensity 1
+    bool operator==(const Shake&) const = default;
+};
+// A preset's shake, at intensity 1.
+Shake preset_shake(Preset preset) noexcept;
+// Takes a preset's frequency, roughness and amounts, keeping the intensity.
+void apply_preset(Shake& shake, Preset preset) noexcept;
+// Within the limits above; anything not finite becomes the preset's own value.
+Shake clamped(const Shake& shake) noexcept;
+// Whether it moves nothing.
+bool silent(const Shake& shake) noexcept;
+
+// One point of a replay's timeline: a keyframe's time (seconds) and the shake from there on.
+struct Point {
+    double time{};
+    Shake shake;
+    Blend blend = Blend::smooth;
+};
+
+// The shake at one moment: how far each channel may move (intensity times amount, blended between
+// the keyframes either side), its roughness and speed there, and how far its noise has run.
+struct Sample {
+    Amounts amplitude{};
+    float roughness{};
+    double frequency{}; // hertz
+    double phase{};     // cycles: the integral of the frequency over time, so changing speed never jumps
+};
+// `points` sorted by time. With none, `fallback` holds for the whole replay. Before the first point
+// its shake holds; after the last, the last's does.
+Sample sample(std::span<const Point> points, const Shake& fallback, double time) noexcept;
+
+// The camera's offsets at a sample: degrees, metres and percent, per channel.
+using Offsets = Amounts;
+Offsets offsets(const Sample& sample, std::uint32_t seed) noexcept;
+bool still(const Offsets& offsets) noexcept;
+
+// Smooth gradient noise, about -1 to 1, one cycle per unit of x.
+float noise(std::uint32_t seed, double x) noexcept;
+// Three layers of it, each faster and (with less roughness) weaker than the last.
+float layered(std::uint32_t seed, double x, float roughness) noexcept;
+
+// A camera's world matrix (rows right, up, back, position; their fourth lanes kept as they are)
+// moved by offsets given in the camera's own frame: pitch turns about its right, yaw about its up,
+// roll about its back; sideways, up and forward move along them.
+using Matrix = std::array<float, 16>;
+Matrix shaken(const Matrix& camera, const Offsets& offsets) noexcept;
+// A vertical field of view in radians, zoomed by offsets[channel::zoom] percent.
+float zoomed(float fov, const Offsets& offsets) noexcept;
+
+// A keyframe's shake (or a free one, while the game's keyframes cannot be read): from `time` on.
+struct Key {
+    double time{};
+    Shake shake;
+    Blend blend = Blend::smooth;
+    bool operator==(const Key&) const = default;
+};
+// Keys sit on the keyframe at their time when one is within this many seconds.
+inline constexpr double key_tolerance = 1.0 / 1000.0;
+inline constexpr std::size_t max_keys = 256;
+// The index of the keyframe a time sits on, if any.
+std::optional<std::size_t> keyframe_at(std::span<const double> keyframes, double time) noexcept;
+// The timeline to sample. With the game's keyframes, one point per keyframe: the key on it, or the
+// default shake. Without them, the keys themselves. Sorted by time either way.
+std::vector<Point> timeline(std::span<const double> keyframes, std::span<const Key> keys, const Shake& fallback);
+// Keeps keys on their keyframes as the editor moves them: `before` and `after` are the keyframe
+// times of two readings. One keyframe dragged (the same number of keyframes, all but one where they
+// were) takes its key along. A keyframe added or deleted moves no other, and several changing at
+// once is another replay: no key moves. Keys on no keyframe are left alone (they come back when a
+// keyframe is at their time again).
+void follow(std::vector<Key>& keys, std::span<const double> before, std::span<const double> after);
+} // namespace dingosdk::replay_shake
diff --git a/Extension/ReplayShake/replay_shake_page.cpp b/Extension/ReplayShake/replay_shake_page.cpp
new file mode 100644
index 00000000..d63a8e7d
--- /dev/null
+++ b/Extension/ReplayShake/replay_shake_page.cpp
@@ -0,0 +1,270 @@
+#include "replay_shake_model.h"
+#include "replay_shake_settings.h"
+#include "replay_shake_view.h"
+#include "Extension/UI/Overlay/skate_menu_internal.h"
+#include "Extension/UI/skate_theme.h"
+#include <algorithm>
+#include <array>
+#include <format>
+#include <string>
+
+// The REPLAY SHAKE page (an addon under EXTRAS): Replay Shake's switch, its default shake, each keyframe's shake, the export and
+// setting it up. Presentation thread: reads Replay Shake's snapshot (replay_shake_view.h) and sends
+// `replayshake ...` console commands; it never touches the game.
+namespace dingosdk::overlay::menu {
+namespace {
+namespace shake = dingosdk::replay_shake;
+struct Page {
+    int editing = -1;          // the row whose shake is open (its number), -1 none
+    bool follow_editor = true; // open the keyframe the replay editor has selected
+    std::string active;        // the slider being dragged, and its value: the snapshot
+    float active_value{};      // lags a frame or two behind it
+    // Recording the controller toggle, as ReSkate's own binds page records its binds: until when.
+    bool recording{};
+    double record_until{};
+    ControllerComboCapture capture;
+};
+Page& page() {
+    static auto* value = new Page;
+    return *value;
+}
+void send(SkateMenu& menu, const CallbacksV3& callbacks, const std::string& command) {
+    send_console(menu, callbacks, "replayshake " + command);
+}
+
+// A slider that sends `<prefix> <setting> <value>` as it moves; `scale` turns the stored value into
+// the one shown (and typed in commands), such as a fraction into percent.
+void slider(SkateMenu& menu, const CallbacksV3& callbacks, Page& p, const std::string& prefix, const char* label,
+    const char* setting, float value, float low, float high, const char* format, float scale = 1, bool logarithmic = false,
+    const char* tooltip = nullptr) {
+    field(menu, label, tooltip);
+    const auto id = prefix + " " + setting;
+    float shown = p.active == id ? p.active_value : value * scale;
+    ImGuiSliderFlags flags = ImGuiSliderFlags_AlwaysClamp;
+    if (logarithmic) flags |= ImGuiSliderFlags_Logarithmic;
+    ImGui::PushID(id.c_str());
+    const bool moved = ImGui::SliderFloat("##value", &shown, low, high, format, flags);
+    if (ImGui::IsItemActive()) {
+        p.active = id;
+        p.active_value = shown;
+    } else if (p.active == id) {
+        p.active.clear();
+    }
+    if (moved) send(menu, callbacks, std::format("{} {} {}", prefix, setting, shown));
+    ImGui::PopID();
+}
+
+void shake_editor(SkateMenu& menu, const CallbacksV3& callbacks, Page& p, const std::string& prefix, const shake::Shake& value,
+    const shake::Blend* blend) {
+    ImGui::PushID(prefix.c_str());
+    field(menu, "Preset", "Where to start. Changing a single amount below makes it Custom.");
+    int preset = static_cast<int>(value.preset);
+    if (choice(menu, "preset", preset, {"Handheld", "Walking", "Running", "Vehicle", "Quake", "Drift", "Custom"}))
+        send(menu, callbacks, std::format("{} preset {}", prefix, shake::name(static_cast<shake::Preset>(preset))));
+    slider(menu, callbacks, p, prefix, "Intensity", "intensity", value.intensity, 0, shake::max_intensity * 100, "%.0f%%", 100, false,
+        "Scales every amount: 0% is no shake, 100% the amounts as they are.");
+    slider(menu, callbacks, p, prefix, "Speed", "frequency", value.frequency, shake::min_frequency, shake::max_frequency, "%.2f Hz",
+        1, true, "How fast it moves: about how many sways a second.");
+    slider(menu, callbacks, p, prefix, "Roughness", "roughness", value.roughness, 0, 100, "%.0f%%", 100, false,
+        "0% sways smoothly; 100% adds fast jitter on top.");
+    if (blend) {
+        field(menu, "Into the next", "How this keyframe's shake turns into the next keyframe's.");
+        int chosen = static_cast<int>(*blend);
+        if (choice(menu, "blend", chosen, {"Smooth", "Linear", "Hold"}))
+            send(menu, callbacks, std::format("{} blend {}", prefix, shake::name(static_cast<shake::Blend>(chosen))));
+    }
+    if (ImGui::TreeNode("Fine tuning")) {
+        namespace channel = shake::channel;
+        const auto& a = value.amounts;
+        slider(menu, callbacks, p, prefix, "Pitch (nod)", "pitch", a[channel::pitch], 0, shake::max_amounts[channel::pitch], "%.2f deg");
+        slider(menu, callbacks, p, prefix, "Yaw (pan)", "yaw", a[channel::yaw], 0, shake::max_amounts[channel::yaw], "%.2f deg");
+        slider(menu, callbacks, p, prefix, "Roll (tilt)", "roll", a[channel::roll], 0, shake::max_amounts[channel::roll], "%.2f deg");
+        slider(menu, callbacks, p, prefix, "Sideways", "sideways", a[channel::sideways], 0, shake::max_amounts[channel::sideways] * 100,
+            "%.1f cm", 100);
+        slider(menu, callbacks, p, prefix, "Up and down", "up", a[channel::up], 0, shake::max_amounts[channel::up] * 100, "%.1f cm", 100);
+        slider(menu, callbacks, p, prefix, "Forward and back", "forward", a[channel::forward], 0,
+            shake::max_amounts[channel::forward] * 100, "%.1f cm", 100);
+        slider(menu, callbacks, p, prefix, "Zoom", "zoom", a[channel::zoom], 0, shake::max_amounts[channel::zoom], "%.1f%%", 1, false,
+            "Breathing of the field of view. Off in every preset.");
+        note("The amounts are at 100% intensity: the furthest each motion goes.");
+        ImGui::TreePop();
+    }
+    ImGui::PopID();
+}
+
+void keyframes_card(SkateMenu& menu, const CallbacksV3& callbacks, Page& p, const shake::View& view) {
+    begin_card(menu, "replay-keys", view.keyframe_mode ? "KEYFRAMES" : "SHAKE KEYS",
+        view.keyframe_mode ? "the replay editor's, each with a shake" : "points on the timeline, each with a shake");
+    if (view.keyframe_mode) {
+        if (view.rows.empty()) note("The replay has no keyframes yet: the default shake runs throughout.");
+        toggle_row(menu, "Follow the editor's selection", "Open the keyframe selected in the replay editor.", p.follow_editor);
+        if (p.follow_editor)
+            for (const auto& row : view.rows)
+                if (row.selected) p.editing = row.number;
+    } else {
+        note(view.rows.empty() ? "No shake keys: the default shake runs throughout. Add one at the playhead to change the shake "
+                                 "from there on."
+                               : "The shake changes at each key, blending into the next.");
+        if (primary_button(menu, "ADD A KEY AT THE PLAYHEAD", view.playhead.has_value())) send(menu, callbacks, "add");
+        if (!view.playhead) note("The playhead is not readable yet (README.md, step 3); `replayshake add <seconds>` adds one by time.");
+    }
+    if (std::none_of(view.rows.begin(), view.rows.end(), [&](const shake::Row& row) { return row.number == p.editing; }))
+        p.editing = -1;
+    for (const auto& row : view.rows) {
+        ImGui::PushID(row.number);
+        const auto label = std::format("{}{:>3}   {:>9}   {}{}{}", row.current ? "> " : "  ", row.number, shake::seconds(row.time),
+            row.own ? shake::describe(row.shake) : std::string("default"), row.own ? ", " + std::string(shake::name(row.blend)) : "",
+            row.selected ? "   (selected)" : "");
+        if (ImGui::Selectable(label.c_str(), p.editing == row.number)) {
+            p.editing = p.editing == row.number ? -1 : row.number;
+            p.follow_editor = false;
+        }
+        ImGui::PopID();
+    }
+    for (const auto& row : view.rows) {
+        if (row.number != p.editing) continue;
+        ImGui::Dummy(ImVec2(0, px(6)));
+        ImGui::PushFont(menu.bold);
+        ImGui::TextUnformatted(std::format("{} {} at {}", view.keyframe_mode ? "Keyframe" : "Key", row.number,
+            shake::seconds(row.time)).c_str());
+        ImGui::PopFont();
+        if (view.keyframe_mode && !row.own) note("Uses the default shake: change anything to give it its own.");
+        shake_editor(menu, callbacks, p, std::format("key {}", row.number), row.shake, &row.blend);
+        if (row.own && ImGui::Button(view.keyframe_mode ? "Back to the default shake" : "Remove this key"))
+            send(menu, callbacks, std::format("key {} reset", row.number));
+    }
+    end_card();
+}
+
+// The controller toggle: Record takes the next combo pressed (or key, or chord of keys), as ReSkate's own
+// binds page does (skate_menu_settings.cpp), and saves it with `replayshake bind`; Clear takes it off.
+void controller_toggle_row(SkateMenu& menu, const CallbacksV3& callbacks, Page& p, const shake::View& view) {
+    ControllerInput controller;
+    DingoSDKOverlayReadControllerInput(&controller, true);
+    if (p.recording) {
+        if (!view.available || ImGui::GetTime() >= p.record_until) {
+            p.recording = false;
+            feedback(menu, "Recording cancelled: the controller toggle is unchanged.");
+        } else if (const auto combo = p.capture.update(controller, true)) {
+            p.recording = false;
+            send(menu, callbacks, std::format("bind {}", *combo));
+        }
+    }
+    field(menu, "Controller toggle", "A controller combo (or a key) that switches Replay Shake on or off while the replay "
+        "editor is open. Pick one the editor does not use.");
+    ImGui::AlignTextToFramePadding();
+    ImGui::TextUnformatted((p.recording ? std::string("Recording...") : controller_combo_label(view.toggle, controller.style)).c_str());
+    ImGui::SameLine();
+    ImGui::PushID("replay-toggle");
+    if (p.recording) {
+        if (ImGui::Button("Cancel")) p.recording = false;
+    } else {
+        ImGui::BeginDisabled(!view.available);
+        if (ImGui::Button("Record")) {
+            p.capture = {};
+            p.recording = true;
+            p.record_until = ImGui::GetTime() + 30;
+        }
+        ImGui::EndDisabled();
+        ImGui::SameLine();
+        ImGui::BeginDisabled(!view.toggle);
+        if (ImGui::Button("Clear")) send(menu, callbacks, "bind clear");
+        ImGui::EndDisabled();
+    }
+    ImGui::PopID();
+    if (p.recording)
+        warn(!p.capture.ready ? "Let go of every button and key first."
+                              : "Hold the combo, then let go: buttons together, such as LB + RB, or up to five keys.");
+}
+
+void setup_card(SkateMenu& menu, const CallbacksV3& callbacks, const shake::View& view) {
+    begin_card(menu, "replay-setup", "SETTING UP", "README.md has the three steps");
+    bool test = view.test;
+    if (toggle_row(menu, "Test anywhere", "Step 1: shake every view in the level with the default shake, to see the shake works. "
+            "Turn the default's intensity up first.", test, view.available))
+        send(menu, callbacks, test ? "test 1" : "test 0");
+    bool probe = view.probe;
+    if (toggle_row(menu, "Probe", "Step 2: list the cameras on show here (and in ReSkate.log), with what moves each (its "
+            "director). Open the replay editor: the director that turns up there, and not while skating, is its own.", probe,
+            view.available))
+        send(menu, callbacks, probe ? "probe 1" : "probe 0");
+    std::string cameras;
+    for (const auto camera : view.cameras) cameras += (cameras.empty() ? "" : ", ") + shake::hex(camera);
+    info(menu, "Replay cameras", cameras.empty() ? std::string("none yet") : cameras);
+    if (view.probe) {
+        if (!view.menu_state.empty()) info(menu, "Game menus", view.menu_state);
+        if (view.cameras_seen.empty()) note("No camera on show (not in a level?).");
+        int id = 0;
+        const auto offer = [&](const char* what, std::uintptr_t value) {
+            ImGui::PushID(++id);
+            const bool known = std::find(view.cameras.begin(), view.cameras.end(), value) != view.cameras.end();
+            ImGui::AlignTextToFramePadding();
+            const bool gameplays = value == view.every_camera ||
+                std::find(view.gameplay_directors.begin(), view.gameplay_directors.end(), value) != view.gameplay_directors.end();
+            ImGui::TextUnformatted(std::format("On show: {} {}{}", what, shake::hex(value),
+                value == view.every_camera ? " (every camera's, gameplay's too)" : gameplays ? " (gameplay's camera has it too)" : "")
+                    .c_str());
+            ImGui::SameLine();
+            if (ImGui::SmallButton(known ? "Forget" : "The replay editor's"))
+                send(menu, callbacks, std::format("camera {} {}", known ? "remove" : "add", shake::hex(value)));
+            ImGui::PopID();
+        };
+        for (const auto& camera : view.cameras_seen) {
+            if (camera.director) offer("director", camera.director);
+            if (camera.vtable) offer("camera", camera.vtable);
+        }
+    }
+    info(menu, "Editor mapping", view.mapping);
+    if (!view.editor_problem.empty()) warn(view.editor_problem.c_str());
+    note("Step 3 (optional): map where the replay editor keeps its playhead and keyframes, with `ui dump` and "
+         "`replayshake map`, for a shake on each keyframe.");
+    end_card();
+}
+} // namespace
+
+void replay_page(SkateMenu& menu, const Model&, const CallbacksV3& callbacks) {
+    auto& p = page();
+    const auto view = shake::view();
+    ImGui::BeginDisabled(!callbacks.queue_console_command);
+
+    begin_card(menu, "replay-shake", "CAMERA SHAKE", "for the replay editor");
+    bool enabled = view->enabled;
+    if (toggle_row(menu, "Replay Shake", "Shake the replay editor's camera: one shake throughout, or one per keyframe.", enabled,
+            view->available))
+        send(menu, callbacks, enabled ? "on" : "off");
+    controller_toggle_row(menu, callbacks, p, *view);
+    bool gameplay = view->gameplay;
+    if (toggle_row(menu, "Shake gameplay too", "Off: a replay camera known by what gameplay's camera has too (its vtable, or "
+            "a director of gameplay's) shakes only while a game menu is up or the game hides its UI, as in the replay editor. "
+            "On: whenever it is on show.", gameplay, view->available))
+        send(menu, callbacks, gameplay ? "gameplay 1" : "gameplay 0");
+    info(menu, "Now", view->available ? view->status : std::string("Unavailable on this game build."));
+    if (view->playhead) info(menu, "Playhead", shake::seconds(*view->playhead));
+    if (!view->next_step.empty()) warn(view->next_step.c_str());
+    end_card();
+
+    begin_card(menu, "replay-default", "DEFAULT SHAKE",
+        view->keyframe_mode ? "keyframes without their own" : "the whole replay, until a key says otherwise");
+    shake_editor(menu, callbacks, p, "default", view->fallback, nullptr);
+    if (ImGui::Button("Reset the default")) send(menu, callbacks, "default reset");
+    end_card();
+
+    keyframes_card(menu, callbacks, p, *view);
+
+    begin_card(menu, "replay-export", "EXPORT");
+    field(menu, "Frame rate", "The export's frame rate, as picked in the replay editor: each frame of the video shakes "
+        "one step of it on, so the video shakes exactly as the editor showed.");
+    constexpr std::array<int, 3> rates{24, 30, 60};
+    int rate = static_cast<int>(std::find(rates.begin(), rates.end(), view->export_fps) - rates.begin());
+    if (rate == static_cast<int>(rates.size())) rate = -1; // a rate set in the console
+    if (choice(menu, "replay-fps", rate, {"24 fps", "30 fps", "60 fps"}) && rate >= 0)
+        send(menu, callbacks, std::format("fps {}", rates[static_cast<std::size_t>(rate)]));
+    info(menu, "Seed", std::to_string(view->seed));
+    if (ImGui::Button("Shake another way")) send(menu, callbacks, std::format("seed {}", view->seed + 1));
+    end_card();
+
+    setup_card(menu, callbacks, *view);
+
+    ImGui::EndDisabled();
+}
+} // namespace dingosdk::overlay::menu
diff --git a/Extension/ReplayShake/replay_shake_settings.cpp b/Extension/ReplayShake/replay_shake_settings.cpp
new file mode 100644
index 00000000..453478f8
--- /dev/null
+++ b/Extension/ReplayShake/replay_shake_settings.cpp
@@ -0,0 +1,703 @@
+#include "replay_shake_settings.h"
+#include <algorithm>
+#include <charconv>
+#include <cmath>
+#include <cstring>
+#include <format>
+#include <limits>
+
+namespace dingosdk::replay_shake {
+namespace {
+std::string lower(std::string_view text) {
+    std::string result(text);
+    for (auto& c : result)
+        if (c >= 'A' && c <= 'Z') c = static_cast<char>(c - 'A' + 'a');
+    return result;
+}
+// A number as typed, with an optional unit after it ("80%", "2.5hz", "3cm", "1.5s", "2deg").
+std::optional<double> number(std::string_view text) {
+    auto value = lower(text);
+    for (const std::string_view unit : {"%", "hz", "cm", "deg", "s"})
+        if (value.size() > unit.size() && value.ends_with(unit)) {
+            value.resize(value.size() - unit.size());
+            break;
+        }
+    double result{};
+    const auto* end = value.data() + value.size();
+    const auto [at, error] = std::from_chars(value.data(), end, result);
+    if (error != std::errc{} || at != end || !std::isfinite(result)) return std::nullopt;
+    return result;
+}
+std::optional<std::int64_t> whole(std::string_view text) {
+    std::int64_t result{};
+    const auto* end = text.data() + text.size();
+    const auto [at, error] = std::from_chars(text.data(), end, result);
+    if (error != std::errc{} || at != end) return std::nullopt;
+    return result;
+}
+void sort_keys(std::vector<Key>& keys) {
+    std::stable_sort(keys.begin(), keys.end(), [](const Key& a, const Key& b) { return a.time < b.time; });
+}
+std::optional<std::size_t> key_at(const std::vector<Key>& keys, double time) {
+    std::optional<std::size_t> best;
+    for (std::size_t i = 0; i < keys.size(); ++i) {
+        const double distance = std::abs(keys[i].time - time);
+        if (distance <= key_tolerance && (!best || distance < std::abs(keys[*best].time - time))) best = i;
+    }
+    return best;
+}
+bool keyframe_mode(const Editor& editor) { return editor.keyframes.has_value(); }
+
+// The settings of one shake a word changes: `default <setting> <value>` and `key <n> <setting> <value>`.
+constexpr std::string_view shake_settings =
+    "preset, intensity (%), frequency (Hz), roughness (%), pitch, yaw, roll (degrees), sideways, up, forward (cm), zoom (%)";
+// Changes `shake` (and `blend`, for a key) as the words say. Empty on success, else what was wrong.
+std::string edit(Shake& shake, Blend* blend, std::span<const std::string> words) {
+    if (words.size() < 2) return std::format("Give a setting and a value: {}{}.", shake_settings, blend ? ", blend" : "");
+    const auto setting = lower(words[0]);
+    if (setting == "preset") {
+        const auto preset = preset_named(words[1]);
+        if (!preset) return std::format("Unknown preset '{}'. Presets: handheld, walking, running, vehicle, earthquake, drift, custom.", words[1]);
+        apply_preset(shake, *preset);
+        return {};
+    }
+    if (setting == "blend") {
+        if (!blend) return "Only a keyframe has a blend: it says how its shake turns into the next keyframe's.";
+        const auto value = blend_named(words[1]);
+        if (!value) return "Blend is smooth, linear or hold.";
+        *blend = *value;
+        return {};
+    }
+    const auto value = number(words[1]);
+    if (!value) return std::format("'{}' is not a number.", words[1]);
+    const auto v = static_cast<float>(*value);
+    if (setting == "intensity") shake.intensity = v / 100.0f;
+    else if (setting == "frequency" || setting == "speed") shake.frequency = v;
+    else if (setting == "roughness") shake.roughness = v / 100.0f;
+    else {
+        std::optional<std::size_t> which;
+        for (std::size_t c = 0; c < channel_count; ++c)
+            if (setting == channel_names[c]) which = c;
+        if (!which) return std::format("Unknown setting '{}'. Settings: {}{}.", words[0], shake_settings, blend ? ", blend" : "");
+        // Moves are typed in centimetres and kept in metres.
+        const bool move = *which == channel::sideways || *which == channel::up || *which == channel::forward;
+        shake.amounts[*which] = move ? v / 100.0f : v;
+        shake.preset = Preset::custom;
+    }
+    shake = clamped(shake);
+    return {};
+}
+
+// Which key `key <which>` means, made if `create` and it is a keyframe without one. Sets `error`
+// when there is none; `label` names it for the reply.
+std::optional<std::size_t> target(Settings& settings, const Editor& editor, std::string_view which, bool create,
+    std::string& label, std::string& error) {
+    if (keyframe_mode(editor)) {
+        const auto& keyframes = *editor.keyframes;
+        std::optional<std::size_t> index;
+        if (lower(which) == "selected") {
+            if (!editor.selected || *editor.selected < 0 || static_cast<std::size_t>(*editor.selected) >= keyframes.size()) {
+                error = "No keyframe is selected in the replay editor.";
+                return std::nullopt;
+            }
+            index = static_cast<std::size_t>(*editor.selected);
+        } else if (const auto n = whole(which); n && *n >= 1 && static_cast<std::size_t>(*n) <= keyframes.size()) {
+            index = static_cast<std::size_t>(*n - 1);
+        } else {
+            error = keyframes.empty() ? "The replay has no keyframes yet."
+                                      : std::format("Keyframes are numbered 1 to {}.", keyframes.size());
+            return std::nullopt;
+        }
+        const double time = keyframes[*index];
+        label = std::format("Keyframe {} ({})", *index + 1, seconds(time));
+        if (const auto found = key_at(settings.keys, time)) return found;
+        if (!create) return std::nullopt; // no shake of its own: nothing to change
+        if (settings.keys.size() >= max_keys) {
+            error = std::format("Replay Shake keeps at most {} keyframe shakes; `replayshake clean` drops those of other replays.", max_keys);
+            return std::nullopt;
+        }
+        settings.keys.push_back({time, new_key_shake(settings.fallback), Blend::smooth});
+        sort_keys(settings.keys);
+        return key_at(settings.keys, time);
+    }
+    if (lower(which) == "selected") {
+        error = "The replay editor's keyframes are not readable yet (README.md, Finding the replay editor): use a key number.";
+        return std::nullopt;
+    }
+    const auto n = whole(which);
+    if (!n || *n < 1 || static_cast<std::size_t>(*n) > settings.keys.size()) {
+        error = settings.keys.empty() ? "There are no keys yet: `replayshake add` puts one at the playhead."
+                                      : std::format("Keys are numbered 1 to {}.", settings.keys.size());
+        return std::nullopt;
+    }
+    const auto index = static_cast<std::size_t>(*n - 1);
+    label = std::format("Key {} ({})", index + 1, seconds(settings.keys[index].time));
+    return index;
+}
+
+std::string reading_text(const Reading& reading) {
+    return std::format("{} {}{}", name(reading.format), reading.path.empty() ? std::string(".") : path_text(reading.path),
+        reading.scale == 1 ? std::string() : std::format(" x{}", reading.scale));
+}
+} // namespace
+std::string describe(const Mapping& mapping) {
+    if (!mapping.root) return "No replay editor mapping: `replayshake map root <schema>` starts one.";
+    std::string text = "root " + hex(mapping.root);
+    text += "; playhead " + (mapping.playhead.path.empty() ? std::string("unmapped") : reading_text(mapping.playhead));
+    text += "; keyframes " + (mapping.keyframes.empty() ? std::string("unmapped")
+        : path_text(mapping.keyframes) + ", time " + reading_text(mapping.keyframe_time));
+    text += "; selected " + (mapping.selected.path.empty() ? std::string("unmapped") : reading_text(mapping.selected));
+    return text;
+}
+namespace {
+// `map playhead f32 0xaa/0xbb [scale]` and its kin: format, path, then an optional scale.
+std::optional<Reading> parse_reading(std::span<const std::string> words, std::string& error) {
+    if (words.size() < 2) {
+        error = "Give a format (f32, f64, i32, u32, i64) and a path of field hashes, like f32 0x1a2b3c4d/0x5e6f7081.";
+        return std::nullopt;
+    }
+    Reading reading;
+    const auto format = format_named(words[0]);
+    if (!format) {
+        error = std::format("'{}' is not a format: f32, f64, i32, u32 or i64.", words[0]);
+        return std::nullopt;
+    }
+    reading.format = *format;
+    const auto path = parse_path(words[1]);
+    if (!path) {
+        error = std::format("'{}' is not a path of field hashes (0x1a2b3c4d/0x5e6f7081, or . for none).", words[1]);
+        return std::nullopt;
+    }
+    reading.path = *path;
+    if (words.size() > 2) {
+        const auto scale = number(words[2]);
+        if (!scale || *scale == 0) {
+            error = std::format("'{}' is not a scale: seconds are the value times the scale (0.001 for milliseconds).", words[2]);
+            return std::nullopt;
+        }
+        reading.scale = *scale;
+    }
+    return reading;
+}
+
+Reply map_command(Settings& settings, std::span<const std::string> words) {
+    auto& mapping = settings.mapping;
+    const auto part = words.empty() ? std::string("show") : lower(words[0]);
+    const auto rest = words.size() > 1 ? words.subspan(1) : std::span<const std::string>{};
+    std::string error;
+    if (part == "show") return {describe(mapping)};
+    if (part == "clear") {
+        const auto what = rest.empty() ? std::string("all") : lower(rest[0]);
+        if (what == "playhead") mapping.playhead = {};
+        else if (what == "keyframes") {
+            mapping.keyframes.clear();
+            mapping.keyframe_time = {};
+        }
+        else if (what == "selected") mapping.selected = {};
+        else if (what == "all") mapping = {};
+        else return {"Clear playhead, keyframes, selected or all."};
+        return {"Mapping: " + describe(mapping), true};
+    }
+    if (part == "root") {
+        std::optional<std::uint64_t> root;
+        if (!rest.empty()) root = parse_hex(rest[0]);
+        if (!root || !*root || *root > 0xffffffffULL) return {"Give the root view model's schema hash, like 0x1a2b3c4d."};
+        mapping.root = static_cast<std::uint32_t>(*root);
+        return {"Mapping: " + describe(mapping), true};
+    }
+    if (part == "playhead" || part == "selected") {
+        auto reading = parse_reading(rest, error);
+        if (!reading) return {error};
+        if (reading->path.empty()) return {"The " + part + " needs a path."};
+        (part == "playhead" ? mapping.playhead : mapping.selected) = std::move(*reading);
+        return {"Mapping: " + describe(mapping), true};
+    }
+    if (part == "keyframes") {
+        // map keyframes <array path> <format> <time path> [scale]
+        std::optional<std::vector<std::uint32_t>> array;
+        if (!rest.empty()) array = parse_path(rest[0]);
+        if (!array || array->empty())
+            return {"Give the keyframes' array path, then the format and path of the time in each, like "
+                    "map keyframes 0xaaaa/0xbbbb f32 0xcccc."};
+        auto reading = parse_reading(rest.subspan(1), error);
+        if (!reading) return {error};
+        mapping.keyframes = *array;
+        mapping.keyframe_time = std::move(*reading);
+        return {"Mapping: " + describe(mapping), true};
+    }
+    return {"Map root, playhead, keyframes, selected, show or clear."};
+}
+
+Reply camera_command(Settings& settings, std::span<const std::string> words) {
+    const auto action = words.empty() ? std::string("list") : lower(words[0]);
+    auto& cameras = settings.cameras;
+    if (action == "list") {
+        if (cameras.empty()) return {"No replay cameras added. `replayshake probe 1` logs the cameras on show."};
+        std::string text = "Replay cameras:";
+        for (const auto camera : cameras) text += " " + hex(camera);
+        return {text};
+    }
+    if (action == "clear") {
+        cameras.clear();
+        return {"Replay cameras cleared.", true};
+    }
+    std::optional<std::uint64_t> value;
+    if (words.size() > 1) value = parse_hex(words[1]);
+    if ((action != "add" && action != "remove") || !value || !*value || *value > 0x7fffffffULL)
+        return {"camera add|remove <a vtable offset Probe shows, of a camera or its director: 0x...>, camera list or camera clear."};
+    const auto offset = static_cast<std::uintptr_t>(*value);
+    const auto found = std::find(cameras.begin(), cameras.end(), offset);
+    if (action == "add") {
+        if (found != cameras.end()) return {hex(offset) + " is already a replay camera."};
+        if (cameras.size() >= max_cameras) return {std::format("At most {} replay cameras.", max_cameras)};
+        cameras.push_back(offset);
+        return {hex(offset) + " is a replay camera: the shake shows while it is on show.", true};
+    }
+    if (found == cameras.end()) return {hex(offset) + " is not a replay camera."};
+    cameras.erase(found);
+    return {hex(offset) + " removed.", true};
+}
+
+std::string list_text(const Settings& settings, const Editor& editor) {
+    std::string text;
+    if (keyframe_mode(editor)) {
+        const auto& keyframes = *editor.keyframes;
+        if (keyframes.empty()) return "The replay has no keyframes: the default shake runs throughout (" +
+            describe(settings.fallback) + ").";
+        for (std::size_t i = 0; i < keyframes.size(); ++i) {
+            const auto found = key_at(settings.keys, keyframes[i]);
+            text += std::format("{}Keyframe {} at {}: {}", i ? "\n" : "", i + 1, seconds(keyframes[i]),
+                found ? describe(settings.keys[*found].shake) + ", " + std::string(name(settings.keys[*found].blend))
+                      : "default (" + describe(settings.fallback) + ")");
+        }
+        return text;
+    }
+    if (settings.keys.empty()) return "No keys: the default shake runs throughout (" + describe(settings.fallback) + ").";
+    for (std::size_t i = 0; i < settings.keys.size(); ++i)
+        text += std::format("{}Key {} at {}: {}, {}", i ? "\n" : "", i + 1, seconds(settings.keys[i].time),
+            describe(settings.keys[i].shake), name(settings.keys[i].blend));
+    return text;
+}
+
+// JSON. Floats are written rounded, so 0.6 is saved as 0.6 and not 0.6000000238418579.
+double tidy(float value) { return std::round(static_cast<double>(value) * 1e5) / 1e5; }
+Json shake_json(const Shake& shake) {
+    Json json = Json::object();
+    json["preset"] = std::string(name(shake.preset));
+    json["intensity"] = tidy(shake.intensity);
+    json["frequency"] = tidy(shake.frequency);
+    json["roughness"] = tidy(shake.roughness);
+    std::array<double, channel_count> amounts{};
+    for (std::size_t c = 0; c < channel_count; ++c) amounts[c] = tidy(shake.amounts[c]);
+    json["amounts"] = Json(amounts);
+    return json;
+}
+template <class T> void read_number(const Json& json, std::string_view key, T& out) {
+    if (!json.is_object() || !json.contains(key) || !json.at(key).is_number()) return;
+    const auto value = json.at(key).get<double>();
+    if (std::isfinite(value)) out = static_cast<T>(value);
+}
+Shake shake_from(const Json& json, const Shake& base) {
+    Shake shake = base;
+    if (!json.is_object()) return shake;
+    if (json.contains("preset") && json.at("preset").is_string())
+        if (const auto preset = preset_named(json.at("preset").string())) shake.preset = *preset;
+    read_number(json, "intensity", shake.intensity);
+    read_number(json, "frequency", shake.frequency);
+    read_number(json, "roughness", shake.roughness);
+    if (json.contains("amounts") && json.at("amounts").is_array()) {
+        const auto& amounts = json.at("amounts");
+        for (std::size_t c = 0; c < channel_count && c < amounts.size(); ++c)
+            if (amounts.at(c).is_number()) shake.amounts[c] = amounts.at(c).get<float>();
+    }
+    return clamped(shake);
+}
+Json hex_array(std::span<const std::uint32_t> values) {
+    Json json = Json::array();
+    for (const auto value : values) json.push_back(Json(hex(value)));
+    return json;
+}
+std::optional<std::uint64_t> hex_value(const Json& json) {
+    if (json.is_string()) return parse_hex(json.string());
+    if (json.is_number_integer()) return json.get<std::uint64_t>();
+    return std::nullopt;
+}
+std::vector<std::uint32_t> path_from(const Json& json) {
+    std::vector<std::uint32_t> path;
+    if (!json.is_array()) return path;
+    for (const auto& item : json) {
+        const auto value = hex_value(item);
+        if (!value || *value > 0xffffffffULL || path.size() >= max_path) return {};
+        path.push_back(static_cast<std::uint32_t>(*value));
+    }
+    return path;
+}
+Json reading_json(const Reading& reading) {
+    Json json = Json::object();
+    json["path"] = hex_array(reading.path);
+    json["format"] = std::string(name(reading.format));
+    json["scale"] = reading.scale;
+    return json;
+}
+Reading reading_from(const Json& json) {
+    Reading reading;
+    if (!json.is_object()) return reading;
+    if (json.contains("path")) reading.path = path_from(json.at("path"));
+    if (json.contains("format") && json.at("format").is_string())
+        if (const auto format = format_named(json.at("format").string())) reading.format = *format;
+    read_number(json, "scale", reading.scale);
+    if (reading.scale == 0) reading.scale = 1;
+    return reading;
+}
+} // namespace
+
+std::optional<Format> format_named(std::string_view text) noexcept {
+    for (std::size_t i = 0; i < format_names.size(); ++i)
+        if (format_names[i] == text) return static_cast<Format>(i);
+    return std::nullopt;
+}
+std::string_view name(Format format) noexcept {
+    const auto index = static_cast<std::size_t>(format);
+    return index < format_names.size() ? format_names[index] : "f32";
+}
+std::size_t size(Format format) noexcept {
+    return format == Format::f64 || format == Format::i64 ? 8 : 4;
+}
+double decode(Format format, const void* bytes) noexcept {
+    switch (format) {
+    case Format::f64: { double v; std::memcpy(&v, bytes, 8); return v; }
+    case Format::i32: { std::int32_t v; std::memcpy(&v, bytes, 4); return v; }
+    case Format::u32: { std::uint32_t v; std::memcpy(&v, bytes, 4); return v; }
+    case Format::i64: { std::int64_t v; std::memcpy(&v, bytes, 8); return static_cast<double>(v); }
+    default: { float v; std::memcpy(&v, bytes, 4); return v; }
+    }
+}
+
+Shake default_shake() noexcept {
+    auto shake = preset_shake(Preset::handheld);
+    shake.intensity = 0;
+    return shake;
+}
+Shake new_key_shake(const Shake& fallback) noexcept {
+    auto shake = fallback;
+    if (!(shake.intensity > 0)) shake.intensity = 1;
+    return clamped(shake);
+}
+
+Json to_json(const Settings& settings) {
+    Json json = Json::object();
+    json["version"] = 1;
+    json["enabled"] = settings.enabled;
+    json["seed"] = settings.seed;
+    json["export_fps"] = settings.export_fps;
+    json["default"] = shake_json(settings.fallback);
+    Json keys = Json::array();
+    for (const auto& key : settings.keys) {
+        Json item = Json::object();
+        item["time"] = key.time;
+        item["blend"] = std::string(name(key.blend));
+        item["shake"] = shake_json(key.shake);
+        keys.push_back(std::move(item));
+    }
+    json["keys"] = std::move(keys);
+    Json cameras = Json::array();
+    for (const auto camera : settings.cameras) cameras.push_back(Json(hex(camera)));
+    json["cameras"] = std::move(cameras);
+    json["cameras_build"] = settings.cameras_build;
+    json["gameplay"] = settings.gameplay;
+    json["toggle"] = hex(settings.toggle);
+    Json mapping = Json::object();
+    mapping["root"] = hex(settings.mapping.root);
+    mapping["playhead"] = reading_json(settings.mapping.playhead);
+    mapping["keyframes"] = hex_array(settings.mapping.keyframes);
+    mapping["keyframe_time"] = reading_json(settings.mapping.keyframe_time);
+    mapping["selected"] = reading_json(settings.mapping.selected);
+    json["mapping"] = std::move(mapping);
+    return json;
+}
+
+Settings settings_from_json(const Json& json) {
+    Settings settings;
+    if (!json.is_object()) return settings;
+    try {
+        if (json.contains("enabled") && json.at("enabled").is_boolean()) settings.enabled = json.at("enabled").get<bool>();
+        double seed = settings.seed;
+        read_number(json, "seed", seed);
+        if (seed >= 0 && seed <= 0xffffffff) settings.seed = static_cast<std::uint32_t>(seed);
+        double fps = settings.export_fps;
+        read_number(json, "export_fps", fps);
+        if (fps >= 1 && fps <= max_export_fps) settings.export_fps = static_cast<int>(fps);
+        if (json.contains("default")) settings.fallback = shake_from(json.at("default"), settings.fallback);
+        if (json.contains("keys") && json.at("keys").is_array())
+            for (const auto& item : json.at("keys")) {
+                if (!item.is_object() || settings.keys.size() >= max_keys) continue;
+                Key key;
+                key.time = std::numeric_limits<double>::quiet_NaN();
+                read_number(item, "time", key.time);
+                if (!std::isfinite(key.time)) continue;
+                if (item.contains("blend") && item.at("blend").is_string())
+                    if (const auto blend = blend_named(item.at("blend").string())) key.blend = *blend;
+                key.shake = item.contains("shake") ? shake_from(item.at("shake"), new_key_shake(settings.fallback))
+                                                   : new_key_shake(settings.fallback);
+                settings.keys.push_back(key);
+            }
+        sort_keys(settings.keys);
+        if (json.contains("cameras") && json.at("cameras").is_array())
+            for (const auto& item : json.at("cameras")) {
+                const auto value = hex_value(item);
+                if (value && *value && *value <= 0x7fffffffULL && settings.cameras.size() < max_cameras &&
+                    std::find(settings.cameras.begin(), settings.cameras.end(), *value) == settings.cameras.end())
+                    settings.cameras.push_back(static_cast<std::uintptr_t>(*value));
+            }
+        if (json.contains("cameras_build") && json.at("cameras_build").is_string() && json.at("cameras_build").string().size() <= 32)
+            settings.cameras_build = json.at("cameras_build").string();
+        if (json.contains("gameplay") && json.at("gameplay").is_boolean()) settings.gameplay = json.at("gameplay").get<bool>();
+        if (json.contains("toggle"))
+            if (const auto toggle = hex_value(json.at("toggle")); toggle && *toggle <= 0xffffffffULL &&
+                valid_action_binding(static_cast<std::uint32_t>(*toggle)))
+                settings.toggle = static_cast<std::uint32_t>(*toggle);
+        if (json.contains("mapping") && json.at("mapping").is_object()) {
+            const auto& mapping = json.at("mapping");
+            if (mapping.contains("root"))
+                if (const auto root = hex_value(mapping.at("root")); root && *root <= 0xffffffffULL)
+                    settings.mapping.root = static_cast<std::uint32_t>(*root);
+            if (mapping.contains("playhead")) settings.mapping.playhead = reading_from(mapping.at("playhead"));
+            if (mapping.contains("keyframes")) settings.mapping.keyframes = path_from(mapping.at("keyframes"));
+            if (mapping.contains("keyframe_time")) settings.mapping.keyframe_time = reading_from(mapping.at("keyframe_time"));
+            if (mapping.contains("selected")) settings.mapping.selected = reading_from(mapping.at("selected"));
+        }
+    } catch (const std::exception&) {
+        // A value of the wrong type: the rest stays at its default.
+    }
+    return settings;
+}
+
+std::vector<Point> points(const Settings& settings, const Editor& editor) {
+    if (!editor.playhead) return {};
+    if (editor.keyframes) {
+        if (editor.keyframes->empty()) return {};
+        return timeline(*editor.keyframes, settings.keys, settings.fallback);
+    }
+    return timeline({}, settings.keys, settings.fallback);
+}
+
+Reply command(Settings& settings, std::string_view verb, std::span<const std::string> words, const Editor& editor) {
+    const auto v = lower(verb);
+    if (v == "on" || v == "off" || v == "toggle") {
+        const bool on = v == "toggle" ? !settings.enabled : v == "on";
+        const bool changed = settings.enabled != on;
+        settings.enabled = on;
+        return {on ? "Replay Shake is on." : "Replay Shake is off.", changed};
+    }
+    if (v == "bind") {
+        std::string typed; // "lb + rb" typed with spaces is one combo
+        for (const auto& word : words) typed += word;
+        if (typed.empty())
+            return {settings.toggle ? std::format("{} switches Replay Shake on or off while the replay editor is open.",
+                                          controller_combo_label(settings.toggle))
+                                    : "No button switches Replay Shake on or off: `replayshake bind LB+RB` (or Record on the "
+                                      "REPLAY SHAKE page) puts it on a controller combo, and `replayshake bind clear` takes it off."};
+        const auto low = lower(typed);
+        const auto binding = low == "clear" || low == "none" || low == "off" ? std::optional<std::uint32_t>(0) : parse_binding(typed);
+        if (!binding)
+            return {"bind <combo>: buttons joined with +, such as LB+RB, L3+R3 or Back+Y (PlayStation names too), or clear."};
+        const bool changed = settings.toggle != *binding;
+        settings.toggle = *binding;
+        return {*binding ? std::format("{} now switches Replay Shake on or off while the replay editor is open.",
+                               controller_combo_label(*binding))
+                         : std::string("No button switches Replay Shake now."),
+            changed};
+    }
+    if (v == "default") {
+        if (!words.empty() && lower(words[0]) == "reset") {
+            settings.fallback = default_shake();
+            return {"Default shake reset: " + describe(settings.fallback) + ".", true};
+        }
+        if (words.empty()) return {"Default shake: " + describe(settings.fallback) + "."};
+        auto shake = settings.fallback;
+        if (const auto error = edit(shake, nullptr, words); !error.empty()) return {error};
+        const bool changed = !(shake == settings.fallback);
+        settings.fallback = shake;
+        return {"Default shake: " + describe(shake) + ".", changed};
+    }
+    if (v == "key") {
+        if (words.empty()) return {"key <number|selected> <setting> <value>, or key <number|selected> reset."};
+        std::string label, error;
+        const bool reset = words.size() > 1 && lower(words[1]) == "reset";
+        if (reset) {
+            const auto index = target(settings, editor, words[0], false, label, error);
+            if (!error.empty()) return {error};
+            if (!index) return {label + " has no shake of its own."};
+            settings.keys.erase(settings.keys.begin() + static_cast<std::ptrdiff_t>(*index));
+            return {label + (keyframe_mode(editor) ? " is back to the default shake." : " removed."), true};
+        }
+        if (words.size() == 1) {
+            const auto index = target(settings, editor, words[0], false, label, error);
+            if (!error.empty()) return {error};
+            return {label + ": " + (index ? describe(settings.keys[*index].shake) + ", " +
+                std::string(name(settings.keys[*index].blend)) : "default (" + describe(settings.fallback) + ")")};
+        }
+        const auto before = settings.keys;
+        const auto index = target(settings, editor, words[0], true, label, error);
+        if (!index) return {error.empty() ? label + " has no shake." : error};
+        auto& key = settings.keys[*index];
+        if (const auto problem = edit(key.shake, &key.blend, words.subspan(1)); !problem.empty()) {
+            settings.keys = before; // a keyframe given a shake only to fail to set it keeps none
+            return {problem};
+        }
+        return {label + ": " + describe(key.shake) + ", " + std::string(name(key.blend)) + ".", true};
+    }
+    if (v == "add") {
+        if (keyframe_mode(editor))
+            return {"The replay editor's keyframes are readable: give one a shake with `replayshake key <number> ...`."};
+        std::optional<double> time = editor.playhead;
+        if (!words.empty()) time = number(words[0]);
+        if (!time) return {words.empty() ? "The playhead is not readable yet: give a time in seconds, like `replayshake add 2.5`."
+                                         : "Give the time in seconds."};
+        if (key_at(settings.keys, *time)) return {"There is a key at " + seconds(*time) + " already."};
+        if (settings.keys.size() >= max_keys) return {std::format("At most {} keys.", max_keys)};
+        settings.keys.push_back({*time, new_key_shake(settings.fallback), Blend::smooth});
+        sort_keys(settings.keys);
+        const auto index = key_at(settings.keys, *time).value_or(0);
+        return {std::format("Key {} at {}: {}.", index + 1, seconds(*time), describe(settings.keys[index].shake)), true};
+    }
+    if (v == "remove") {
+        if (words.empty()) return {"remove <number>"};
+        std::string label, error;
+        const auto index = target(settings, editor, words[0], false, label, error);
+        if (!error.empty()) return {error};
+        if (!index) return {label + " has no shake of its own."};
+        settings.keys.erase(settings.keys.begin() + static_cast<std::ptrdiff_t>(*index));
+        return {label + (keyframe_mode(editor) ? " is back to the default shake." : " removed."), true};
+    }
+    if (v == "clear") {
+        const bool changed = !settings.keys.empty();
+        settings.keys.clear();
+        return {"Every keyframe shake removed.", changed};
+    }
+    if (v == "clean") {
+        if (!keyframe_mode(editor)) return {"Clean needs the replay editor's keyframes (it keeps the shakes on them)."};
+        const auto before = settings.keys.size();
+        std::erase_if(settings.keys, [&](const Key& key) { return !keyframe_at(*editor.keyframes, key.time); });
+        const auto removed = before - settings.keys.size();
+        return {std::format("Removed {} shake{} on no keyframe of this replay.", removed, removed == 1 ? "" : "s"), removed > 0};
+    }
+    if (v == "seed") {
+        if (words.empty()) return {std::format("Seed {}.", settings.seed)};
+        const auto seed = whole(words[0]);
+        if (!seed || *seed < 0 || *seed > 0xffffffffLL) return {"The seed is a whole number from 0 to 4294967295."};
+        const bool changed = settings.seed != static_cast<std::uint32_t>(*seed);
+        settings.seed = static_cast<std::uint32_t>(*seed);
+        return {std::format("Seed {}: the same settings now shake another way.", settings.seed), changed};
+    }
+    if (v == "fps") {
+        if (words.empty()) return {std::format("Exports at {} frames a second.", settings.export_fps)};
+        const auto fps = whole(words[0]);
+        if (!fps || *fps < 1 || *fps > max_export_fps)
+            return {std::format("fps is the export's frame rate: 24, 30 or 60 (at most {}).", max_export_fps)};
+        const bool changed = settings.export_fps != static_cast<int>(*fps);
+        settings.export_fps = static_cast<int>(*fps);
+        return {std::format("Exports at {} frames a second.", settings.export_fps), changed};
+    }
+    if (v == "gameplay") {
+        const auto word = words.empty() ? std::string() : lower(words[0]);
+        if (word.empty())
+            return {settings.gameplay ? "Gameplay shakes too." : "Only the replay editor shakes: gameplay stays still."};
+        const bool on = word == "1" || word == "on" || word == "true";
+        if (!on && word != "0" && word != "off" && word != "false") return {"gameplay 0|1"};
+        const bool changed = settings.gameplay != on;
+        settings.gameplay = on;
+        return {on ? "Gameplay shakes too, whenever a replay camera is on show."
+                   : "Only the replay editor shakes: while a game menu is up or the game hides its UI. Gameplay stays still.",
+            changed};
+    }
+    if (v == "camera") return camera_command(settings, words);
+    if (v == "map") return map_command(settings, words);
+    if (v == "presets") {
+        std::string text = "Presets:";
+        for (std::size_t i = 0; i + 1 < preset_names.size(); ++i)
+            text += std::format(" {} ({})", preset_names[i], describe(preset_shake(static_cast<Preset>(i))));
+        return {text + "; custom keeps its own values."};
+    }
+    if (v == "list") return {list_text(settings, editor)};
+    return {std::format("Unknown verb '{}'. Verbs: on, off, toggle, bind, default, key, add, remove, clear, clean, seed, fps, "
+        "camera, map, presets, list, gameplay, status, test, probe, history, copies, passes, after, source.", verb)};
+}
+
+std::string describe(const Shake& shake) {
+    return std::format("{} {:.0f}%, {:.2g} Hz", name(shake.preset), shake.intensity * 100.0f, shake.frequency);
+}
+std::string seconds(double value) { return std::format("{:.2f} s", value); }
+std::string hex(std::uint64_t value) { return std::format("0x{:x}", value); }
+std::optional<std::uint64_t> parse_hex(std::string_view text) noexcept {
+    if (text.size() > 2 && text[0] == '0' && (text[1] == 'x' || text[1] == 'X')) text.remove_prefix(2);
+    if (text.empty() || text.size() > 16) return std::nullopt;
+    std::uint64_t value{};
+    const auto* end = text.data() + text.size();
+    const auto [at, error] = std::from_chars(text.data(), end, value, 16);
+    if (error != std::errc{} || at != end) return std::nullopt;
+    return value;
+}
+std::optional<std::uint32_t> parse_binding(std::string_view text) {
+    std::string squeezed; // its names without spaces, dashes or underscores: "d-pad up" is "dpadup"
+    for (const char c : lower(text))
+        if (c != ' ' && c != '-' && c != '_') squeezed += c;
+    if (squeezed.empty()) return std::nullopt;
+    // A number, as ReSkate's own `bind` commands take it (decimal, or 0x hex).
+    if (squeezed.find_first_not_of("0123456789") == std::string::npos ||
+        (squeezed.starts_with("0x") && squeezed.size() > 2 && squeezed.find_first_not_of("0123456789abcdef", 2) == std::string::npos)) {
+        const auto value = squeezed.starts_with("0x") ? parse_hex(squeezed) : [&]() -> std::optional<std::uint64_t> {
+            const auto number_value = whole(squeezed);
+            if (!number_value || *number_value < 0) return std::nullopt;
+            return static_cast<std::uint64_t>(*number_value);
+        }();
+        if (!value || *value > 0xffffffffULL || !valid_action_binding(static_cast<std::uint32_t>(*value))) return std::nullopt;
+        return static_cast<std::uint32_t>(*value);
+    }
+    // Buttons by name (controller_bindings.h's bits: the XInput buttons, the triggers above them).
+    struct Name {
+        std::string_view name;
+        std::uint32_t bit;
+    };
+    constexpr Name names[]{{"lb", 0x100}, {"l1", 0x100}, {"rb", 0x200}, {"r1", 0x200}, {"lt", 0x10000}, {"l2", 0x10000},
+        {"rt", 0x20000}, {"r2", 0x20000}, {"l3", 0x40}, {"ls", 0x40}, {"r3", 0x80}, {"rs", 0x80}, {"a", 0x1000},
+        {"cross", 0x1000}, {"b", 0x2000}, {"circle", 0x2000}, {"x", 0x4000}, {"square", 0x4000}, {"y", 0x8000},
+        {"triangle", 0x8000}, {"up", 1}, {"dpadup", 1}, {"down", 2}, {"dpaddown", 2}, {"left", 4}, {"dpadleft", 4},
+        {"right", 8}, {"dpadright", 8}, {"start", 0x10}, {"options", 0x10}, {"menu", 0x10}, {"back", 0x20},
+        {"view", 0x20}, {"share", 0x20}, {"create", 0x20}, {"select", 0x20}};
+    std::uint32_t combo{};
+    std::string_view rest = squeezed;
+    while (true) {
+        const auto plus = rest.find('+');
+        const auto part = rest.substr(0, plus);
+        const auto found = std::find_if(std::begin(names), std::end(names), [&](const Name& entry) { return entry.name == part; });
+        if (found == std::end(names) || (combo & found->bit)) return std::nullopt;
+        combo |= found->bit;
+        if (plus == std::string_view::npos) break;
+        rest.remove_prefix(plus + 1);
+    }
+    if (!valid_controller_combo(combo)) return std::nullopt;
+    return combo;
+}
+std::optional<std::vector<std::uint32_t>> parse_path(std::string_view text) {
+    std::vector<std::uint32_t> path;
+    if (text == ".") return path;
+    while (!text.empty()) {
+        const auto slash = text.find('/');
+        const auto part = text.substr(0, slash);
+        const auto value = parse_hex(part);
+        if (!value || *value > 0xffffffffULL || path.size() >= max_path) return std::nullopt;
+        path.push_back(static_cast<std::uint32_t>(*value));
+        if (slash == std::string_view::npos) break;
+        text.remove_prefix(slash + 1);
+        if (text.empty()) return std::nullopt; // a trailing slash
+    }
+    if (path.empty()) return std::nullopt;
+    return path;
+}
+std::string path_text(std::span<const std::uint32_t> path) {
+    std::string text;
+    for (std::size_t i = 0; i < path.size(); ++i) text += (i ? "/" : "") + hex(path[i]);
+    return text;
+}
+} // namespace dingosdk::replay_shake
diff --git a/Extension/ReplayShake/replay_shake_settings.h b/Extension/ReplayShake/replay_shake_settings.h
new file mode 100644
index 00000000..c9bc8c27
--- /dev/null
+++ b/Extension/ReplayShake/replay_shake_settings.h
@@ -0,0 +1,114 @@
+#pragma once
+#include "replay_shake_model.h"
+#include "Engine/Core/Json/json.h"
+#include "Engine/Game/Input/controller_bindings.h"
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Replay Shake's settings and its `replayshake` console verbs, with no game access: what is saved
+// with the profile, and what each verb does to it given what the client tick last read of the
+// replay editor. The runtime (replay_shake.h) owns the one live copy and calls these on the game
+// thread; the tests call them directly.
+namespace dingosdk::replay_shake {
+// How a number the replay editor shows is stored in the game's UI model.
+enum class Format : std::uint8_t { f32, f64, i32, u32, i64, count };
+inline constexpr std::array<std::string_view, static_cast<std::size_t>(Format::count)> format_names{
+    "f32", "f64", "i32", "u32", "i64"};
+std::optional<Format> format_named(std::string_view text) noexcept;
+std::string_view name(Format format) noexcept;
+std::size_t size(Format format) noexcept;
+// The number stored in `bytes` (little-endian, size(format) of them).
+double decode(Format format, const void* bytes) noexcept;
+
+// A number in the replay editor's UI model: the fields to follow from where it starts, how it is
+// stored, and what it is multiplied by to give seconds.
+struct Reading {
+    std::vector<std::uint32_t> path; // field name hashes, as `ui dump` prints them
+    Format format = Format::f32;
+    double scale = 1;
+    bool operator==(const Reading&) const = default;
+};
+// Where the replay editor keeps what Replay Shake reads, in the game's UI model. Not known in code:
+// each player finds it with the game's own `ui dump` (README.md) and sets it with `replayshake map`.
+struct Mapping {
+    std::uint32_t root{};                 // schema hash of the root view model every path starts from
+    Reading playhead;                     // the replay time on show
+    std::vector<std::uint32_t> keyframes; // an array: one element per keyframe
+    Reading keyframe_time;                // from each element (no path: the element itself) its time
+    Reading selected;                     // the index, from 0, of the keyframe being edited (-1 none)
+    bool operator==(const Mapping&) const = default;
+};
+
+// Handheld at intensity 0: nothing shakes until it is turned up or a keyframe is given a shake.
+Shake default_shake() noexcept;
+// A keyframe given its own shake starts as the default, turned up to full if the default is off.
+Shake new_key_shake(const Shake& fallback) noexcept;
+
+struct Settings {
+    bool enabled = true;
+    Shake fallback = default_shake(); // keyframes without their own shake; the whole replay without keyframes
+    std::uint32_t seed = 1;           // which noise: another seed, another shake with the same settings
+    std::vector<Key> keys;            // sorted by time
+    int export_fps = 60;              // frames a second of an export: the game offers 24, 30 and 60
+    // The replay editor's cameras, as vtable offsets in Skate.exe: of a camera, or of a camera's
+    // director (what moves it, replay_shake_editor.h)...
+    std::vector<std::uintptr_t> cameras;
+    std::string cameras_build; // ...of this game build (Steam build id): another build moves them
+    // Shake gameplay too. Off, a replay camera on show shakes only while a game menu is up or the
+    // game hides its UI, as in the replay editor (skate.'s cameras share one vtable, gameplay's too).
+    bool gameplay = false;
+    // The controller combo (or keyboard key or chord) that switches Replay Shake on or off while the
+    // replay editor is open, kept as ReSkate keeps its own action binds (controller_bindings.h: the
+    // XInput button bits, the triggers above them); 0 none.
+    std::uint32_t toggle{};
+    Mapping mapping;
+};
+inline constexpr int max_export_fps = 240;
+inline constexpr std::size_t max_cameras = 16, max_path = 16;
+
+Json to_json(const Settings& settings);
+// Whatever it can read; anything missing or out of range stays at its default.
+Settings settings_from_json(const Json& json);
+
+// What the client tick last read of the replay editor.
+struct Editor {
+    bool open{};                                  // a replay camera is on show
+    std::optional<double> playhead;               // seconds
+    std::optional<std::vector<double>> keyframes; // seconds, as the editor lists them (none: not readable)
+    std::optional<int> selected;                  // index into keyframes
+};
+// The timeline to shake by. Keyframes and keys sit on the replay's timeline, so without its
+// playhead there is none: the default throughout. With it, one point per keyframe while the
+// editor's keyframes can be read (none there: the default throughout), otherwise the free keys.
+std::vector<Point> points(const Settings& settings, const Editor& editor);
+
+struct Reply {
+    std::string text;
+    bool changed{}; // the settings changed: save them
+};
+// One `replayshake` verb and the words after it.
+Reply command(Settings& settings, std::string_view verb, std::span<const std::string> words, const Editor& editor);
+// The verbs command() takes, for the console's completion and help.
+inline constexpr std::array<std::string_view, 17> verbs{"on", "off", "toggle", "bind", "default", "key", "add", "remove", "clear",
+    "clean", "seed", "fps", "camera", "map", "presets", "list", "gameplay"};
+// A controller combo by its buttons' names joined with +, "LB+RB" (Xbox's names or PlayStation's, any
+// case: LB RB LT RT L3 R3 A B X Y Up Down Left Right Start Back, L1 R1 L2 R2 Cross Circle Square
+// Triangle Options Share Create), or a binding as ReSkate keeps it (a number, as its own `bind`
+// commands take it); "0" is none. Nothing when it is neither, or no combo ReSkate can hold.
+std::optional<std::uint32_t> parse_binding(std::string_view text);
+
+// Text forms used by the commands, the menu and the log.
+std::string describe(const Shake& shake);
+std::string describe(const Mapping& mapping);
+std::string seconds(double value);
+std::string hex(std::uint64_t value);
+std::optional<std::uint64_t> parse_hex(std::string_view text) noexcept;
+// "0x1a2b3c4d/0x5e6f7081": field hashes separated by slashes; "." is an empty path.
+std::optional<std::vector<std::uint32_t>> parse_path(std::string_view text);
+std::string path_text(std::span<const std::uint32_t> path);
+} // namespace dingosdk::replay_shake
diff --git a/Extension/ReplayShake/replay_shake_view.cpp b/Extension/ReplayShake/replay_shake_view.cpp
new file mode 100644
