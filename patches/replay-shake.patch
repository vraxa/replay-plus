@@ -0,0 +1,200 @@
+#include "game_view_hook.h"
+#include "Engine/Core/Hooks/hooks.h"
+#include "Engine/Core/Log/logging.h"
+#include "Engine/Core/Platform/memory.h"
+#include "Engine/Game/Build/supported_build.h"
+#include <Windows.h>
+#include <array>
+#include <atomic>
+#include <mutex>
+
+namespace dingosdk::replay_shake::game_view {
+namespace {
+// Skate.exe of Steam build 25414733, each function found by its bytes (another build's are others,
+// and the hook is then unavailable):
+// - fill, (description, id, settings, camera view, beside, view): fills a view description in for a
+//   camera view (0x1240 bytes, the game's own list of the views it draws: its first view at +0, the
+//   local player's index of the camera view at +0x1150) from its view settings (field of view, near
+//   and far...: 0x3e743a0 and others) and the two transforms (0x90 bytes each, Transform): `beside`
+//   copied to the description's +0x1160, `view` set as the first view's transform last of all
+//   (0x3e745a0). Called once for each camera view the game draws, each frame, by the game's building
+//   of its views (0x3eb88f0) only, which keeps neither pointer.
+// - override, (description, context): the replay camera's say on a description just filled in, which
+//   the building of the views calls right after each fill through a function the game registers at
+//   start (0x4bd4e0). While the replay camera is on (its object's +0x28), it sets the first view's
+//   transform anew (0x3e745a0) from what that camera works out (0x4c72d0); otherwise it leaves it.
+// - set_transform, (view, transform): a view's transform (+0 to +0x90) and the view marked changed
+//   (+0x140), unless it holds that transform already.
+// - set_fov, (view, fov): a view's vertical field of view (+0x104, radians), the horizontal one worked
+//   out from it and the view's aspect (+0x2b0, from +0x11c), and the view marked changed (+0x140).
+struct Target {
+    const char* name;
+    std::uintptr_t rva;
+    std::array<unsigned char, 32> bytes;
+};
+enum Which : std::size_t { fill_at, override_at, set_transform_at, set_fov_at, target_count };
+constexpr std::size_t hooked_count = 2; // fill and override; the setters are only called
+constexpr std::array<Target, target_count> targets{{
+    {"filling-in of a view it draws", 0x3ef19c0, {
+        0x48, 0x8b, 0xc4, 0x56, 0x57, 0x41, 0x56, 0x41, 0x57, 0x48, 0x81, 0xec, 0x08, 0x01, 0x00, 0x00,
+        0x48, 0x89, 0x58, 0x18, 0x48, 0x8b, 0xf9, 0x48, 0x8b, 0x0d, 0x12, 0x41, 0x4a, 0x03, 0x44, 0x0f}},
+    {"replay camera's setting of a view", 0x4b9550, {
+        0x48, 0x89, 0x5c, 0x24, 0x10, 0x48, 0x89, 0x74, 0x24, 0x18, 0x55, 0x41, 0x56, 0x41, 0x57, 0x48,
+        0x8d, 0x6c, 0x24, 0xb0, 0x48, 0x81, 0xec, 0x50, 0x01, 0x00, 0x00, 0x48, 0x83, 0x3d, 0xe5, 0x8b}},
+    {"setting of a view's transform", 0x3e745a0, {
+        0xc5, 0xf8, 0x10, 0x02, 0xc5, 0xf8, 0xc2, 0x09, 0x00, 0xc5, 0xf8, 0x50, 0xc1, 0x83, 0xe0, 0x07,
+        0x3c, 0x07, 0x75, 0x5e, 0xc5, 0xf8, 0x10, 0x42, 0x10, 0xc5, 0xf8, 0xc2, 0x49, 0x10, 0x00, 0xc5}},
+    {"setting of a view's field of view", 0x3e743a0, {
+        0x40, 0x53, 0x48, 0x83, 0xec, 0x20, 0xc5, 0xfa, 0x10, 0x81, 0x04, 0x01, 0x00, 0x00, 0xc5, 0xf8,
+        0x2e, 0xc1, 0xc5, 0xf8, 0x28, 0xd1, 0x48, 0x8b, 0xd9, 0x7a, 0x02, 0x74, 0x28, 0xc5, 0xfa, 0x10}},
+}};
+// Every register argument as it came (the id is a word the game widened; the rest are pointers).
+using Fill = void (*)(std::uintptr_t description, std::uintptr_t id, std::uintptr_t settings, std::uintptr_t camera_view,
+    std::uintptr_t beside, std::uintptr_t view);
+using Override = void (*)(std::uintptr_t description, std::uintptr_t context);
+using SetTransform = void (*)(std::uintptr_t view, const Transform* transform);
+using SetFov = void (*)(std::uintptr_t view, float fov);
+
+struct State {
+    std::mutex mutex; // preparing and switching: client thread
+    bool prepared{}, failed{};
+    std::array<bool, hooked_count> enabled{};
+    std::array<void*, hooked_count> target{};
+    std::atomic<Fill> fill{};
+    std::atomic<Override> override_original{};
+    std::atomic<SetTransform> set_transform{};
+    std::atomic<SetFov> set_fov{};
+    std::atomic<const Callbacks*> callbacks{};
+};
+// Lives until the process ends: the detours can run at any time.
+State& state() {
+    static auto* value = new State;
+    return *value;
+}
+struct LastError {
+    DWORD value = GetLastError();
+    ~LastError() { SetLastError(value); }
+};
+void fill_detour(std::uintptr_t description, std::uintptr_t id, std::uintptr_t settings, std::uintptr_t camera_view,
+    std::uintptr_t beside, std::uintptr_t view) {
+    auto& s = state();
+    const auto* callbacks = s.callbacks.load(std::memory_order_acquire);
+    // The callback changes copies, which the game then fills the description in from: the game's own
+    // transforms stay as they were.
+    Transform beside_copy, view_copy;
+    bool copied = false;
+    if (callbacks && callbacks->building && description && camera_view && memory::peek(beside, beside_copy) &&
+        memory::peek(view, view_copy)) {
+        LastError error;
+        callbacks->building(description, camera_view, beside_copy, view_copy);
+        copied = true;
+    }
+    s.fill.load(std::memory_order_acquire)(description, id, settings, camera_view,
+        copied ? reinterpret_cast<std::uintptr_t>(&beside_copy) : beside, copied ? reinterpret_cast<std::uintptr_t>(&view_copy) : view);
+    if (callbacks && callbacks->built && description && camera_view) {
+        LastError error;
+        callbacks->built(description, camera_view);
+    }
+}
+void override_detour(std::uintptr_t description, std::uintptr_t context) {
+    auto& s = state();
+    s.override_original.load(std::memory_order_acquire)(description, context);
+    const auto* callbacks = s.callbacks.load(std::memory_order_acquire);
+    if (callbacks && callbacks->overridden && description) {
+        LastError error;
+        callbacks->overridden(description);
+    }
+}
+// Switches one detour, logging a failure. Under the mutex.
+bool set(State& s, std::size_t which, bool on) noexcept {
+    if (s.enabled[which] == on) return true;
+    const auto status = on ? hook_enable(s.target[which]) : hook_disable(s.target[which]);
+    if (status != HookOk) {
+        logging::log(logging::Level::warning, logging::Channel::graphics, "Could not {} the hook on the game's {} ({}).",
+            on ? "enable" : "disable", targets[which].name, hook_status_string(status));
+        return false;
+    }
+    s.enabled[which] = on;
+    return true;
+}
+} // namespace
+
+bool start(std::uintptr_t base, const Callbacks& callbacks) noexcept {
+    auto& s = state();
+    try {
+        std::lock_guard lock(s.mutex);
+        if (s.prepared) return true;
+        if (s.failed || !base) return false;
+        s.failed = true; // until it is prepared
+        for (const auto& target : targets) {
+            std::array<unsigned char, 32> actual{};
+            if (!memory::read_bytes(base + target.rva, actual.data(), actual.size()) || actual != target.bytes) {
+                logging::log(logging::Level::warning, logging::Channel::graphics,
+                    "Replay Shake knows the game's {} on game build 25414733 (this is {}), and it is not at 0x{:x} here: it "
+                    "shakes the camera instead.", target.name, supported_build::steam_build_id, target.rva);
+                return false;
+            }
+        }
+        const std::array<void*, hooked_count> replacement{reinterpret_cast<void*>(&fill_detour), reinterpret_cast<void*>(&override_detour)};
+        std::array<void*, hooked_count> relay{};
+        for (std::size_t i = 0; i < hooked_count; ++i) {
+            auto* target = reinterpret_cast<void*>(base + targets[i].rva);
+            auto status = hook_prepare(target, replacement[i], &relay[i]);
+            if (status == HookOk && !relay[i]) {
+                (void)hook_remove(target);
+                status = HookUnsupportedFunction;
+            }
+            if (status != HookOk) {
+                for (std::size_t j = 0; j < i; ++j) (void)hook_remove(s.target[j]);
+                logging::log(logging::Level::warning, logging::Channel::graphics,
+                    "Hooking the game's {} failed ({}): Replay Shake shakes the camera instead.", targets[i].name,
+                    hook_status_string(status));
+                return false;
+            }
+            s.target[i] = target;
+        }
+        // Published before the detours can ever be enabled (want()).
+        s.fill.store(reinterpret_cast<Fill>(relay[fill_at]), std::memory_order_release);
+        s.override_original.store(reinterpret_cast<Override>(relay[override_at]), std::memory_order_release);
+        s.set_transform.store(reinterpret_cast<SetTransform>(base + targets[set_transform_at].rva), std::memory_order_release);
+        s.set_fov.store(reinterpret_cast<SetFov>(base + targets[set_fov_at].rva), std::memory_order_release);
+        s.callbacks.store(new Callbacks(callbacks), std::memory_order_release);
+        s.prepared = true;
+        s.failed = false;
+        return true;
+    } catch (...) {
+        return false;
+    }
+}
+
+bool available() noexcept { return state().prepared; }
+
+bool want(bool on) noexcept {
+    auto& s = state();
+    try {
+        std::lock_guard lock(s.mutex);
+        if (!s.prepared) return !on;
+        // On: the replay camera's say first (it only shakes again what the fill shook), then the fill;
+        // off: the other way round. Should one not switch, those switched in this call go back as they were.
+        constexpr std::array<std::size_t, hooked_count> on_order{override_at, fill_at};
+        constexpr std::array<std::size_t, hooked_count> off_order{fill_at, override_at};
+        const auto& order = on ? on_order : off_order;
+        const auto was = s.enabled;
+        for (std::size_t i = 0; i < hooked_count; ++i) {
+            if (set(s, order[i], on)) continue;
+            for (std::size_t j = i; j-- > 0;) (void)set(s, order[j], was[order[j]]);
+            return false;
+        }
+        return true;
+    } catch (...) {
+        return false;
+    }
+}
+
+void set_transform(std::uintptr_t view, const Transform& transform) noexcept {
+    if (const auto setter = state().set_transform.load(std::memory_order_acquire); setter && view) setter(view, &transform);
+}
+void set_fov(std::uintptr_t view, float fov) noexcept {
+    if (const auto setter = state().set_fov.load(std::memory_order_acquire); setter && view) setter(view, fov);
+}
+} // namespace dingosdk::replay_shake::game_view
diff --git a/Extension/ReplayShake/game_view_hook.h b/Extension/ReplayShake/game_view_hook.h
new file mode 100644
index 00000000..5a4786f1
--- /dev/null
+++ b/Extension/ReplayShake/game_view_hook.h
@@ -0,0 +1,72 @@
+#pragma once
+#include <array>
+#include <cstdint>
+
+// The game's views, as it builds them each frame from its cameras (`replayshake source 3`, the
+// default where this is known): the earliest place the picture's camera is the picture's, upstream of
+// everything the renderer works out from it. Replay Shake shakes the transform the game builds the main
+// view from, and nothing else: the camera the replay editor moves, its keyframes and gameplay's camera
+// never see the shake, while the picture, its shadows (worked out from the view), its culling, fog and
+// the renderer's record of the frame before (the view as built the frame before) all come from the
+// shaken view, as from a camera that really shook.
+//
+// Each frame (Skate.exe 0x3eb88f0 on game build 25414733) the game goes through its camera views
+// (each with a local player's index at +0xbc: 0 the first), makes each one's transform from an
+// entity its camera view names (0x3ebf3a0), and fills a view description in from it (0x3ef19c0, hooked
+// here): the description's first view (the render view, a 0x5c0-byte view whose camera is at +0x40)
+// gets the transform, and the description keeps a second transform beside it (at +0x1160). Right after
+// each fill, the replay's camera has its say (0x4b9550, hooked here too, which the game calls through a
+// function it registers at start): while its replay camera is on (the replay editor), it sets the
+// view's transform anew, from what that camera works out each frame from the replay's own camera
+// entity ("ReplayedGameCameraTransform") and its own state (0x4c72d0: it trails the camera the editor
+// moves, which is why the editor's picture lags that camera). The renderer then makes
+// every view it draws from those descriptions (0x3f0bab0, then the world's set-up of its render, cull
+// and previous views: 0x50a0880).
+//
+// Known for one game build (Skate.exe 25414733): each function is checked by its bytes before it is
+// hooked, and on any other build the hook is unavailable.
+namespace dingosdk::replay_shake::game_view {
+// A transform as the game hands it to a view (0x90 bytes, 0x3ebf3a0 makes it): the camera's world
+// transform before its offset is added to its position (rows right, up, back, position), the same
+// with the offset added (the one the renderer draws from: a view's camera, at its +0x40), and the
+// offset. A view keeps it at its +0 (the game's setter, 0x3e745a0).
+struct Transform {
+    std::array<float, 16> before_offset{};
+    std::array<float, 16> world{};
+    std::array<float, 4> offset{};
+};
+static_assert(sizeof(Transform) == 0x90, "the game's layout");
+// In a camera view (the game's, not ReSkate's camera views): the index of the local player it is for.
+inline constexpr std::uintptr_t camera_view_player = 0xbc;
+// In a view description: its first view's transform (Transform, at +0: its camera, `world`, at +0x40),
+// vertical field of view (radians), and whether that view has a projection of its own (then its field
+// of view is left alone).
+inline constexpr std::uintptr_t description_transform = 0, description_camera = 0x40, description_fov = 0x104,
+                                description_own_projection = 0x134;
+
+struct Callbacks {
+    // Before the game fills a view description in (the game's thread that builds its views): the
+    // description, the camera view it is for, and the two transforms it fills it in from, copies the
+    // callback may change (the description gets them as changed): the one kept beside the view, and the
+    // view's own. Never throws.
+    void (*building)(std::uintptr_t description, std::uintptr_t camera_view, Transform& beside, Transform& view) noexcept{};
+    // Once the description is filled in.
+    void (*built)(std::uintptr_t description, std::uintptr_t camera_view) noexcept{};
+    // Once the replay's camera has had its say on it, right after (it may have set the view's
+    // transform anew: set_transform() sets it again).
+    void (*overridden)(std::uintptr_t description) noexcept{};
+};
+// Requires the hook service. Checks the functions' bytes and prepares the detours, which patches
+// nothing. True once prepared, on this call and later ones.
+bool start(std::uintptr_t image_base, const Callbacks& callbacks) noexcept;
+bool available() noexcept;
+// Client thread: the detours on or off together (switching them suspends the game's threads; asking
+// for them as they are costs nothing). False when they could not be switched (logged): those switched
+// go back as they were where they can.
+bool want(bool on) noexcept;
+// The game's own setters of a view's transform (Skate.exe 0x3e745a0) and vertical field of view
+// (radians: 0x3e743a0), which mark what they change for the renderer to work out again. Only once
+// started; inside `built` or `overridden`, on the description's first view.
+void set_transform(std::uintptr_t view, const Transform& transform) noexcept;
+void set_fov(std::uintptr_t view, float fov) noexcept;
+} // namespace dingosdk::replay_shake::game_view
diff --git a/Extension/ReplayShake/hook_interpose.h b/Extension/ReplayShake/hook_interpose.h
new file mode 100644
index 00000000..8b574710
--- /dev/null
+++ b/Extension/ReplayShake/hook_interpose.h
@@ -0,0 +1,26 @@
+#pragma once
+#include "Engine/Core/Hooks/hooks.h"
+
+// Force-included by ReplayShake.cmake ahead of the first line of two of ReSkate's files, which stay
+// exactly as ReSkate has them, so that a new ReSkate rarely touches anything Replay Shake changed:
+//
+// - Extension/Skater/xray_render.cpp (the skater x-ray that plugins draw with, Hall of Meat's
+//   bones among them) hooks the renderer's view set-up, which Replay Shake needs too, and the hook
+//   service takes one detour per function. Its hook calls for that function come here, and its hook
+//   then runs inside the one detour both share (render_view_hook.h).
+// - Extension/Rendering/replay_export.cpp hooks the export's encoder. Its hook is wrapped in one
+//   that counts the export's frames (replay_shake_export.h), which time the shake in an export.
+//
+// Declared in those files' namespaces, these hide the hook service's own functions of the same name
+// (Engine/Core/Hooks/hooks.h) from the files' calls. Every other target goes straight on to the hook
+// service, as do the functions not declared here.
+namespace dingosdk::xray {
+HookStatus WINAPI hook_prepare(void* target, void* replacement, void** original = nullptr);
+HookStatus WINAPI hook_enable(void* target);
+HookStatus WINAPI hook_disable(void* target);
+HookStatus WINAPI hook_remove(void* target);
+} // namespace dingosdk::xray
+
+namespace dingosdk::replay_export {
+HookStatus WINAPI hook_prepare(void* target, void* replacement, void** original = nullptr);
+} // namespace dingosdk::replay_export
diff --git a/Extension/ReplayShake/render_view_hook.cpp b/Extension/ReplayShake/render_view_hook.cpp
new file mode 100644
index 00000000..45e5f941
--- /dev/null
+++ b/Extension/ReplayShake/render_view_hook.cpp
@@ -0,0 +1,203 @@
+#include "render_view_hook.h"
+#include "hook_interpose.h"
+#include "Engine/Core/Log/logging.h"
+#include "Engine/Core/Platform/memory.h"
+#include "replay_shake_build.h"
+#include <Windows.h>
+#include <array>
+#include <atomic>
+#include <mutex>
+
+namespace dingosdk::render_view {
+namespace {
+namespace build = addr::skater_render;
+using RenderView = void (*)(std::uintptr_t blackboard, std::uintptr_t current, std::uintptr_t previous, std::uint8_t jitter);
+constexpr auto client_count = static_cast<std::size_t>(Client::count);
+
+struct State {
+    std::mutex mutex; // preparing and switching: client thread
+    bool prepared{}, failed{}, enabled{};
+    std::uintptr_t base{};
+    void* target{};
+    std::atomic<RenderView> original{};
+    // The skater x-ray's own hook (hook_interpose.h): run in place of the original while it wants it.
+    std::atomic<RenderView> inner{};
+    std::array<std::atomic<Callback>, client_count> before{}, after{};
+    std::atomic<unsigned> wanted{}; // a bit per client
+};
+// Lives until the process ends: the detour can run on a render thread at any time.
+State& state() {
+    static auto* value = new State;
+    return *value;
+}
+unsigned bit(Client client) noexcept { return 1U << static_cast<unsigned>(client); }
+
+// A hook must not leave the game a different last error.
+struct LastError {
+    DWORD value = GetLastError();
+    ~LastError() { SetLastError(value); }
+};
+void detour(std::uintptr_t blackboard, std::uintptr_t current, std::uintptr_t previous, std::uint8_t jitter) {
+    auto& s = state();
+    const auto wanted = s.wanted.load(std::memory_order_acquire);
+    if (wanted) {
+        LastError error;
+        for (std::size_t i = 0; i < client_count; ++i)
+            if (wanted & (1U << i))
+                if (const auto callback = s.before[i].load(std::memory_order_acquire)) callback(current, previous, blackboard, jitter);
+    }
+    // The x-ray's hook calls the original itself, then reads the view.
+    const auto inner = (wanted & bit(Client::xray)) ? s.inner.load(std::memory_order_acquire) : nullptr;
+    (inner ? inner : s.original.load(std::memory_order_acquire))(blackboard, current, previous, jitter);
+    if (wanted) {
+        LastError error;
+        for (std::size_t i = 0; i < client_count; ++i)
+            if (wanted & (1U << i))
+                if (const auto callback = s.after[i].load(std::memory_order_acquire)) callback(current, previous, blackboard, jitter);
+    }
+}
+
+// Under the mutex from here on.
+bool prepare(State& s, std::uintptr_t base) noexcept {
+    if (s.prepared) return s.base == base;
+    if (s.failed || !base) return false;
+    const auto& contract = build::render_view_contract;
+    std::array<unsigned char, 32> actual{};
+    if (!memory::peek(base + contract.rva, actual) || actual != contract.bytes) {
+        s.failed = true;
+        logging::log(logging::Level::warning, logging::Channel::graphics,
+            "The renderer's view set-up at 0x{:x} is not this build's: nothing changes or reads the views it draws.", contract.rva);
+        return false;
+    }
+    auto* target = reinterpret_cast<void*>(base + contract.rva);
+    void* relay{};
+    auto status = hook_prepare(target, reinterpret_cast<void*>(&detour), &relay);
+    if (status == HookOk && !relay) {
+        (void)hook_remove(target);
+        status = HookUnsupportedFunction;
+    }
+    if (status != HookOk) {
+        s.failed = true;
+        logging::log(logging::Level::warning, logging::Channel::graphics,
+            "Hooking the renderer's view set-up failed ({}).", hook_status_string(status));
+        return false;
+    }
+    // The relay is published before the detour can ever be enabled (switch_client()).
+    s.original.store(reinterpret_cast<RenderView>(relay), std::memory_order_release);
+    s.base = base;
+    s.target = target;
+    s.prepared = true;
+    return true;
+}
+HookStatus switch_client(State& s, Client client, bool on) noexcept {
+    if (!s.prepared) return on ? HookNotFound : HookOk; // nothing to switch
+    const auto before = s.wanted.load(std::memory_order_acquire);
+    const auto next = on ? before | bit(client) : before & ~bit(client);
+    const bool enable = next != 0;
+    if (enable != s.enabled) {
+        // A client switched on is in the mask before the detour can first run.
+        if (enable) s.wanted.store(next, std::memory_order_release);
+        const auto status = enable ? hook_enable(s.target) : hook_disable(s.target);
+        if (status != HookOk) {
+            s.wanted.store(before, std::memory_order_release);
+            logging::log(logging::Level::warning, logging::Channel::graphics,
+                "Could not {} the renderer's view hook ({}).", enable ? "enable" : "disable", hook_status_string(status));
+            return status;
+        }
+        s.enabled = enable;
+    }
+    s.wanted.store(next, std::memory_order_release);
+    return HookOk;
+}
+// Whether one of the x-ray's hook calls names the view set-up (hook_interpose.h). The first, its
+// hook_prepare, finds it by its bytes and prepares the shared detour, should Replay Shake not have.
+bool is_view_setup(State& s, void* target) noexcept {
+    if (s.prepared) return target == s.target;
+    const auto at = reinterpret_cast<std::uintptr_t>(target);
+    const auto& contract = build::render_view_contract;
+    std::array<unsigned char, 32> actual{};
+    return !s.failed && at > contract.rva && memory::peek(at, actual) && actual == contract.bytes && prepare(s, at - contract.rva);
+}
+} // namespace
+
+bool start(std::uintptr_t base) noexcept {
+    auto& s = state();
+    try {
+        std::lock_guard lock(s.mutex);
+        return prepare(s, base);
+    } catch (...) {
+        return false;
+    }
+}
+
+void set_before(Client client, Callback callback) noexcept {
+    state().before[static_cast<std::size_t>(client)].store(callback, std::memory_order_release);
+}
+void set_after(Client client, Callback callback) noexcept {
+    state().after[static_cast<std::size_t>(client)].store(callback, std::memory_order_release);
+}
+
+bool want(Client client, bool on) noexcept {
+    auto& s = state();
+    try {
+        std::lock_guard lock(s.mutex);
+        return switch_client(s, client, on) == HookOk;
+    } catch (...) {
+        return false;
+    }
+}
+bool wanted(Client client) noexcept { return (state().wanted.load(std::memory_order_acquire) & bit(client)) != 0; }
+} // namespace dingosdk::render_view
+
+// The skater x-ray's hook calls (Extension/Skater/xray_render.cpp, through hook_interpose.h). Its hook
+// for the view set-up is kept and run inside the shared detour, given the original's relay to call;
+// every other target is the hook service's.
+namespace dingosdk::xray {
+namespace {
+namespace view = render_view;
+template<class Action> HookStatus shared(void* target, Action action, HookStatus (WINAPI* otherwise)(void*)) noexcept {
+    auto& s = view::state();
+    try {
+        std::unique_lock lock(s.mutex);
+        if (!view::is_view_setup(s, target)) {
+            lock.unlock();
+            return otherwise(target);
+        }
+        return action(s);
+    } catch (...) {
+        return HookNotInitialized;
+    }
+}
+} // namespace
+
+HookStatus WINAPI hook_prepare(void* target, void* replacement, void** original) {
+    auto& s = view::state();
+    try {
+        std::unique_lock lock(s.mutex);
+        if (!view::is_view_setup(s, target)) {
+            lock.unlock();
+            return dingosdk::hook_prepare(target, replacement, original);
+        }
+        s.inner.store(reinterpret_cast<view::RenderView>(replacement), std::memory_order_release);
+        if (original) *original = reinterpret_cast<void*>(s.original.load(std::memory_order_acquire));
+        return HookOk;
+    } catch (...) {
+        return HookNotInitialized;
+    }
+}
+HookStatus WINAPI hook_enable(void* target) {
+    return shared(target, [](view::State& s) { return view::switch_client(s, view::Client::xray, true); },
+        &dingosdk::hook_enable);
+}
+HookStatus WINAPI hook_disable(void* target) {
+    return shared(target, [](view::State& s) { return view::switch_client(s, view::Client::xray, false); },
+        &dingosdk::hook_disable);
+}
+HookStatus WINAPI hook_remove(void* target) {
+    return shared(target, [](view::State& s) {
+        const auto status = view::switch_client(s, view::Client::xray, false);
+        s.inner.store(nullptr, std::memory_order_release);
+        return status;
+    }, &dingosdk::hook_remove);
+}
+} // namespace dingosdk::xray
diff --git a/Extension/ReplayShake/render_view_hook.h b/Extension/ReplayShake/render_view_hook.h
new file mode 100644
index 00000000..da4a934f
--- /dev/null
+++ b/Extension/ReplayShake/render_view_hook.h
@@ -0,0 +1,31 @@
+#pragma once
+#include <cstdint>
+
+// The renderer's set-up of each view it draws (the game build's skater_render.h:
+// render_view_contract), one detour shared by the features that use it: the hook service takes one
+// detour per function. Before the game copies a view for its shaders a feature may change it
+// (Replay Shake moves its camera). The skater x-ray's own hook (Extension/Skater/xray_render.cpp),
+// which reads the camera after the copy, runs inside this detour in place of the original while the
+// x-ray wants it: its file is left as ReSkate has it, and its hook calls for this function come here
+// (hook_interpose.h).
+namespace dingosdk::render_view {
+enum class Client : unsigned { xray, replay_shake, count };
+// `view` is the 320-byte view being set up: its camera at +0x40, its vertical field of view at
+// +0x104, its kind 0x38 bytes before it (skater_render.h). `previous` is the view the renderer
+// compares it with to tell how the picture moved since the frame before (motion blur, temporal
+// anti-aliasing, the lighting's temporal filters), laid out the same (0: none). `blackboard` is
+// the frame's, which the function is handed first, and `jitter` its last argument (whether the
+// view is jittered for the anti-aliasing, it seems). Render thread. Never throws.
+using Callback = void (*)(std::uintptr_t view, std::uintptr_t previous, std::uintptr_t blackboard, std::uint8_t jitter) noexcept;
+// Requires the validated build and the hook service. Checks the function's bytes and prepares the
+// detour, which patches nothing. True once prepared, on this call and later ones.
+bool start(std::uintptr_t image_base) noexcept;
+// Set before the client first wants the hook. A client's callbacks only run while it wants it: the
+// one before the game copies the view, and the one after (to put back what was changed for it).
+void set_before(Client client, Callback callback) noexcept;
+void set_after(Client client, Callback callback) noexcept;
+// Client thread: the detour is on while any client wants it. False when it could not be switched
+// (logged; it stays as it was).
+bool want(Client client, bool on) noexcept;
+bool wanted(Client client) noexcept;
+} // namespace dingosdk::render_view
diff --git a/Extension/ReplayShake/replay_shake.cpp b/Extension/ReplayShake/replay_shake.cpp
new file mode 100644
index 00000000..5ae33430
--- /dev/null
+++ b/Extension/ReplayShake/replay_shake.cpp
@@ -0,0 +1,2803 @@
+#include "replay_shake.h"
+#include "replay_shake_editor.h"
+#include "replay_shake_model.h"
+#include "replay_shake_settings.h"
+#include "replay_shake_view.h"
+#include "Engine/Core/Json/json.h"
+#include "Engine/Core/Log/logging.h"
+#include "Engine/Core/Platform/memory.h"
+#include "Engine/Core/Platform/path_text.h"
+#include "Engine/Game/Build/supported_build.h"
+#include "Engine/Game/UI/game_view.h"
+#include "Extension/UI/Overlay/overlay.h"
+#include "replay_shake_build.h"
+#include "camera_update_hook.h"
+#include "game_view_hook.h"
+#include "render_view_hook.h"
+#include "replay_shake_export.h"
+#include "replay_shake_frames.h"
+#include "replay_shake_watch.h"
+#include <Windows.h>
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstring>
+#include <filesystem>
+#include <format>
+#include <fstream>
+#include <iterator>
+#include <memory>
+#include <mutex>
+#include <optional>
+
+namespace dingosdk::replay_shake {
+namespace {
+using Clock = std::chrono::steady_clock;
+namespace render = addr::skater_render;
+constexpr std::uint64_t save_after_ms = 1000;    // a dragged slider saves once it rests
+constexpr std::uint64_t save_retry_ms = 10000;   // after a save failed
+constexpr std::uint64_t view_every_ms = 100;     // the menu's snapshot, while nothing else changes
+constexpr std::uint64_t probe_read_every_ms = 500;
+constexpr std::uint64_t lease_ms = 500;          // the renderer shakes only while client ticks keep coming
+constexpr std::uint64_t kept_log_every_ms = 5000; // `replayshake probe`: what the renderer kept of the frames before
+constexpr double most_ahead = 0.1;               // seconds a frame may run ahead of the last playhead reading
+constexpr double most_rate = 8;                  // replay seconds per real second: faster is a scrub
+constexpr std::size_t most_settings_bytes = 4 * 1024 * 1024;
+
+double seconds_between(Clock::time_point from, Clock::time_point to) {
+    return std::chrono::duration<double>(to - from).count();
+}
+std::string lower(std::string_view text) {
+    std::string result(text);
+    for (auto& c : result)
+        if (c >= 'A' && c <= 'Z') c = static_cast<char>(c - 'A' + 'a');
+    return result;
+}
+
+// What the renderer shakes by, published whole by the game thread.
+struct Frame {
+    std::vector<Point> points;
+    Shake fallback;
+    std::uint32_t seed{};
+    bool have_playhead{};
+    double playhead{};       // seconds, when it last changed...
+    Clock::time_point stamp; // ...at this moment...
+    std::uint64_t playhead_session{}, playhead_frames{}; // ...and with this export (replay_shake_export.h) this far on
+    std::uint64_t playhead_camera_frames{};              // ...and the camera updated this often in it (`source 1`)
+    std::uint64_t playhead_build_frames{};               // ...and the game built the main view this often in it (`source 3`)
+    double rate{};           // replay seconds per real second, from its last two changes
+    double interval{};       // seconds between those two: how far a frame may run ahead of the last
+    int export_fps{};
+};
+
+struct State {
+    std::atomic<bool> ready{};
+    std::uintptr_t base{};
+    // The game thread's (client tick and console commands); the menu and renderer get copies.
+    std::mutex mutex;
+    Settings settings;
+    std::filesystem::path file; // where the settings are saved
+    std::string stale_build;    // the game build the replay cameras were found on, when it is not this one
+    bool dirty{}, save_failed{};
+    std::uint64_t save_at{};
+    Editor editor;              // what was last read of the replay editor
+    std::string editor_problem;
+    std::optional<std::vector<double>> previous_keyframes;
+    scan::Reader reader;
+    std::vector<scan::Seen> seen;
+    scan::UiReader menus;
+    scan::GameUi ui;            // the game's menu state, as last read (while looking)
+    std::string probe_menus;    // `replayshake probe`: the menu state as last logged
+    bool gameplay_held{};       // a replay camera is on show, but no game menu: taken for gameplay, kept still
+    ControllerComboLatch toggle_latch; // the controller toggle (Settings::toggle): once per press
+    bool menus_read{};          // the menu state has been read: should it go missing, no menu is up
+    bool level{}, test{}, probe{}, hooked{};
+    std::uint64_t hook_retry_at{}; // after the renderer's hook could not be switched
+    std::string probe_cameras, probe_read;
+    std::uint64_t probe_read_at{};
+    std::optional<double> playhead;
+    Clock::time_point playhead_at;
+    std::uint64_t playhead_session{}, playhead_frames{};
+    double rate{}, interval{};
+    std::uint64_t revision{}, view_at{};
+    // The renderer's.
+    std::mutex frame_mutex;
+    std::shared_ptr<const Frame> frame;
+    // Until when (GetTickCount64) the main view shakes: each client tick renews it, so a game that
+    // stops ticking (a load) stops shaking.
+    std::atomic<std::uint64_t> live_until{};
+    // `replayshake history`: put the cameras the renderer kept of the frames before back as they were
+    // shown (carry()). On unless switched off, to compare.
+    std::atomic<bool> carry{true};
+    // `replayshake copies`: give the shake to exact copies of the main camera in views of other kinds
+    // (other_view()). On unless switched off, to compare.
+    std::atomic<bool> copies{true};
+    // `replayshake passes`: which of each frame's set-ups of the main view shake (a bit each, from the
+    // first; the eighth stands for the rest). One that does not keeps the game's camera while the game
+    // copies it (shake_view(), restore_view()), to find which pass the shadows are worked out in.
